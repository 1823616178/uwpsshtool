<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM">
      <Configuration>Debug</Configuration>
      <Platform>ARM</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM">
      <Configuration>Release</Configuration>
      <Platform>ARM</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Globals">
    <ProjectGuid>{DBAC9252-457E-4A8F-A6F5-2EED170A6255}</ProjectGuid>
    <RootNamespace>SshTool.Native</RootNamespace>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <MinimumVisualStudioVersion>14.0</MinimumVisualStudioVersion>
    <AppContainerApplication>true</AppContainerApplication>
    <WindowsAppContainer>true</WindowsAppContainer>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.15063.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>
  <!-- v141：VS2026 的 v142/v145 已移除 ARM32 目标，ARM32 只能由并存 VS2017 的 v141 提供（见 doc/ENV.md）。
       注意：Configuration 属性组必须位于 Microsoft.Cpp.props 导入之前，否则 PlatformToolset 解析失败。 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v141</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v141</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v141</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <PlatformToolset>v141</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <PlatformToolset>v141</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <PlatformToolset>v141</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- 显式固定输出目录（必须晚于 Microsoft.Cpp.props 导入，否则被 UWP 默认 Platform.Default.props 覆盖）：
       Native 由 VS2017 MSBuild 单独构建（VS2026 无 v141/UWP 支持），App 在 VS2026 解决方案构建中仅解析其
       产物路径；目录取项目相对路径，保证两种构建上下文算出同一路径。 -->
  <PropertyGroup>
    <OutDir>$(ProjectDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <!-- OpenSSL 预编译产物（scripts/build-openssl.ps1 生成，不入库）按平台映射 triplet 目录 -->
  <PropertyGroup>
    <PrebuiltTriplet Condition="'$(Platform)'=='ARM'">arm-uwp</PrebuiltTriplet>
    <PrebuiltTriplet Condition="'$(Platform)'=='Win32'">x86-uwp</PrebuiltTriplet>
    <PrebuiltTriplet Condition="'$(Platform)'=='x64'">x64-uwp</PrebuiltTriplet>
  </PropertyGroup>
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <Libssh2Dir>$(ProjectDir)..\..\native\third_party\libssh2\</Libssh2Dir>
    <LibvtermDir>$(ProjectDir)..\..\native\third_party\libvterm\</LibvtermDir>
    <Argon2Dir>$(ProjectDir)..\..\native\third_party\argon2\</Argon2Dir>
  </PropertyGroup>
  <!-- 第三方源码不入库：缺了就给出可操作报错，而不是一堆「找不到 libssh2.h」 -->
  <Target Name="RequireThirdParty" BeforeTargets="ClCompile">
    <Error Condition="!Exists('$(Libssh2Dir)include\libssh2.h')"
           Text="缺少 libssh2 源码（$(Libssh2Dir)）。先运行： pwsh scripts/fetch-third-party.ps1" />
    <Error Condition="!Exists('$(LibvtermDir)src\encoding\DECdrawing.inc')"
           Text="缺少 libvterm 源码或 release 生成的编码表（$(LibvtermDir)）。先运行： pwsh scripts/fetch-third-party.ps1" />
    <Error Condition="!Exists('$(Argon2Dir)include\argon2.h')"
           Text="缺少 Argon2 源码（$(Argon2Dir)）。先运行： pwsh scripts/fetch-third-party.ps1" />
  </Target>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <AdditionalUsingDirectories>$(WindowsSDK_WindowsMetadata);%(AdditionalUsingDirectories)</AdditionalUsingDirectories>
      <CompileAsWinRT>true</CompileAsWinRT>
      <PreprocessorDefinitions>_DEBUG;_WINRT_DLL;LIBSSH2_LIBRARY;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\..\native\core;$(Libssh2Dir)include;$(LibvtermDir)include;$(Argon2Dir)include;$(ProjectDir)..\..\native\prebuilt\$(PrebuiltTriplet)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DisableSpecificWarnings>4453;28204</DisableSpecificWarnings>
      <!-- 源码一律 UTF-8 无 BOM；不加 /utf-8 时 MSVC 按 GBK 读，中文注释的尾字节可能吞掉下一行，
           报出「找不到标识符」这类完全对不上的错（doc/ENV.md §5 已记该坑，这里是第二次踩）。 -->
      <AdditionalOptions>/utf-8 /std:c++17 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <IgnoreAllDefaultLibraries>false</IgnoreAllDefaultLibraries>
      <GenerateWindowsMetadata>true</GenerateWindowsMetadata>
      <AdditionalDependencies>WindowsApp.lib;ws2_32.lib;crypt32.lib;libcrypto.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\native\prebuilt\$(PrebuiltTriplet)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <AdditionalUsingDirectories>$(WindowsSDK_WindowsMetadata);%(AdditionalUsingDirectories)</AdditionalUsingDirectories>
      <CompileAsWinRT>true</CompileAsWinRT>
      <PreprocessorDefinitions>NDEBUG;_WINRT_DLL;LIBSSH2_LIBRARY;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\..\native\core;$(Libssh2Dir)include;$(LibvtermDir)include;$(Argon2Dir)include;$(ProjectDir)..\..\native\prebuilt\$(PrebuiltTriplet)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DisableSpecificWarnings>4453;28204</DisableSpecificWarnings>
      <!-- 源码一律 UTF-8 无 BOM；不加 /utf-8 时 MSVC 按 GBK 读，中文注释的尾字节可能吞掉下一行，
           报出「找不到标识符」这类完全对不上的错（doc/ENV.md §5 已记该坑，这里是第二次踩）。 -->
      <AdditionalOptions>/utf-8 /std:c++17 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <IgnoreAllDefaultLibraries>false</IgnoreAllDefaultLibraries>
      <GenerateWindowsMetadata>true</GenerateWindowsMetadata>
      <AdditionalDependencies>WindowsApp.lib;ws2_32.lib;crypt32.lib;libcrypto.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\native\prebuilt\$(PrebuiltTriplet)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="NativeInfo.h" />
    <ClInclude Include="Spike\SshSpike.h" />
    <ClInclude Include="Bridge\BridgeUtil.h" />
    <ClInclude Include="Bridge\ConnectOptions.h" />
    <ClInclude Include="Bridge\HostKeyInfo.h" />
    <ClInclude Include="Bridge\HostKeyCheckEventArgs.h" />
    <ClInclude Include="Bridge\AuthPromptEventArgs.h" />
    <ClInclude Include="Bridge\StateChangedEventArgs.h" />
    <ClInclude Include="Bridge\SshSession.h" />
    <ClInclude Include="Bridge\TerminalScreen.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="NativeInfo.cpp" />
    <ClCompile Include="Spike\SshSpike.cpp" />
    <ClCompile Include="Bridge\ConnectOptions.cpp" />
    <ClCompile Include="Bridge\HostKeyInfo.cpp" />
    <ClCompile Include="Bridge\HostKeyCheckEventArgs.cpp" />
    <ClCompile Include="Bridge\AuthPromptEventArgs.cpp" />
    <ClCompile Include="Bridge\StateChangedEventArgs.cpp" />
    <ClCompile Include="Bridge\SshSession.cpp" />
    <ClCompile Include="Bridge\TerminalScreen.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <Import Project="..\..\native\core\NativeCore.vcxitems" Label="Shared" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
