<UserControl
    x:Class="SshTool.App.Terminal.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:SshTool.App.Terminal"
    xmlns:controls="using:SshTool.App.Controls"
    IsTabStop="False"
    AllowFocusOnInteraction="False"
    UseSystemFocusVisuals="False">

    <!-- T05：终端画布。尺寸由度量后在代码里设，避免 XAML 魔法数字。
         必须锚定左上角：SIP 出现后画布会按未遮挡行数缩短；若保持默认居中，
         画布（尤其光标/输入回显所在的底行）会被下移到软键盘后面。 -->
    <Grid>
        <canvas:CanvasControl x:Name="Canvas"
                              x:Uid="Terminal_Canvas"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              IsTabStop="False"
                              AllowFocusOnInteraction="False"
                              Draw="OnDraw"
                              CreateResources="OnCreateResources" />
        <!-- W04：响铃「闪屏」层，平时透明、不参与命中测试。 -->
        <Border x:Name="BellFlash" Background="{ThemeResource AppTextBrush}"
                Opacity="0" IsHitTestVisible="False" />
        <local:SelectionLayer x:Name="Selection"
                              Visibility="Collapsed" />
        <controls:TransientToast x:Name="CopiedToast" />
        <Border x:Name="FontSizeBubble"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSm}"
                Padding="{StaticResource PadMd}"
                IsHitTestVisible="False">
            <TextBlock x:Name="FontSizeBubbleText" Style="{StaticResource SectionTitleTextStyle}" />
        </Border>
        <!-- T09：隐藏哨兵，承接 SIP / IME。IsHitTestVisible=False 让点击落到画布。 -->
        <!-- Q05：AccessibilityView=Raw 避免读屏将输入哨兵念为普通未命名输入框。 -->
        <!-- G01（硬约束 4）：显式 Style="{x:Null}" 排除全局 TextBox 样式，保证尺寸与模板不受影响。 -->
        <TextBox x:Name="Sentinel"
                 Style="{x:Null}"
                 AutomationProperties.AccessibilityView="Raw"
                 Width="{StaticResource SentinelInputSize}"
                 Height="{StaticResource SentinelInputSize}"
                 MinWidth="{StaticResource SentinelInputSize}"
                 MinHeight="{StaticResource SentinelInputSize}"
                 Opacity="{StaticResource SentinelInputOpacity}"
                 Padding="{StaticResource PadNone}"
                 BorderThickness="{StaticResource BorderNone}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 IsHitTestVisible="False"
                 IsSpellCheckEnabled="False"
                 IsTextPredictionEnabled="False"
                 AcceptsReturn="False"
                 TextWrapping="NoWrap"
                 IsTabStop="True" />
    </Grid>

</UserControl>
