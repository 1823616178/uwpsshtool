<!-- Design Token 主字典：尺寸（02-UI-DESIGN.md §2.2）+ 图标（§2.3）+ 主题色入口（§2.1） -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary Source="/Themes/Tokens.Dark.xaml" x:Key="Dark" />
        <ResourceDictionary Source="/Themes/Tokens.Light.xaml" x:Key="Light" />
    </ResourceDictionary.ThemeDictionaries>

    <!-- §2.2 尺寸 -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <!-- Gap 系列：W10M 15063（contract 4.0）既无 Grid.ColumnSpacing/RowSpacing 也无 StackPanel.Spacing
         （均需 1709），间距一律由子元素 Margin 让出；数值取自上面的 Space* 刻度。 -->
    <Thickness x:Key="GapSmLeft">8,0,0,0</Thickness>
    <Thickness x:Key="GapSmRight">0,0,8,0</Thickness>
    <Thickness x:Key="GapSmBottom">0,0,0,8</Thickness>
    <Thickness x:Key="GapLgBottom">0,0,0,16</Thickness>
    <Thickness x:Key="GapMdTop">0,12,0,0</Thickness>
    <Thickness x:Key="GapXlTop">0,24,0,0</Thickness>
    <!-- 发丝描边（Banner 底线、Toast 边框）；不写字面量 1。 -->
    <Thickness x:Key="BorderThin">1</Thickness>
    <!-- G01：输入类控件边框粗细（1 epx，07-UI-POLISH-TASKS §4.3） -->
    <Thickness x:Key="InputBorderThickness">1</Thickness>
    <!-- Shape.StrokeThickness 用 Double 档（Thickness 不能赋给 StrokeThickness）。 -->
    <x:Double x:Key="StrokeThin">1</x:Double>
    <Thickness x:Key="BorderThinBottom">0,0,0,1</Thickness>
    <!-- BottomActionBar 顶部分隔线（与 BorderThinBottom 对偶）。 -->
    <Thickness x:Key="BorderThinTop">0,1,0,0</Thickness>
    <Thickness x:Key="BorderNone">0</Thickness>
    <Thickness x:Key="PadNone">0</Thickness>
    <!-- G01：输入类控件内边距与高度 -->
    <x:Double x:Key="InputHeight">40</x:Double>
    <Thickness x:Key="PadInput">10,6,10,6</Thickness>
    <!-- G01：ComboBox 选中项左侧指示条（2 epx） -->
    <Thickness x:Key="ComboBoxItemSelectedBorder">2,0,0,0</Thickness>
    <!-- G02：选中指示条粗细（Pivot 选中底条等，2 epx）与开关开态描边 -->
    <x:Double x:Key="IndicatorHeight">2</x:Double>
    <!-- G08：进度条粗细（传输进度条细化，2 epx） -->
    <x:Double x:Key="ProgressThickness">2</x:Double>
    <x:Double x:Key="ToggleSwitchOnStrokeThickness">0</x:Double>
    <x:Double x:Key="PivotHeaderItemFontSize">18</x:Double>
    <Thickness x:Key="PivotHeaderItemMargin">12,0,12,0</Thickness>
    <!-- T09：隐藏 IME 哨兵 TextBox。1×1 保持可聚焦；Opacity 0 会被渲染裁掉。 -->
    <x:Double x:Key="SentinelInputSize">1</x:Double>
    <x:Double x:Key="SentinelInputOpacity">0.01</x:Double>
    <!-- 均匀内边距：Padding/Margin 要 Thickness，不能绑 Space*（x:Double），否则
         XamlParseException（Double 赋给 Thickness）。SpaceMd 仍给 Width/Height 用。 -->
    <Thickness x:Key="PadMd">12</Thickness>
    <Thickness x:Key="PagePadding">12,0,12,0</Thickness>
    <Thickness x:Key="PagePaddingWide">24,0,24,0</Thickness>
    <!-- V01a（05 §5.2）：卡片内边距手机档（12）；宽松档 16 暂无本批消费方，需要时再加。 -->
    <Thickness x:Key="PadCard">12</Thickness>
    <!-- SegmentTabs 容器内边距：选中段圆角块与外框之间让出的间隙。 -->
    <Thickness x:Key="PadXs">4</Thickness>
    <!-- StatusPill 内边距（横 8 纵 4）：配合 SpaceXl 的 MinHeight 收成约 24 高胶囊。 -->
    <Thickness x:Key="PadPill">8,4</Thickness>
    <!-- G03: 底部栏统一高度（48 epx，与系统 CommandBar Compact 对齐）与内边距 -->
    <x:Double x:Key="BottomBarHeight">48</x:Double>
    <Thickness x:Key="PadActionBar">12,4,12,4</Thickness>
    <!-- G04: 宽屏表单最大宽度（560 epx） -->
    <x:Double x:Key="FormMaxWidth">560</x:Double>
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <!-- StatusPill 外圈全圆角（≈ 胶囊高度一半），只用于短状态标签。 -->
    <CornerRadius x:Key="RadiusPill">12</CornerRadius>
    <!-- G06：正圆圆角（999 保持正圆） -->
    <CornerRadius x:Key="RadiusCircle">999</CornerRadius>
    <x:Double x:Key="ListRowHeight">64</x:Double>
    <x:Double x:Key="ListRowCompactHeight">48</x:Double>
    <x:Double x:Key="GroupHeaderHeight">36</x:Double>
    <x:Double x:Key="StatusDotSize">10</x:Double>
    <!-- G06：主机列表首字母头像尺寸（36 epx） -->
    <x:Double x:Key="AvatarSize">36</x:Double>
    <x:Double x:Key="TouchTargetMin">40</x:Double>
    <!-- SegmentTabs 段高：实际赋给段内填充 Border 的 MinHeight（容器另有 PadXs 内边距与细边，整高更大）；
         触控安全档，与 KeyBarHeight 同刻度。 -->
    <x:Double x:Key="SegmentHeight">40</x:Double>
    <!-- 禁用态不透明度（SegmentTabs、IconButtonStyle 的 Disabled 视觉）。 -->
    <x:Double x:Key="DisabledOpacity">0.5</x:Double>
    <x:Double x:Key="KeyBarHeight">40</x:Double>
    <x:Double x:Key="KeyBarKeyMinWidth">44</x:Double>
    <Thickness x:Key="KeyBarLockedBorder">0,0,0,2</Thickness>
    <!-- V03b（05 §6.2 第 4 点）：Locked 态键底 accent 条高度（2 epx）。 -->
    <x:Double x:Key="KeyBarAccentBarHeight">2</x:Double>
    <x:Double x:Key="SelectionOverlayOpacity">0.35</x:Double>
    <!-- W04（01-DESIGN §16.4）：终端响铃「闪屏」模式的起始不透明度。 -->
    <x:Double x:Key="BellFlashOpacity">0.3</x:Double>
    <x:Double x:Key="TerminalInfoBarHeight">32</x:Double>
    <!-- V03a（05 §6.2）：紧凑信息条——默认单行 44 epx，展开双行 64 epx。 -->
    <x:Double x:Key="TerminalCompactBarHeight">44</x:Double>
    <x:Double x:Key="TerminalExpandedBarHeight">64</x:Double>
    <!-- 竖屏单行信息条：地址限宽，主机名留在左侧；展开后第二行不再限这档。 -->
    <x:Double x:Key="TerminalAddressMaxWidth">160</x:Double>
    <x:Double x:Key="TerminalAddressExpandedMaxWidth">640</x:Double>
    <x:Double x:Key="TabStripHeight">36</x:Double>
    <x:Double x:Key="SplitterThickness">6</x:Double>
    <x:Double x:Key="SessionsPaneWidth">280</x:Double>
    <x:Double x:Key="MasterPaneWidth">320</x:Double>
    <x:Double x:Key="DialogMaxWidth">340</x:Double>
    <!-- F03 SftpPage：传输面板展开后的滚动区上限（≈ 3.5 × ListRowCompactHeight）。 -->
    <x:Double x:Key="SftpTransferPanelMaxHeight">168</x:Double>
    <x:Double x:Key="FontCaption">12</x:Double>
    <x:Double x:Key="FontBody">15</x:Double>
    <x:Double x:Key="FontSubtitle">18</x:Double>
    <x:Double x:Key="FontTitle">20</x:Double>
    <x:Double x:Key="FontHeader">28</x:Double>
    <x:Double x:Key="WideBreakpoint">720</x:Double>
    <!-- opt/full-pass 竖屏重设计（doc/PORTRAIT-UI.md）：窗高 ≥560 视为「竖屏/高窗」，
         启用键条第二行等竖屏增强；手机横屏（窗高 ≈360）自动回到单行紧凑布局。 -->
    <x:Double x:Key="TallBreakpoint">560</x:Double>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <!-- 卡片外边距：左右与 PagePadding 对齐，上下各 4 让出卡片间 8 的呼吸缝 -->
    <Thickness x:Key="CardMargin">12,4,12,4</Thickness>
    <Thickness x:Key="CardListPadding">0,4,0,12</Thickness>
    <!-- 会话卡片左侧状态色条宽度 -->
    <x:Double x:Key="CardAccentStripWidth">3</x:Double>
    <CornerRadius x:Key="CardAccentStripRadius">2</CornerRadius>
    <Thickness x:Key="CardAccentStripMargin">0,10,0,10</Thickness>
    <Thickness x:Key="GapMdLeft">12,0,0,0</Thickness>
    <!-- 搜索/快速连接胶囊容器 -->
    <Thickness x:Key="PadPillField">4,2,4,2</Thickness>
    <!-- 键条：底板内边距、双行间缝、第二行键高（比主行矮一档，竖屏多一行仍省高度） -->
    <Thickness x:Key="KeyBarPad">4,4,4,4</Thickness>
    <Thickness x:Key="KeyBarRowGap">0,0,0,4</Thickness>
    <x:Double x:Key="KeyBarExtraRowHeight">34</x:Double>
    <x:Double x:Key="KeyBarExtraKeyMinWidth">36</x:Double>
    <!-- 竖屏终端信息条（玻璃悬浮条）高度：比旧紧凑条再收 4 epx，留给终端行 -->
    <x:Double x:Key="TerminalGlassBarHeight">40</x:Double>
    <!-- UseSystemAccent 时 AppAccentSoftBrush 的不透明度（ThemeService 读取） -->
    <x:Double x:Key="AccentSoftOpacity">0.16</x:Double>
    <!-- 05 §6.5：≥1024 宽屏档（AppPageHeader wide 态加大页边距用）。 -->
    <x:Double x:Key="ExtraWideBreakpoint">1024</x:Double>

    <!-- 05 §7.1 动效标准（成文，不落 token）：
         只用 120–200 ms 的透明度/位移 Storyboard；尊重系统动画设置
         （UISettings.AnimationsEnabled 为关时不播）。连续呼吸/旋转
         （StatusDot 脉动、同步旋转）属状态指示，不受 120–200 ms 时长限制。 -->

    <!-- U05：等宽字形（指纹/公钥/randomart，§2.4）；对话框内 4/8 小间距 -->
    <FontFamily x:Key="AppMonoFontFamily">Consolas</FontFamily>
    <Thickness x:Key="GapXsTop">0,4,0,0</Thickness>
    <Thickness x:Key="GapXsBottom">0,0,0,4</Thickness>
    <Thickness x:Key="GapXsLeft">4,0,0,0</Thickness>
    <Thickness x:Key="GapSmTop">0,8,0,0</Thickness>

    <!-- §2.3 图标（Segoe MDL2 Assets 字形） -->
    <!-- MDL2 字体族：仅 TextBlock 直出字形处用（如 ColorSwatchPicker 角标）；
         FontIcon 默认即此字体，无需设置。 -->
    <FontFamily x:Key="AppIconFontFamily">Segoe MDL2 Assets</FontFamily>
    <x:String x:Key="IconAdd">&#xE710;</x:String>
    <x:String x:Key="IconSearch">&#xE721;</x:String>
    <x:String x:Key="IconSync">&#xE895;</x:String>
    <x:String x:Key="IconSyncError">&#xEA6A;</x:String>
    <x:String x:Key="IconCloud">&#xE753;</x:String>
    <x:String x:Key="IconCloudOff">&#xE8CD;</x:String>
    <x:String x:Key="IconSettings">&#xE713;</x:String>
    <x:String x:Key="IconMore">&#xE712;</x:String>
    <!-- SFTP 重设计：排序/视图选项（MDL2 Sort）。 -->
    <x:String x:Key="IconSort">&#xE8CB;</x:String>
    <x:String x:Key="IconConnect">&#xE703;</x:String>
    <x:String x:Key="IconDisconnect">&#xE8CD;</x:String>
    <x:String x:Key="IconTerminal">&#xE756;</x:String>
    <x:String x:Key="IconKey">&#xE192;</x:String>
    <x:String x:Key="IconLock">&#xE72E;</x:String>
    <x:String x:Key="IconUnlock">&#xE785;</x:String>
    <x:String x:Key="IconEdit">&#xE70F;</x:String>
    <x:String x:Key="IconDelete">&#xE74D;</x:String>
    <x:String x:Key="IconClose">&#xE894;</x:String>
    <!-- GlobalNavigationButton（E700 汉堡）：MainPage 宽屏主机窗格开关。 -->
    <x:String x:Key="IconGlobalNav">&#xE700;</x:String>
    <!-- Back（E72B 向左箭头）：AppPageHeader 返回按钮。 -->
    <x:String x:Key="IconBack">&#xE72B;</x:String>
    <!-- Forward（E72A 向右箭头）：HostRow 跳板徽章——↪ 的字形直译，
         语义取「连接经跳板机转发到目标主机」，与 Tunnel/Key 徽章形不撞。 -->
    <x:String x:Key="IconForward">&#xE72A;</x:String>
    <!-- G06：收藏与历史图标（MDL2 E735 FavoriteStarFill / E81C History） -->
    <x:String x:Key="IconFavoriteStar">&#xE735;</x:String>
    <x:String x:Key="IconFavoriteStarFill">&#xE735;</x:String>
    <x:String x:Key="IconHistory">&#xE81C;</x:String>
    <!-- CheckMark（E73E 对勾）：ColorSwatchPicker 选中角标等勾选态。 -->
    <x:String x:Key="IconCheck">&#xE73E;</x:String>
    <!-- ChevronRight（E76C，与既有 E70D/E70E 同族同粗细）：分组/面板折叠展开。
         注：E70C 经字形渲染核对实为 RememberedDevice（显示器+星），不是右尖括号。 -->
    <x:String x:Key="IconChevronRight">&#xE76C;</x:String>
    <x:String x:Key="IconChevronUp">&#xE70E;</x:String>
    <x:String x:Key="IconChevronDown">&#xE70D;</x:String>
    <x:String x:Key="IconCopy">&#xE8C8;</x:String>
    <x:String x:Key="IconPaste">&#xE77F;</x:String>
    <x:String x:Key="IconFolder">&#xE8B7;</x:String>
    <x:String x:Key="IconDocument">&#xE8A5;</x:String>
    <x:String x:Key="IconUpload">&#xE898;</x:String>
    <x:String x:Key="IconDownload">&#xE896;</x:String>
    <x:String x:Key="IconTunnel">&#xE71B;</x:String>
    <x:String x:Key="IconSnippet">&#xE943;</x:String>
    <!-- 分屏（E8A9 2×2 窗格阵列）：窗格拆分操作。MDL2 无带方向的分屏字形，
         经渲染核对 E7FA/E7FB 实为圆角/矩形占位（02 §2.3 自注「SP 阶段核对字形」），
         故不沿用 IconSplitH/IconSplitV；两个占位键暂留画廊，待后续清理。 -->
    <x:String x:Key="IconSplit">&#xE8A9;</x:String>
    <x:String x:Key="IconSplitH">&#xE7FA;</x:String>
    <x:String x:Key="IconSplitV">&#xE7FB;</x:String>
    <x:String x:Key="IconKeyboard">&#xE765;</x:String>
    <!-- Color（E790 调色板）：外观列表空态字形（AppearanceListPage，G09 引入引用时漏定义）。 -->
    <x:String x:Key="IconPalette">&#xE790;</x:String>
    <x:String x:Key="IconWarning">&#xE7BA;</x:String>
    <x:String x:Key="IconError">&#xE783;</x:String>
    <x:String x:Key="IconInfo">&#xE946;</x:String>
    <!-- G08：SFTP 文件类型图标（Segoe MDL2 Assets） -->
    <x:String x:Key="IconFileCode">&#xE943;</x:String>
    <x:String x:Key="IconFileArchive">&#xE8F2;</x:String>
    <x:String x:Key="IconFileImage">&#xE8B9;</x:String>
    <x:String x:Key="IconFileConfig">&#xE713;</x:String>
    <x:String x:Key="IconFileLog">&#xE81C;</x:String>
    <x:String x:Key="IconFileBinary">&#xE756;</x:String>
    <x:String x:Key="IconFileSymlink">&#xE71B;</x:String>
</ResourceDictionary>
