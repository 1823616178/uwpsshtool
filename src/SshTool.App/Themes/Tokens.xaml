<!-- Design Token 主字典：尺寸（02-UI-DESIGN.md §2.2）+ 图标（§2.3）+ 主题色入口（§2.1） -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary Source="/Themes/Tokens.Dark.xaml" x:Key="Dark" />
        <ResourceDictionary Source="/Themes/Tokens.Light.xaml" x:Key="Light" />
    </ResourceDictionary.ThemeDictionaries>

    <!-- §2.2 尺寸 -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <!-- Gap 系列：W10M 15063（contract 4.0）既无 Grid.ColumnSpacing/RowSpacing 也无 StackPanel.Spacing
         （均需 1709），间距一律由子元素 Margin 让出；数值取自上面的 Space* 刻度。 -->
    <Thickness x:Key="GapSmLeft">8,0,0,0</Thickness>
    <Thickness x:Key="GapSmBottom">0,0,0,8</Thickness>
    <Thickness x:Key="GapLgBottom">0,0,0,16</Thickness>
    <Thickness x:Key="GapMdTop">0,12,0,0</Thickness>
    <Thickness x:Key="GapXlTop">0,24,0,0</Thickness>
    <!-- 发丝描边（Banner 底线、Toast 边框）；不写字面量 1。 -->
    <Thickness x:Key="BorderThin">1</Thickness>
    <Thickness x:Key="BorderThinBottom">0,0,0,1</Thickness>
    <Thickness x:Key="BorderNone">0</Thickness>
    <Thickness x:Key="PadNone">0</Thickness>
    <!-- T09：隐藏 IME 哨兵 TextBox。1×1 保持可聚焦；Opacity 0 会被渲染裁掉。 -->
    <x:Double x:Key="SentinelInputSize">1</x:Double>
    <x:Double x:Key="SentinelInputOpacity">0.01</x:Double>
    <!-- 均匀内边距：Padding/Margin 要 Thickness，不能绑 Space*（x:Double），否则
         XamlParseException（Double 赋给 Thickness）。SpaceMd 仍给 Width/Height 用。 -->
    <Thickness x:Key="PadMd">12</Thickness>
    <Thickness x:Key="PagePadding">12,0,12,0</Thickness>
    <Thickness x:Key="PagePaddingWide">24,0,24,0</Thickness>
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <x:Double x:Key="ListRowHeight">64</x:Double>
    <x:Double x:Key="ListRowCompactHeight">48</x:Double>
    <x:Double x:Key="GroupHeaderHeight">36</x:Double>
    <x:Double x:Key="StatusDotSize">10</x:Double>
    <x:Double x:Key="TouchTargetMin">40</x:Double>
    <x:Double x:Key="KeyBarHeight">40</x:Double>
    <x:Double x:Key="KeyBarKeyMinWidth">44</x:Double>
    <x:Double x:Key="TerminalInfoBarHeight">32</x:Double>
    <x:Double x:Key="TabStripHeight">36</x:Double>
    <x:Double x:Key="SplitterThickness">6</x:Double>
    <x:Double x:Key="SessionsPaneWidth">280</x:Double>
    <x:Double x:Key="MasterPaneWidth">320</x:Double>
    <x:Double x:Key="DialogMaxWidth">340</x:Double>
    <x:Double x:Key="FontCaption">12</x:Double>
    <x:Double x:Key="FontBody">15</x:Double>
    <x:Double x:Key="FontSubtitle">18</x:Double>
    <x:Double x:Key="FontTitle">20</x:Double>
    <x:Double x:Key="FontHeader">28</x:Double>
    <x:Double x:Key="WideBreakpoint">720</x:Double>

    <!-- U05：等宽字形（指纹/公钥/randomart，§2.4）；对话框内 4/8 小间距 -->
    <FontFamily x:Key="AppMonoFontFamily">Consolas</FontFamily>
    <Thickness x:Key="GapXsTop">0,4,0,0</Thickness>
    <Thickness x:Key="GapSmTop">0,8,0,0</Thickness>

    <!-- §2.3 图标（Segoe MDL2 Assets 字形） -->
    <x:String x:Key="IconAdd">&#xE710;</x:String>
    <x:String x:Key="IconSearch">&#xE721;</x:String>
    <x:String x:Key="IconSync">&#xE895;</x:String>
    <x:String x:Key="IconSyncError">&#xEA6A;</x:String>
    <x:String x:Key="IconCloudOff">&#xE8CD;</x:String>
    <x:String x:Key="IconSettings">&#xE713;</x:String>
    <x:String x:Key="IconMore">&#xE712;</x:String>
