<!-- 02-UI-DESIGN.md §2.1 深色主题（ThemeDictionaries 同名键）。
     05 §5.1 五层角色归档（键名不变，全工程已在用）：
       Canvas    = AppBgBrush：页面/终端背景，纯黑省 AMOLED 功耗
       Surface 1 = AppSurfaceBrush：列表行、普通卡片
       Surface 2 = AppSurfaceAltBrush / AppPressedBrush：输入、选中、浮层、按压等可交互/提升层级区域
       Stroke    = AppBorderBrush：分隔线、输入边框；聚焦/选中描边改刷 AppAccentBrush（不另立键）
       Semantic  = AppSuccess/Warning/Danger/InfoBrush：只表状态（点、图标、细边、短标签），不作大面积装饰
     其余为辅助角色：Text 三级、Accent/OnAccent、KeyBar 专用、OverlayScrim 遮罩。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBgBrush" Color="#000000" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#12161F" />
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#1A2030" />
    <SolidColorBrush x:Key="AppPressedBrush" Color="#243048" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#2A3448" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#E8EEFB" />
    <SolidColorBrush x:Key="AppTextDimBrush" Color="#9AA7C0" />
    <SolidColorBrush x:Key="AppTextFaintBrush" Color="#7D8AA3" />
    <!-- 系统强调色回退值；UseSystemAccent 时由 ThemeService 就地改色（深浅两份字典同改）。
         ui/fix-pass：强调色只作「填充」（主按钮、开关、选中描边），白字对比 4.7:1；
         作文字/小图标时用 AppAccentTextBrush（在 Surface 上 ≥ 4.5:1）。 -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="#2F6FE0" />
    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#6EA2FF" />
    <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#34C77B" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="#F5A524" />
    <!-- Danger 作文字/图标（错误提示）；危险按钮等「白字压红底」用 AppDangerFillBrush（白字 4.5:1）。 -->
    <SolidColorBrush x:Key="AppDangerBrush" Color="#F4605F" />
    <SolidColorBrush x:Key="AppDangerFillBrush" Color="#D93A3C" />
    <!-- 危险提示块底（15% 红叠层）；正文仍用 AppTextBrush。替代旧的「整块 Opacity=0.15」（会连文字一起变淡）。 -->
    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#26F4605F" />
    <SolidColorBrush x:Key="AppInfoBrush" Color="#3EC6D9" />
    <SolidColorBrush x:Key="KeyBarBgBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="KeyBarKeyBrush" Color="#1E2636" />
    <SolidColorBrush x:Key="KeyBarKeyActiveBrush" Color="#2F6FE0" />
    <SolidColorBrush x:Key="KeyBarKeyLockedBrush" Color="#F5A524" />
    <!-- 锁定键（琥珀底）上的文字/锁图标：白字仅 2:1，改深色字 8.5:1 -->
    <SolidColorBrush x:Key="KeyBarKeyLockedForegroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#B3000000" />

    <!-- opt/full-pass 竖屏重设计：分层材质（doc/PORTRAIT-UI.md）。
         W10M 15063 无 AcrylicBrush（需 16299），用「半透明叠层 + 轻渐变 + 发丝高光描边」模拟层次：
         Card   = 列表卡片（自上而下微暗的渐变，比 Surface 1 略亮，AMOLED 下仍以近黑为主）
         Glass  = 终端页悬浮工具条（半透明，透出终端底色）
         Glow   = 主页页头的强调色斜向晕染（装饰；UseSystemAccent 时 ThemeService 按强调色改 RGB、保留各段 alpha）
         KeyBar = 键条底板与键帽渐变 + 顶部发丝高光 -->
    <LinearGradientBrush x:Key="AppCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#171D2A" Offset="0" />
        <GradientStop Color="#10141D" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppCardPressedBrush" Color="#222C42" />
    <SolidColorBrush x:Key="AppCardSelectedBrush" Color="#1C2436" />
    <SolidColorBrush x:Key="AppCardStrokeBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AppGlassBrush" Color="#D90E121A" />
    <SolidColorBrush x:Key="AppGlassStrokeBrush" Color="#14FFFFFF" />
    <LinearGradientBrush x:Key="AppHeaderGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#382F6FE0" Offset="0" />
        <GradientStop Color="#0D2F6FE0" Offset="0.55" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <!-- 强调色 16% 叠层（徽章底、选中条底）；UseSystemAccent 时 ThemeService 按 AccentSoftOpacity 覆盖 -->
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#292F6FE0" />
    <LinearGradientBrush x:Key="KeyBarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#131926" Offset="0" />
        <GradientStop Color="#07090E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyBarKeyIdleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A3449" Offset="0" />
        <GradientStop Color="#1C2333" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyBarKeyStrokeBrush" Color="#26FFFFFF" />

