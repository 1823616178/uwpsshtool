<!-- 02-UI-DESIGN.md §2.1 深色主题（ThemeDictionaries 同名键）。
     05 §5.1 五层角色归档（键名不变，全工程已在用）：
       Canvas    = AppBgBrush：页面/终端背景，纯黑省 AMOLED 功耗
       Surface 1 = AppSurfaceBrush：列表行、普通卡片
       Surface 2 = AppSurfaceAltBrush / AppPressedBrush：输入、选中、浮层、按压等可交互/提升层级区域
       Stroke    = AppBorderBrush：分隔线、输入边框；聚焦/选中描边改刷 AppAccentBrush（不另立键）
       Semantic  = AppSuccess/Warning/Danger/InfoBrush：只表状态（点、图标、细边、短标签），不作大面积装饰
     其余为辅助角色：Text 三级、Accent/OnAccent、KeyBar 专用、OverlayScrim 遮罩。 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBgBrush" Color="#000000" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#12161F" />
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#1A2030" />
    <SolidColorBrush x:Key="AppPressedBrush" Color="#243048" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#2A3448" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#E8EEFB" />
    <SolidColorBrush x:Key="AppTextDimBrush" Color="#9AA7C0" />
    <SolidColorBrush x:Key="AppTextFaintBrush" Color="#6B7891" />
    <!-- 系统强调色回退值；UseSystemAccent 时由 ThemeService 覆盖 -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="#4D8DFF" />
    <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#34C77B" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="#F5A524" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="#F4605F" />
    <SolidColorBrush x:Key="AppInfoBrush" Color="#3EC6D9" />
    <SolidColorBrush x:Key="KeyBarBgBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="KeyBarKeyBrush" Color="#1E2636" />
    <SolidColorBrush x:Key="KeyBarKeyActiveBrush" Color="#4D8DFF" />
    <SolidColorBrush x:Key="KeyBarKeyLockedBrush" Color="#F5A524" />
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#B3000000" />

    <!-- G01: TextControl（TextBox / PasswordBox / AutoSuggestBox）系统画刷重写 -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#1A2030" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1A2030" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1A2030" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#12161F" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2A3448" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2A3448" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4D8DFF" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A3448" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#E8EEFB" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E8EEFB" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E8EEFB" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#6B7891" />
    <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#9AA7C0" />
    <SolidColorBrush x:Key="TextControlHeaderForegroundDisabled" Color="#6B7891" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6B7891" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6B7891" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6B7891" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#6B7891" />
    <SolidColorBrush x:Key="TextControlButtonBackground" Color="#00000000" />
    <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#243048" />
    <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#243048" />
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="#9AA7C0" />
    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#E8EEFB" />
    <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="#E8EEFB" />

    <!-- G01: ComboBox 系统画刷重写 -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#1A2030" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1A2030" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#243048" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#12161F" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2A3448" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#2A3448" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#2A3448" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#2A3448" />
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#4D8DFF" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#E8EEFB" />
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#E8EEFB" />
    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#E8EEFB" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#E8EEFB" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#E8EEFB" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#6B7891" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#6B7891" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="#6B7891" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#9AA7C0" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="#6B7891" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#9AA7C0" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#9AA7C0" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1A2030" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2A3448" />
    <SolidColorBrush x:Key="ComboBoxHeaderForeground" Color="#9AA7C0" />
    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#00000000" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#243048" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#243048" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#243048" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#243048" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#243048" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedUnfocused" Color="#243048" />
    <SolidColorBrush x:Key="ComboBoxItemBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="#00000000" />
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="#4D8DFF" />
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver" Color="#4D8DFF" />
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed" Color="#4D8DFF" />
    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedUnfocused" Color="#4D8DFF" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#E8EEFB" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#E8EEFB" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#4D8DFF" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#4D8DFF" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="#E8EEFB" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="#6B7891" />
</ResourceDictionary>
