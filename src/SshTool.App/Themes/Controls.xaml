<!-- 文字样式（02-UI-DESIGN.md §2.4）；控件级样式随各控件实现补充 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontHeader}" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextDimBrush}" />
    </Style>
    <Style x:Key="MonoCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextDimBrush}" />
    </Style>
    <!-- U05 §6 MonoText：等宽正文字号（指纹、公钥） -->
    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>

    <!-- 按钮层级（UI 走查 P0）：主＝电青底 onAccent 字；次＝表面底正文字；
         危险＝红底 onAccent 字。全部保证 TouchTargetMin 最小触控。
         CommandBar 内 AppBarButton 保持系统形态，主次靠入口收敛表达。 -->
    <!-- MinWidth 由样式统一兜底（TouchTargetMin），页面按钮不再各自手写。 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppOnAccentBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="MinWidth" Value="{StaticResource TouchTargetMin}" />
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="MinWidth" Value="{StaticResource TouchTargetMin}" />
    </Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppDangerBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppOnAccentBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="MinWidth" Value="{StaticResource TouchTargetMin}" />
    </Style>
    <!-- 对话框内危险主按钮：只换配色，不带字号/最小尺寸（尺寸交由 ContentDialog 按钮区统一布局），
         避免 DangerButtonStyle 的 FontSize/MinHeight/MinWidth 让主/次按钮错位。页面级按钮仍用 DangerButtonStyle。 -->
    <Style x:Key="DangerDialogButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppDangerBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppOnAccentBrush}" />
    </Style>
    <!-- 菜单里的破坏性项（删除/断开）：红字，与 ConfirmDialog(isDanger) 呼应 -->
    <Style x:Key="DangerMenuItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="Foreground" Value="{ThemeResource AppDangerBrush}" />
    </Style>
    <!-- C-03（01-DESIGN.md §7.5）：终端区图标按钮统一。AllowFocusOnInteraction=False
         防点击抢哨兵焦点、SIP 收起；触控宽 ≥TouchTargetMin。行高受限的使用点
         （InfoBar 32 / TabStrip 36）各自显式 Height，样式不强求 40 高。
         无障碍名走 resw（XAML 用 x:Uid，C# 用 ResourceLoader），不进样式。 -->
    <!-- W06：列表项里放 AppListRow 时用——内容横向拉伸、去掉默认内边距（行自带 PagePadding）。 -->
    <Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource PadNone}" />
    </Style>

    <Style x:Key="TerminalIconButtonStyle" TargetType="Button">
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="MinWidth" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="Padding" Value="{StaticResource PadNone}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderNone}" />
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>

    <!-- V01a（05 §5.3 IconButton）：通用图标按钮样式，与终端专用的 TerminalIconButtonStyle 区分
         —— 终端款带 AllowFocusOnInteraction=False 防抢哨兵焦点；本样式不带，用于终端区以外。
         内容放 FontIcon（Glyph 走 Tokens 的 Icon* 键）；Background 默认透明，需要垫底的使用点
         覆盖为 AppSurfaceBrush。模板重写成扁平 Border 才有 Pressed=AppPressedBrush
         （15063 无 Button 的 Pressed 刷色属性，只能换模板）；键盘焦点矩形暂未实现（手机触控优先）。
         ★ 使用点必须配本地化 AutomationProperties.Name（XAML 用 x:Uid，C# 用 ResourceLoader）。 -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="MinHeight" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="Padding" Value="{StaticResource PadNone}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderNone}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource AppSurfaceAltBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource AppPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Opacity" Value="{StaticResource DisabledOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
