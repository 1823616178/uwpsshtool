<Page
    x:Class="SshTool.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U14 设置页（02-UI-DESIGN.md §5.15）：五个 Pivot；外观相关项先链占位页，A05 补齐。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}"
                   Margin="{StaticResource PagePadding}" />
        <Pivot x:Name="SettingsPivot" Grid.Row="1">
            <PivotItem Header="通用">
                <ScrollViewer>
                    <StackPanel Padding="{StaticResource PagePadding}">
                        <ComboBox x:Name="ThemeBox" Header="主题" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="深色" />
                            <ComboBoxItem Content="浅色" />
                        </ComboBox>
                        <ToggleSwitch x:Name="AccentSwitch" Header="使用系统强调色"
                                      Margin="{StaticResource GapSmTop}"
                                      Toggled="OnAccentToggled" />
                        <ComboBox x:Name="SortBox" Header="主机排序" HorizontalAlignment="Stretch"
                                  Margin="{StaticResource GapSmTop}"
                                  SelectionChanged="OnSortChanged">
                            <ComboBoxItem Content="按名称" />
                            <ComboBoxItem Content="按最近连接" />
                        </ComboBox>
                        <ToggleSwitch x:Name="QuickConnectSwitch" Header="显示快速连接卡"
                                      Margin="{StaticResource GapSmTop}"
                                      Toggled="OnQuickConnectToggled" />
                        <ToggleSwitch x:Name="HapticsSwitch" Header="触感反馈"
                                      Margin="{StaticResource GapSmTop}"
                                      Toggled="OnHapticsToggled" />
                        <ComboBox x:Name="LanguageBox" Header="语言" HorizontalAlignment="Stretch"
                                  Margin="{StaticResource GapSmTop}"
                                  SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="简体中文" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                        <TextBlock Text="切换语言后重启应用生效"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="终端">
                <ScrollViewer>
                    <StackPanel Padding="{StaticResource PagePadding}">
                        <TextBlock Text="默认外观" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock x:Name="AppearanceValue" Style="{StaticResource CaptionTextStyle}" />
                        <HyperlinkButton Content="选择外观" Click="OnAppearanceClick" />
                        <TextBlock Text="默认字号" Style="{StaticResource BodyTextStyle}"
                                   Margin="{StaticResource GapSmTop}" />
                        <Slider x:Name="FontSlider" Minimum="8" Maximum="28"
                                StepFrequency="1" ValueChanged="OnFontChanged" />
                        <TextBlock x:Name="FontValue" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="回滚行数" Style="{StaticResource BodyTextStyle}"
                                   Margin="{StaticResource GapSmTop}" />
                        <Slider x:Name="ScrollbackSlider" Minimum="1000" Maximum="50000"
                                StepFrequency="1000" ValueChanged="OnScrollbackChanged" />
                        <TextBlock x:Name="ScrollbackValue" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="1000–50000，越大越占内存"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <ComboBox x:Name="AltScrollBox" Header="Alt-screen 滚动"
                                  HorizontalAlignment="Stretch"
                                  Margin="{StaticResource GapSmTop}"
                                  SelectionChanged="OnAltScrollChanged">
                            <ComboBoxItem Content="方向键" />
                            <ComboBoxItem Content="滚轮" />
                        </ComboBox>
                        <ToggleSwitch x:Name="PasteConfirmSwitch" Header="多行粘贴前确认"
                                      Margin="{StaticResource GapSmTop}"
                                      Toggled="OnPasteConfirmToggled" />
                        <TextBlock Text="光标闪烁跟随外观" Style="{StaticResource BodyTextStyle}"
                                   Margin="{StaticResource GapSmTop}" />
                        <TextBlock Text="在外观页中修改"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <HyperlinkButton Content="去外观" Click="OnAppearanceClick" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="键盘">
                <ScrollViewer>
                    <StackPanel Padding="{StaticResource PagePadding}">
                        <ToggleSwitch x:Name="KeyBarVisibleSwitch" Header="显示键条"
                                      Toggled="OnKeyBarVisibleToggled" />
                        <TextBlock Text="键条布局" Style="{StaticResource BodyTextStyle}"
                                   Margin="{StaticResource GapSmTop}" />
                        <TextBlock x:Name="KeyBarSummary" Style="{StaticResource CaptionTextStyle}" />
                        <HyperlinkButton Content="编辑键条布局" Click="OnEditKeyBarClick" />
                        <TextBlock Text="退格默认发送" Style="{StaticResource BodyTextStyle}"
                                   Margin="{StaticResource GapSmTop}" />
                        <TextBlock Text="退格发送为每台主机单独设置（主机编辑页 → 终端 → 退格发送 Ctrl+H）"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="快捷键表" Style="{StaticResource BodyTextStyle}"
                                   Margin="{StaticResource GapSmTop}" />
                        <TextBlock x:Name="ShortcutSummary" Style="{StaticResource CaptionTextStyle}" />
                        <HyperlinkButton Content="编辑快捷键" Click="OnEditShortcutsClick" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="连接">
                <ScrollViewer>
                    <StackPanel Padding="{StaticResource PagePadding}">
                        <ComboBox x:Name="KeepScreenBox" Header="屏幕常亮"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnKeepScreenChanged">
                            <ComboBoxItem Content="从不" />
                            <ComboBoxItem Content="会话中有连接时" />
                            <ComboBoxItem Content="总是" />
                        </ComboBox>
                        <ToggleSwitch x:Name="KeepAliveSwitch" Header="后台保持连接"
                                      Margin="{StaticResource GapSmTop}"
                                      Toggled="OnKeepAliveToggled" />
                        <TextBlock Text="关闭后进入后台立即断开，回到应用后自动重连"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        <ComboBox x:Name="BgDiscBox" Header="后台 N 分钟后断开"
                                  HorizontalAlignment="Stretch"
                                  Margin="{StaticResource GapSmTop}"
                                  SelectionChanged="OnBgDiscChanged">
                            <ComboBoxItem Content="关" />
                            <ComboBoxItem Content="5 分钟" />
                            <ComboBoxItem Content="15 分钟" />
                            <ComboBoxItem Content="30 分钟" />
                            <ComboBoxItem Content="60 分钟" />
                        </ComboBox>
                        <TextBlock Text="自动重连次数" Style="{StaticResource BodyTextStyle}"
                                   Margin="{StaticResource GapSmTop}" />
                        <Slider x:Name="ReconnectSlider" Minimum="0" Maximum="10"
                                StepFrequency="1" ValueChanged="OnReconnectChanged" />
                        <TextBlock x:Name="ReconnectValue" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="0 = 不自动重连"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="连接超时" Style="{StaticResource BodyTextStyle}"
                                   Margin="{StaticResource GapSmTop}" />
                        <Slider x:Name="TimeoutSlider" Minimum="5" Maximum="60"
                                StepFrequency="1" ValueChanged="OnTimeoutChanged" />
                        <TextBlock x:Name="TimeoutValue" Style="{StaticResource CaptionTextStyle}" />
                        <ComboBox x:Name="PollBox" Header="同步轮询间隔"
                                  HorizontalAlignment="Stretch"
                                  Margin="{StaticResource GapSmTop}"
                                  SelectionChanged="OnPollChanged">
                            <ComboBoxItem Content="关" />
                            <ComboBoxItem Content="1 分钟" />
                            <ComboBoxItem Content="5 分钟" />
                            <ComboBoxItem Content="15 分钟" />
                        </ComboBox>
                        <TextBlock Text="前台轮询，后台不轮询"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="关于">
                <ScrollViewer>
                    <StackPanel Padding="{StaticResource PagePadding}">
                        <TextBlock Text="版本" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock x:Name="AppVersionValue" Style="{StaticResource MonoCaptionTextStyle}" />
                        <HyperlinkButton Content="开源许可" Click="OnLicensesClick" />
                        <ComboBox x:Name="LogLevelBox" Header="日志级别"
                                  HorizontalAlignment="Stretch"
                                  Margin="{StaticResource GapSmTop}"
                                  SelectionChanged="OnLogLevelChanged">
                            <ComboBoxItem Content="调试" />
                            <ComboBoxItem Content="信息" />
                            <ComboBoxItem Content="警告" />
                            <ComboBoxItem Content="错误" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource GapSmTop}">
                            <Button Content="导出日志" Click="OnExportLogsClick" />
                            <Button Content="清空日志" Click="OnClearLogsClick"
                                    Margin="{StaticResource GapSmLeft}" />
                        </StackPanel>
                        <TextBlock Text="诊断信息" Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="{StaticResource GapSmTop}" />
                        <TextBlock x:Name="OsVersionValue" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock x:Name="DeviceFamilyValue" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock x:Name="MemoryValue" Style="{StaticResource CaptionTextStyle}" />
                        <ListView x:Name="ProbeList" SelectionMode="None"
                                  Margin="{StaticResource GapSmTop}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="{StaticResource PagePadding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Status}"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource GapSmTop}">
                            <Button Content="刷新" Click="OnRefreshDiagClick" />
                            <Button Content="复制" Click="OnCopyDiagClick"
                                    Margin="{StaticResource GapSmLeft}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
        <controls:TransientToast x:Name="Toast" Grid.Row="2" />
    </Grid>
</Page>
