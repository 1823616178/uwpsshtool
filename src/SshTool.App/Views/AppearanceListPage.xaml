<Page
    x:Class="SshTool.App.Views.AppearanceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <Page.BottomAppBar>
        <CommandBar Background="{ThemeResource AppSurfaceBrush}">
            <AppBarButton x:Uid="AppearanceList_NewButton" Click="OnNewClick">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{StaticResource IconAdd}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="AppearanceList_ImportButton" Click="OnImportClick">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{StaticResource IconDownload}" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Page.BottomAppBar>

    <!-- A03：外观列表（02-UI-DESIGN.md §5.12）。行点按进编辑；设为默认即时生效。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Uid="AppearanceList_Title"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />
        <ListView x:Name="AppearanceList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="{StaticResource PagePadding}" Tapped="OnRowTapped"
                          Background="{ThemeResource AppBgBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Badge}" Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{ThemeResource AppWarningBrush}"
                                       VerticalAlignment="Center" Margin="{StaticResource GapSmLeft}" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="AppearanceList_SetDefault" Click="OnSetDefaultClick"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" Margin="{StaticResource GapSmLeft}"
                                MinWidth="{StaticResource TouchTargetMin}"
                                MinHeight="{StaticResource TouchTargetMin}"
                                x:Uid="AppearanceList_MoreButton">
                            <FontIcon Glyph="{StaticResource IconMore}" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="AppearanceList_MenuEdit" Click="OnEditClick" />
                                    <MenuFlyoutItem x:Uid="AppearanceList_MenuDuplicate" Click="OnDuplicateClick" />
                                    <MenuFlyoutItem x:Uid="AppearanceList_MenuDelete" Click="OnDeleteClick"
                                                    Style="{StaticResource DangerMenuItemStyle}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Strip}"
                                      Margin="{StaticResource GapXsTop}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding}"
                                            Width="{StaticResource SpaceXl}"
                                            Height="{StaticResource SpaceXl}"
                                            Margin="{StaticResource BorderThin}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
