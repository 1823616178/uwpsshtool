<Page
    x:Class="SshTool.App.Views.AppearanceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBgBrush}">

    <Page.BottomAppBar>
        <CommandBar Background="{ThemeResource AppSurfaceBrush}">
            <AppBarButton Label="新建" Click="OnNewClick">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{StaticResource IconAdd}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="导入" Click="OnImportClick">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{StaticResource IconDownload}" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Page.BottomAppBar>

    <!-- A03：外观列表（02-UI-DESIGN.md §5.12）。行点按进编辑；设为默认即时生效。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="外观" Style="{StaticResource PageTitleTextStyle}"
                   Margin="{StaticResource PagePadding}" />
        <ListView x:Name="AppearanceList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="{StaticResource PagePadding}" Tapped="OnRowTapped"
                          Background="{ThemeResource AppBgBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Badge}" Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{ThemeResource AppWarningBrush}"
                                       VerticalAlignment="Center" Margin="{StaticResource GapSmLeft}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="设为默认" Click="OnSetDefaultClick" />
                        <Button Grid.Column="2" Content="…" Margin="{StaticResource GapSmLeft}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="编辑" Click="OnEditClick" />
                                    <MenuFlyoutItem Text="复制为新主题" Click="OnDuplicateClick" />
                                    <MenuFlyoutItem Text="删除" Click="OnDeleteClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Strip}"
                                      Margin="{StaticResource GapXsTop}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding}"
                                            Width="{StaticResource SpaceXl}"
                                            Height="{StaticResource SpaceXl}"
                                            Margin="{StaticResource BorderThin}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
