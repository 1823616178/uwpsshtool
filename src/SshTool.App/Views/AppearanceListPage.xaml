<Page
    x:Class="SshTool.App.Views.AppearanceListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">


    <!-- A03：外观列表（02-UI-DESIGN.md §5.12）。行点按进编辑；设为默认即时生效。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Uid="AppearanceList_Title"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />
        <Grid Grid.Row="1">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <controls:EmptyState x:Name="Empty"
                                 Glyph="{StaticResource IconPalette}"
                                 Visibility="Collapsed" />
            <controls:EmptyState x:Name="ErrorState"
                                 Kind="Offline"
                                 Visibility="Collapsed" />
            <!-- opt/full-pass：主题行改卡片（与主机/密钥列表同材质），色条与「设为默认」并排，
                 窄屏下不再和三列按钮抢宽度。 -->
            <ListView x:Name="AppearanceList" SelectionMode="None"
                      ItemContainerStyle="{StaticResource CardListViewItemStyle}"
                      Padding="{StaticResource CardListPadding}">
                <ListView.Resources>
                    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid Padding="{StaticResource PadCardRow}" Tapped="OnRowTapped"
                                  Background="Transparent" MinHeight="{StaticResource ListRowHeight}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Badge}" Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{ThemeResource AppWarningBrush}"
                                               VerticalAlignment="Center" Margin="{StaticResource GapSmLeft}" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Uid="AppearanceList_SetDefault" Click="OnSetDefaultClick"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="2" Margin="{StaticResource GapSmLeft}"
                                        MinWidth="{StaticResource TouchTargetMin}"
                                        MinHeight="{StaticResource TouchTargetMin}"
                                        Style="{StaticResource IconButtonStyle}"
                                        x:Uid="AppearanceList_MoreButton">
                                    <FontIcon Glyph="{StaticResource IconMore}" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="AppearanceList_MenuEdit" Click="OnEditClick" />
                                            <MenuFlyoutItem x:Uid="AppearanceList_MenuDuplicate" Click="OnDuplicateClick" />
                                            <MenuFlyoutItem x:Uid="AppearanceList_MenuDelete" Click="OnDeleteClick"
                                                            Style="{StaticResource DangerMenuItemStyle}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Strip}"
                                              Margin="{StaticResource GapSmTop}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding}"
                                                    Width="{StaticResource SpaceXl}"
                                                    Height="{StaticResource SpaceXl}"
                                                    Margin="{StaticResource BorderThin}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- opt/full-pass：底部动作条换成自研 BottomActionBar（与密钥/片段/设置页统一，
             原先这里是系统 CommandBar + 图标按钮，混着两种底栏语言）。 -->
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="2"
                                  PrimaryClick="OnNewClick"
                                  ShowOverflow="True"
                                  OverflowClick="OnImportClick" />
    </Grid>
</Page>
