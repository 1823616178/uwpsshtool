<Page
    x:Class="SshTool.App.Views.Settings.SettingsGeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:AppPageHeader x:Name="PageHeader" x:Uid="SettingsGeneral_Header"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!-- 外观 -->
                <controls:FormSection x:Uid="Settings_General_Section_Appearance">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <!-- 与连接/终端/键盘页同款行式：标题 + 说明在左，控件在右列。 -->
                            <Grid MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="Settings_General_Theme"
                                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="Settings_General_Theme_Note"
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                               Margin="{StaticResource GapXsTop}" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeBox" x:Uid="Settings_General_ThemePicker" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="{StaticResource GapSmLeft}"
                                          SelectionChanged="OnThemeChanged" />
                            </Grid>
                            <Border Height="{StaticResource StrokeThin}" Background="{ThemeResource AppBorderBrush}" />
                            <Grid MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings_General_Accent"
                                           Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="AccentSwitch" x:Uid="Settings_General_UseSystemAccentSwitch" Grid.Column="1"
                                              Style="{StaticResource CompactToggleSwitchStyle}"
                                              Margin="{StaticResource GapSmLeft}"
                                              Toggled="OnAccentToggled" />
                            </Grid>
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>

                <!-- 行为与列表 -->
                <controls:FormSection x:Uid="Settings_General_Section_Behavior" Margin="{StaticResource GapMdTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <Grid MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings_General_Sort"
                                           Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="SortBox" x:Uid="Settings_General_SortPicker" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="{StaticResource GapSmLeft}"
                                          SelectionChanged="OnSortChanged" />
                            </Grid>
                            <Border Height="{StaticResource StrokeThin}" Background="{ThemeResource AppBorderBrush}" />
                            <Grid MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings_General_QuickConnect"
                                           Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="QuickConnectSwitch" x:Uid="Settings_General_QuickConnectSwitch" Grid.Column="1"
                                              Style="{StaticResource CompactToggleSwitchStyle}"
                                              Margin="{StaticResource GapSmLeft}"
                                              Toggled="OnQuickConnectToggled" />
                            </Grid>
                            <Border Height="{StaticResource StrokeThin}" Background="{ThemeResource AppBorderBrush}" />
                            <Grid MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings_General_Haptics"
                                           Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="HapticsSwitch" x:Uid="Settings_General_HapticsSwitch" Grid.Column="1"
                                              Style="{StaticResource CompactToggleSwitchStyle}"
                                              Margin="{StaticResource GapSmLeft}"
                                              Toggled="OnHapticsToggled" />
                            </Grid>
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>

                <!-- 语言 -->
                <controls:FormSection x:Uid="Settings_General_Section_Language" Margin="{StaticResource GapMdTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <Grid MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="Settings_General_Language"
                                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="Settings_General_Language_Note"
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                               Margin="{StaticResource GapXsTop}" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageBox" x:Uid="Settings_General_LanguagePicker" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="{StaticResource GapSmLeft}"
                                          SelectionChanged="OnLanguageChanged" />
                            </Grid>
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>

        <controls:TransientToast x:Name="Toast" Grid.Row="2" />
    </Grid>
</Page>
