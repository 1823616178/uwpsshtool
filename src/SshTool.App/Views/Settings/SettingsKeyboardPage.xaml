<Page
    x:Class="SshTool.App.Views.Settings.SettingsKeyboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:AppPageHeader x:Name="PageHeader" x:Uid="SettingsKeyboard_Header"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!-- 软键盘按键栏 -->
                <controls:FormSection x:Uid="Settings_Keyboard_Section_KeyBar">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <!-- opt/full-pass：开关改行式；下面两项「值 + 去编辑」也改成同一行的行式。 -->
                            <Grid MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Settings_Keyboard_KeyBar"
                                           Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="KeyBarVisibleSwitch"
                                              x:Uid="Settings_Keyboard_KeyBarSwitch"
                                              Grid.Column="1"
                                              Style="{StaticResource CompactToggleSwitchStyle}"
                                              Margin="{StaticResource GapSmLeft}"
                                              Toggled="OnKeyBarVisibleToggled" />
                            </Grid>
                            <Border Height="{StaticResource StrokeThin}" Background="{ThemeResource AppBorderBrush}" />
                            <Grid MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="Settings_Keyboard_KeyBarLayout_Header"
                                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="KeyBarSummary" Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="{StaticResource GapXsTop}" />
                                </StackPanel>
                                <HyperlinkButton x:Uid="Settings_Keyboard_KeyBarLayout_Edit" Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Margin="{StaticResource GapSmLeft}"
                                                 Click="OnEditKeyBarClick" />
                            </Grid>
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>

                <!-- 实体键盘与快捷键 -->
                <controls:FormSection x:Uid="Settings_Keyboard_Section_Physical" Margin="{StaticResource GapMdTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <Grid MinHeight="{StaticResource ListRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="Settings_Keyboard_Shortcuts_Header"
                                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ShortcutSummary" Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="{StaticResource GapXsTop}" />
                                </StackPanel>
                                <HyperlinkButton x:Uid="Settings_Keyboard_Shortcuts_Edit" Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Margin="{StaticResource GapSmLeft}"
                                                 Click="OnEditShortcutsClick" />
                            </Grid>
                            <Border Height="{StaticResource StrokeThin}" Background="{ThemeResource AppBorderBrush}" />
                            <StackPanel Margin="{StaticResource GapSmTop}">
                                <TextBlock x:Uid="Settings_Keyboard_Backspace_Header"
                                           Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Uid="Settings_Keyboard_Backspace_Note"
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                           Margin="{StaticResource GapXsTop}" />
                            </StackPanel>
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>

        <controls:TransientToast x:Name="Toast" Grid.Row="2" />
    </Grid>
</Page>
