<Page
    x:Class="SshTool.App.Views.Settings.SettingsSyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:AppPageHeader x:Name="PageHeader" x:Uid="SettingsSync_Header"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!-- 前台轮询：标题 + 说明在左，下拉在右列（同连接/终端页行式）。 -->
                <controls:FormSection x:Uid="Settings_Sync_Section_Poll">
                    <controls:FormSection.SectionContent>
                        <Grid MinHeight="{StaticResource ListRowHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_Connection_Poll"
                                           Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Uid="Settings_Connection_Poll_Note"
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                           Margin="{StaticResource GapXsTop}" />
                            </StackPanel>
                            <ComboBox x:Name="PollBox" x:Uid="Settings_Connection_PollPicker" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Margin="{StaticResource GapSmLeft}"
                                      SelectionChanged="OnPollChanged" />
                        </Grid>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>

                <!-- 账号与云端同步：入口收成整行可点行，说明作为副标题。 -->
                <controls:FormSection x:Uid="Settings_Sync_Section_Account" Margin="{StaticResource GapMdTop}">
                    <controls:FormSection.SectionContent>
                        <controls:AppListRow x:Name="OpenAccountSyncButton" x:Uid="Settings_Sync_AccountRow"
                                             IconGlyph="{StaticResource IconCloud}"
                                             ShowChevron="True"
                                             IsCard="True"
                                             Click="OnOpenAccountSyncClick" />
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>

        <controls:TransientToast x:Name="Toast" Grid.Row="2" />
    </Grid>
</Page>
