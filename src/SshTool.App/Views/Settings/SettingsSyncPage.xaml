<Page
    x:Class="SshTool.App.Views.Settings.SettingsSyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:AppPageHeader x:Name="PageHeader" x:Uid="SettingsSync_Header"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <!-- 前台轮询 -->
                <controls:FormSection x:Uid="Settings_Sync_Section_Poll">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <ComboBox x:Name="PollBox" x:Uid="Settings_Connection_Poll"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnPollChanged" />
                            <TextBlock x:Uid="Settings_Connection_Poll_Note"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="{StaticResource GapXsTop}" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>

                <!-- 账号与云端同步 -->
                <controls:FormSection x:Uid="Settings_Sync_Section_Account" Margin="{StaticResource GapMdTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_Sync_Account_Desc"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap" />
                            <Button x:Name="OpenAccountSyncButton" x:Uid="Settings_Sync_OpenAccountSync"
                                    Margin="{StaticResource GapMdTop}"
                                    HorizontalAlignment="Stretch"
                                    Click="OnOpenAccountSyncClick" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>

        <controls:TransientToast x:Name="Toast" Grid.Row="2" />
    </Grid>
</Page>
