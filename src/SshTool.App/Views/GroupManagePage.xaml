<Page
    x:Class="SshTool.App.Views.GroupManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <Page.BottomAppBar>
        <CommandBar Background="{ThemeResource AppSurfaceBrush}">
            <AppBarButton Label="新建" Click="OnAddClick">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{StaticResource IconAdd}" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="分组管理" Style="{StaticResource PageTitleTextStyle}"
                   Margin="{StaticResource PagePadding}" />
        <ListView x:Name="GroupList" Grid.Row="1" SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}"
                               MinHeight="{StaticResource ListRowCompactHeight}"
                               Padding="{StaticResource PagePadding}" VerticalAlignment="Center" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel x:Name="Editor" Grid.Row="2" Padding="{StaticResource PagePadding}" Visibility="Collapsed"
                    Background="{ThemeResource AppSurfaceBrush}">
            <TextBox x:Name="NameBox" Header="名称" LostFocus="OnNameLostFocus" />
            <controls:ColorSwatchPicker x:Name="Picker" Margin="{StaticResource GapSmTop}"
                                        ColorChanged="OnColorChanged" />
            <StackPanel Orientation="Horizontal" Margin="{StaticResource GapSmTop}">
                <Button Content="上移" Click="OnMoveUp" />
                <Button Content="下移" Click="OnMoveDown" Margin="{StaticResource GapSmLeft}" />
                <Button Content="删除" Click="OnDelete" Margin="{StaticResource GapSmLeft}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
