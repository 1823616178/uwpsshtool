<Page
    x:Class="SshTool.App.Views.GroupManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Uid="GroupManage_Title"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />
        <Grid Grid.Row="1">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <controls:EmptyState x:Name="Empty"
                                 Glyph="{StaticResource IconFolder}"
                                 Visibility="Collapsed" />
            <!-- opt/full-pass：分组行改卡片（与主机列表同材质），选中态走 AppCardSelectedBrush，
                 分组名左侧用分组色圆点代替通用文件夹字形（颜色不是唯一信息——名称照旧可读）。 -->
            <ListView x:Name="GroupList" SelectionMode="Single"
                      ItemContainerStyle="{StaticResource CardListViewItemStyle}"
                      Padding="{StaticResource CardListPadding}"
                      SelectionChanged="OnSelectionChanged">
                <ListView.Resources>
                    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- W06：统一 V2 列表行；opt/full-pass 起改卡片。 -->
                        <controls:AppListRow Title="{Binding Name}"
                                             Subtitle="{Binding Subtitle}"
                                             IconGlyph="{StaticResource IconFolder}"
                                             IsCard="True">
                            <controls:AppListRow.StatusContent>
                                <Border Width="{StaticResource StatusDotSize}"
                                        Height="{StaticResource StatusDotSize}"
                                        CornerRadius="{StaticResource RadiusCircle}"
                                        Background="{Binding ColorBrush}"
                                        Visibility="{Binding ColorVisibility}" />
                            </controls:AppListRow.StatusContent>
                        </controls:AppListRow>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <StackPanel x:Name="Editor" Grid.Row="2" Padding="{StaticResource PagePadding}" Visibility="Collapsed"
                    Background="{ThemeResource AppSurfaceBrush}">
            <StackPanel MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <controls:FormSection x:Uid="GroupManage_Section_Edit">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <TextBox x:Name="NameBox" x:Uid="GroupManage_NameBox" LostFocus="OnNameLostFocus" />
                            <controls:ColorSwatchPicker x:Name="Picker" Margin="{StaticResource GapSmTop}"
                                                        ColorChanged="OnColorChanged" />
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource GapSmTop}">
                                <Button x:Uid="GroupManage_MoveUp" Click="OnMoveUp" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Uid="GroupManage_MoveDown" Click="OnMoveDown" Margin="{StaticResource GapSmLeft}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Uid="GroupManage_Delete" Click="OnDelete" Margin="{StaticResource GapSmLeft}"
                                        Style="{StaticResource DangerButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
            </StackPanel>
        </StackPanel>

        <!-- 底部固定操作条：主操作=新建分组 -->
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="3"
                                  PrimaryClick="OnAddClick" />
    </Grid>
</Page>
