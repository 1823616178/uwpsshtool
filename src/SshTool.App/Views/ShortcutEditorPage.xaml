<Page
    x:Class="SshTool.App.Views.ShortcutEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U14 快捷键表编辑（02-UI-DESIGN.md §5.16）：列出动作 ↔ 组合键，点击录制新组合。 -->
    <Page.Resources>
        <DataTemplate x:Key="ShortcutItemTemplate">
            <Grid Padding="{StaticResource PagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Text="{Binding ChordText}" Style="{StaticResource MonoCaptionTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" x:Uid="Shortcut_Record" Click="OnRecordClick"
                        MinWidth="{StaticResource TouchTargetMin}"
                        MinHeight="{StaticResource TouchTargetMin}"
                        Margin="{StaticResource GapSmLeft}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Uid="Shortcut_Title"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />
        <TextBlock x:Uid="Shortcut_Subtitle" Style="{StaticResource CaptionTextStyle}" Grid.Row="1"
                   Margin="{StaticResource PagePadding}" TextWrapping="Wrap" />
        <controls:FormSection x:Uid="Shortcut_Section_List" Grid.Row="2"
                              MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch"
                              Margin="{StaticResource PagePadding}">
            <controls:FormSection.SectionContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ConflictWarning"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{ThemeResource AppDangerBrush}"
                               Margin="{StaticResource GapSmBottom}"
                               Visibility="Collapsed" TextWrapping="Wrap" />
                    <ListView x:Name="ShortcutList" Grid.Row="1"
                              ItemTemplate="{StaticResource ShortcutItemTemplate}"
                              SelectionMode="None" />
                </Grid>
            </controls:FormSection.SectionContent>
        </controls:FormSection>
        <!-- 底部固定操作条：主操作=恢复默认 -->
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="3"
                                  PrimaryClick="OnResetClick"
                                  PrimaryButtonStyle="{StaticResource SecondaryButtonStyle}" />
        <controls:TransientToast x:Name="Toast" Grid.Row="3" />
    </Grid>
</Page>
