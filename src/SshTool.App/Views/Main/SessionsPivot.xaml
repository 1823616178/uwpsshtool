<UserControl
    x:Class="SshTool.App.Views.Main.SessionsPivot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    xmlns:local="using:SshTool.App.Views.Main">

    <!-- UI 走查：会话状态是枚举，直接绑定会把 Connected/Authenticating 这类
         英文枚举名甩到屏幕上；改走转换器出中文（说法与 StatusDot 无障碍名一致）。 -->
    <UserControl.Resources>
        <local:SessionStateTextConverter x:Key="SessionStateText" />
        <local:SessionStateDotConverter x:Key="SessionStateDot" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- opt/full-pass 竖屏重设计：恢复提示改卡片材质（强调色叠层底），与会话卡片同圆角。 -->
        <Border x:Name="RestoreCard" Style="{StaticResource CardBorderStyle}"
                Background="{ThemeResource AppAccentSoftBrush}"
                Padding="{StaticResource PadCard}"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="RestoreText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                <!-- UI 走查：恢复为次级动作（主入口在主机列表），补触控。 -->
                <Button x:Uid="SessionsPivot_Button1" Click="OnRestore"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="{StaticResource GapSmTop}" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <!-- opt/full-pass 竖屏重设计：会话卡片——左侧状态色条（连接中/已连接/错误 一眼可辨，
                 文字状态仍保留，不只靠颜色）+ 终端字形强调色方块 + 标题/状态 + 关闭圆钮。
                 系统悬停/按压/选中底色改透明，由卡片自身表达；条目进场错峰、增删位移动画。 -->
            <ListView x:Name="SessionList" SelectionMode="Single"
                      ItemContainerStyle="{StaticResource CardListViewItemStyle}"
                      Padding="{StaticResource CardListPadding}"
                      IsItemClickEnabled="True" ItemClick="OnItemClick">
                <ListView.Resources>
                    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}"
                                MinHeight="{StaticResource ListRowHeight}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- ui/fix-pass：状态色条（转换器一次性取画刷，换主题不刷新、只靠颜色区分）换成
                                     StatusDot：颜色走 ThemeResource 跟随主题，连接中/重连中脉动，自带无障碍名。 -->
                                <controls:StatusDot State="{Binding State, Converter={StaticResource SessionStateDot}}"
                                                    Margin="{StaticResource GapMdLeft}"
                                                    VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Width="{StaticResource AvatarSize}"
                                        Height="{StaticResource AvatarSize}"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Background="{ThemeResource AppAccentSoftBrush}"
                                        Margin="{StaticResource GapSmLeft}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{StaticResource IconTerminal}"
                                              FontSize="{StaticResource FontBody}"
                                              Foreground="{ThemeResource AppAccentTextBrush}" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            Margin="{StaticResource GapMdLeft}">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextStyle}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding State, Converter={StaticResource SessionStateText}}"
                                               Foreground="{ThemeResource AppTextDimBrush}"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <!-- UI 走查：✕ 换 IconClose 字形（Segoe MDL2），补触控；无障碍名走 resw。 -->
                                <Button Grid.Column="3" x:Uid="SessionsPivot_CloseButton"
                                        Click="OnCloseClick" Tag="{Binding}"
                                        Style="{StaticResource IconButtonStyle}"
                                        Margin="{StaticResource GapSmRight}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{StaticResource IconClose}" FontSize="{StaticResource FontBody}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <controls:EmptyState x:Uid="SessionsPivot_Empty" x:Name="Empty"
                                 Glyph="{StaticResource IconConnect}" />
        </Grid>
    </Grid>
</UserControl>
