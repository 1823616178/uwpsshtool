<UserControl
    x:Class="SshTool.App.Views.Main.TunnelsPivot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls">

    <!-- F06：MainPage 隧道 Pivot（02-UI §5.3；05-CODE-AUDIT §6.1）。
         展示全部端口转发规则、运行状态与速率；启停开关；全部停止与新建操作。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏操作区：标题 + 全部停止 + 添加隧道 -->
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Tunnels_Title" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
            <Button x:Name="StopAllButton" x:Uid="Tunnels_StopAllButton" Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}" Click="OnStopAllClick"
                    Margin="{StaticResource GapSmLeft}">
                <FontIcon Glyph="{StaticResource IconDisconnect}" FontSize="{StaticResource FontBody}" />
            </Button>
            <Button x:Name="AddTunnelButton" x:Uid="Tunnels_AddTunnelButton" Grid.Column="2"
                    Style="{StaticResource IconButtonStyle}" Click="OnAddClick"
                    Margin="{StaticResource GapSmLeft}">
                <FontIcon Glyph="{StaticResource IconAdd}" FontSize="{StaticResource FontBody}" />
            </Button>
        </Grid>

        <!-- 隧道列表与空状态 -->
        <Grid Grid.Row="1">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <ListView x:Name="TunnelList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <controls:TunnelRow EditRequested="OnRowEdit"
                                            ToggleRequested="OnRowToggle"
                                            DeleteRequested="OnRowDelete" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <controls:EmptyState x:Name="Empty"
                                 x:Uid="Tunnels_EmptyState"
                                 Glyph="{StaticResource IconTunnel}" />
            <controls:EmptyState x:Name="ErrorState"
                                 Kind="Offline"
                                 Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
