<UserControl
    x:Class="SshTool.App.Views.Main.HostsPivot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls">

    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedHosts" x:Name="GroupedHosts"
                              IsSourceGrouped="True" ItemsPath="Rows" />
        <DataTemplate x:Key="HostItemTemplate">
            <controls:HostRow ConnectRequested="OnConnectRequested"
                              NewSessionRequested="OnNewSessionRequested"
                              EditRequested="OnEditRequested"
                              DuplicateRequested="OnDuplicateRequested"
                              SftpRequested="OnSftpRequested"
                              DeleteRequested="OnDeleteRequested" />
        </DataTemplate>
        <DataTemplate x:Key="GroupHeaderTemplate">
            <controls:GroupHeader Tapped="OnGroupHeaderTapped" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- V02（05 §6.1）：搜索行常驻（原 CommandBar 搜索按钮的职责由底栏「快速连接」取代）；
             右侧 ＋ 新建主机图标按钮，命令与底栏「新建主机」一致。 -->
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" x:Uid="Hosts_SearchBox"
                            QueryIcon="Find"
                            TextChanged="OnSearchTextChanged" />
            <Button x:Name="NewHostButton" x:Uid="Hosts_NewHostButton" Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}" Click="OnNewHostClick"
                    Margin="{StaticResource GapSmLeft}">
                <FontIcon Glyph="{StaticResource IconAdd}" FontSize="{StaticResource FontBody}" />
            </Button>
        </Grid>

        <!-- V02（05 §6.1）：快速连接默认折叠为一行，点击（或底栏「快速连接」命令）展开为表单；
             展开态记忆 hostQuickConnectExpanded。Chevron 方向跟随展开态（code-behind 赋值）。 -->
        <Grid x:Name="QuickConnectRow" x:Uid="Hosts_QuickConnectRow" Grid.Row="1"
              Background="Transparent"
              MinHeight="{StaticResource ListRowCompactHeight}"
              Padding="{StaticResource PagePadding}"
              Tapped="OnQuickConnectRowTapped"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="{StaticResource IconConnect}"
                      FontSize="{StaticResource FontBody}"
                      Foreground="{ThemeResource AppTextDimBrush}"
                      VerticalAlignment="Center" />
            <TextBlock x:Uid="Hosts_QuickConnectRowText" Grid.Column="1"
                       Style="{StaticResource BodyTextStyle}"
                       VerticalAlignment="Center"
                       Margin="{StaticResource GapSmLeft}" />
            <FontIcon x:Name="QuickConnectChevron" Grid.Column="2"
                      Glyph="{StaticResource IconChevronDown}"
                      FontSize="{StaticResource FontCaption}"
                      Foreground="{ThemeResource AppTextDimBrush}"
                      VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="QuickConnectCard" Grid.Row="2"
              Background="{ThemeResource AppSurfaceAltBrush}"
              Padding="{StaticResource PadMd}"
              Margin="{StaticResource PagePadding}"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QuickConnectBox" x:Uid="Hosts_QuickConnectBox"
                     TextChanged="OnQuickConnectTextChanged" />
            <Button Grid.Column="1" x:Uid="Hosts_QuickConnectGo" Click="OnQuickConnectClick"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Bottom" Margin="{StaticResource GapSmLeft}" />
        </Grid>

        <Grid Grid.Row="3">
            <!-- V02：空结果与真正无主机分 Kind——NoMatches=Filtered（默认 IconSearch）、
                 Empty=Normal（显式 Glyph 优先）。NoMatches 标题/主按钮由 code-behind 按搜索词拼装。 -->
            <controls:EmptyState x:Name="Empty" x:Uid="Hosts_Empty"
                                 Glyph="{StaticResource IconTerminal}"
                                 Visibility="Collapsed" />
            <controls:EmptyState x:Name="NoMatches"
                                 Kind="Filtered"
                                 Visibility="Collapsed" />
            <ListView x:Name="HostList"
                      ItemTemplate="{StaticResource HostItemTemplate}"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="False" HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                </ListView.GroupStyle>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
