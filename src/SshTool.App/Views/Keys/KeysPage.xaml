<Page
    x:Class="SshTool.App.Views.Keys.KeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- V04b（§6.4 + C-06）：密钥管理。行用 AppListRow（图标/标题/副标题/尾操作），
         底部 BottomActionBar（生成/导入），全量文案走 resw 双语。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Keys_Title" Style="{StaticResource PageTitleTextStyle}"
                   Margin="{StaticResource PagePadding}" />
        <Grid Grid.Row="1">
            <controls:EmptyState x:Name="Empty"
                                 Glyph="{StaticResource IconKey}"
                                 Visibility="Collapsed" />
            <ListView x:Name="KeyList" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="OnItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <controls:AppListRow IconGlyph="{StaticResource IconKey}"
                                             Title="{Binding Name}"
                                             Subtitle="{Binding Subtitle}"
                                             ShowChevron="True">
                            <controls:AppListRow.TrailingContent>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        MinWidth="{StaticResource TouchTargetMin}"
                                        MinHeight="{StaticResource TouchTargetMin}"
                                        AutomationProperties.Name="{StaticResource Keys_MoreButton_A11yName}">
                                    <FontIcon Glyph="{StaticResource IconMore}" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="Keys_MenuDetail" Click="OnDetailClick" />
                                            <MenuFlyoutItem x:Uid="Keys_MenuDelete" Click="OnDeleteClick"
                                                            Style="{StaticResource DangerMenuItemStyle}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </controls:AppListRow.TrailingContent>
                        </controls:AppListRow>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="2"
                                  PrimaryText="{StaticResource Keys_Generate}"
                                  ShowOverflow="True"
                                  PrimaryClick="OnGenerateClick"
                                  OverflowClick="OnImportClick" />
    </Grid>
</Page>
