<Page
    x:Class="SshTool.App.Views.Keys.KeyDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- K02 密钥详情（02-UI-DESIGN.md §5.10）：改名、类型/指纹、复制/分享公钥、
         使用它的主机、导出私钥（二次确认）、删除（被引用时禁止）。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="KeyDetail_Title" Style="{StaticResource PageTitleTextStyle}"
                   Margin="{StaticResource PagePadding}" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PagePadding}">
                <TextBox x:Name="NameBox" x:Uid="KeyDetail_NameBox" TextChanged="OnNameChanged" />
                <Button x:Name="RenameButton" x:Uid="KeyDetail_Rename" Click="OnRenameClick"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False" Margin="{StaticResource GapXsTop}" />

                <TextBlock x:Uid="KeyDetail_TypeLabel" Style="{StaticResource CaptionTextStyle}"
                           Margin="{StaticResource GapSmTop}" />
                <TextBlock x:Name="TypeText" Style="{StaticResource BodyTextStyle}" />
                <TextBlock x:Uid="KeyDetail_BitsLabel" Style="{StaticResource CaptionTextStyle}"
                           Margin="{StaticResource GapXsTop}" />
                <TextBlock x:Name="BitsText" Style="{StaticResource BodyTextStyle}" />
                <TextBlock x:Uid="KeyDetail_FormatLabel" Style="{StaticResource CaptionTextStyle}"
                           Margin="{StaticResource GapXsTop}" />
                <TextBlock x:Name="FormatText" Style="{StaticResource BodyTextStyle}" />
                <TextBlock x:Uid="KeyDetail_EncryptedLabel" Style="{StaticResource CaptionTextStyle}"
                           Margin="{StaticResource GapXsTop}" />
                <TextBlock x:Name="EncryptedText" Style="{StaticResource BodyTextStyle}" />
                <TextBlock x:Uid="KeyDetail_CreatedLabel" Style="{StaticResource CaptionTextStyle}"
                           Margin="{StaticResource GapXsTop}" />
                <TextBlock x:Name="CreatedText" Style="{StaticResource BodyTextStyle}" />

                <TextBlock x:Uid="KeyDetail_FingerprintLabel" Style="{StaticResource CaptionTextStyle}"
                           Margin="{StaticResource GapSmTop}" />
                <controls:MonoText x:Name="FingerprintText" Compact="True" />

                <TextBlock x:Uid="KeyDetail_PublicKeyLabel" Style="{StaticResource CaptionTextStyle}"
                           Margin="{StaticResource GapSmTop}" />
                <controls:MonoText x:Name="PublicKeyText" Compact="True" />
                <StackPanel Orientation="Horizontal" Margin="{StaticResource GapXsTop}">
                    <Button x:Uid="KeyDetail_Copy" Click="OnCopyClick"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Uid="KeyDetail_Share" Click="OnShareClick" Margin="{StaticResource GapSmLeft}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <TextBlock x:Uid="KeyDetail_UsedByLabel" Style="{StaticResource CaptionTextStyle}"
                           Margin="{StaticResource GapSmTop}" />
                <TextBlock x:Name="NoHostsText" x:Uid="KeyDetail_NoHosts"
                           Style="{StaticResource BodyTextStyle}" />
                <ListView x:Name="HostList" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="OnHostClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="{StaticResource PagePadding}">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button x:Uid="KeyDetail_Export" Click="OnExportClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="{StaticResource GapSmTop}" />
                <Button x:Uid="KeyDetail_Delete" Click="OnDeleteClick"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="{StaticResource GapXsTop}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap" Margin="{StaticResource GapXsTop}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
