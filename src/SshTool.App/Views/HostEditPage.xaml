<Page
    x:Class="SshTool.App.Views.HostEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SshTool.App.Infrastructure"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- V04b（§6.4）：五 Section 结构（基础连接/认证/终端/代理跳板/高级）+ 底部固定 BottomActionBar。
         高级 Section 默认折叠，点击头部展开。LoadingOverlay 保留测试态。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}"
                   Margin="{StaticResource PagePadding}" />
        <ScrollViewer infra:InputPaneScroll.IsEnabled="True" Grid.Row="1">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!-- ========== 基础连接 ========== -->
                <controls:FormSection x:Uid="HostEdit_Section_Basic">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <TextBox x:Name="NameBox" x:Uid="HostEdit_NameBox" TextChanged="OnNameChanged" />
                            <TextBlock x:Name="NameError" Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{ThemeResource AppDangerBrush}" Visibility="Collapsed" />
                            <TextBox x:Name="HostBox" x:Uid="HostEdit_HostBox" Margin="{StaticResource GapSmTop}" TextChanged="OnHostChanged" />
                            <TextBlock x:Name="HostError" Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{ThemeResource AppDangerBrush}" Visibility="Collapsed" />
                            <TextBox x:Name="PortBox" x:Uid="HostEdit_PortBox" InputScope="Number" Margin="{StaticResource GapSmTop}" TextChanged="OnPortChanged" />
                            <TextBlock x:Name="PortError" Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{ThemeResource AppDangerBrush}" Visibility="Collapsed" />
                            <TextBox x:Name="UserBox" x:Uid="HostEdit_UserBox" Margin="{StaticResource GapSmTop}" TextChanged="OnUserChanged" />
                            <TextBlock x:Name="UserError" Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{ThemeResource AppDangerBrush}" Visibility="Collapsed" />
                            <ComboBox x:Name="GroupBox" x:Uid="HostEdit_GroupBox" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Name" Margin="{StaticResource GapSmTop}"
                                      SelectionChanged="OnGroupChanged" />
                            <HyperlinkButton x:Uid="HostEdit_ManageGroups" Click="OnManageGroups" />
                            <TextBlock x:Uid="HostEdit_LocalOnly" Style="{StaticResource CaptionTextStyle}" />
                            <TextBox x:Name="KeepaliveBox" x:Uid="HostEdit_KeepaliveBox" InputScope="Number"
                                     Margin="{StaticResource GapSmTop}" TextChanged="OnKeepaliveChanged" />
                            <TextBlock x:Name="KeepaliveError" Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{ThemeResource AppDangerBrush}" Visibility="Collapsed" />
                            <TextBlock x:Uid="HostEdit_LocalOnly" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Uid="HostEdit_HostFingerprint" Style="{StaticResource CaptionTextStyle}" Margin="{StaticResource GapSmTop}" />
                            <controls:MonoText x:Name="FingerprintText" Compact="True" />
                            <HyperlinkButton x:Uid="HostEdit_ClearFingerprint" Click="OnClearFingerprint" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>

                <!-- ========== 认证 ========== -->
                <controls:FormSection x:Uid="HostEdit_Section_Auth" Margin="{StaticResource GapSmTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <RadioButton x:Name="AuthPasswordRadio" x:Uid="HostEdit_AuthPasswordRadio" GroupName="HostAuth"
                                         Checked="OnAuthPasswordChecked" />
                            <RadioButton x:Name="AuthKeyRadio" x:Uid="HostEdit_AuthKeyRadio" GroupName="HostAuth"
                                         Checked="OnAuthKeyChecked" />
                            <RadioButton x:Name="AuthAgentRadio" x:Uid="HostEdit_AuthAgentRadio" GroupName="HostAuth"
                                         Checked="OnAuthAgentChecked" />

                            <StackPanel x:Name="PasswordPanel" Margin="{StaticResource GapSmTop}">
                                <PasswordBox x:Name="PasswordBox" x:Uid="HostEdit_PasswordBox"
                                             PasswordChanged="OnPasswordChanged" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Margin="{StaticResource GapXsTop}" TextWrapping="Wrap"
                                           Text="{x:Bind ViewModel.PasswordCredentialStateText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsPasswordCredentialSaved, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Margin="{StaticResource GapXsTop}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource AppTextBrush}"
                                           Text="{x:Bind ViewModel.PasswordCredentialStateText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsPasswordCredentialNew, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Margin="{StaticResource GapXsTop}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource AppDangerBrush}"
                                           Text="{x:Bind ViewModel.PasswordCredentialStateText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsPasswordCredentialCleared, Mode=OneWay}" />
                                <ToggleSwitch x:Name="RememberPasswordSwitch" x:Uid="HostEdit_RememberPasswordSwitch"
                                              Toggled="OnRememberPasswordToggled" />
                                <TextBlock x:Uid="HostEdit_SyncPasswordNote" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="KeyPanel" Margin="{StaticResource GapSmTop}" Visibility="Collapsed">
                                <ComboBox x:Name="KeyBox" x:Uid="HostEdit_KeyBox" HorizontalAlignment="Stretch"
                                          DisplayMemberPath="Name" SelectionChanged="OnKeyChanged" />
                                <StackPanel Orientation="Horizontal" Margin="{StaticResource GapXsTop}">
                                    <HyperlinkButton x:Uid="HostEdit_ImportKey" Click="OnImportKey" />
                                    <HyperlinkButton x:Uid="HostEdit_GenerateKey" Click="OnGenerateKey"
                                                     Margin="{StaticResource GapSmLeft}" />
                                </StackPanel>
                                <PasswordBox x:Name="PassphraseBox" x:Uid="HostEdit_PassphraseBox"
                                             Margin="{StaticResource GapSmTop}"
                                             PasswordChanged="OnPassphraseChanged" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Margin="{StaticResource GapXsTop}" TextWrapping="Wrap"
                                           Text="{x:Bind ViewModel.PassphraseCredentialStateText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsPassphraseCredentialSaved, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Margin="{StaticResource GapXsTop}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource AppTextBrush}"
                                           Text="{x:Bind ViewModel.PassphraseCredentialStateText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsPassphraseCredentialNew, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Margin="{StaticResource GapXsTop}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource AppDangerBrush}"
                                           Text="{x:Bind ViewModel.PassphraseCredentialStateText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsPassphraseCredentialCleared, Mode=OneWay}" />
                                <ToggleSwitch x:Name="RememberPassphraseSwitch" x:Uid="HostEdit_RememberPassphraseSwitch"
                                              Toggled="OnRememberPassphraseToggled" />
                            </StackPanel>
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>

                <!-- ========== 终端 ========== -->
                <controls:FormSection x:Uid="HostEdit_Section_Terminal" Margin="{StaticResource GapSmTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <ComboBox x:Name="AppearanceBox" x:Uid="HostEdit_AppearanceBox" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Name" SelectionChanged="OnAppearanceChanged" />
                            <HyperlinkButton x:Uid="HostEdit_ManageAppearances" Click="OnManageAppearances" />
                            <TextBlock x:Uid="HostEdit_LocalOnly" Style="{StaticResource CaptionTextStyle}" />
                            <ComboBox x:Name="TermTypeBox" x:Uid="HostEdit_TermTypeBox" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Name" Margin="{StaticResource GapSmTop}"
                                      SelectionChanged="OnTermTypeChanged" />
                            <TextBlock x:Uid="HostEdit_LocalOnly" Style="{StaticResource CaptionTextStyle}" />
                            <ToggleSwitch x:Name="BackspaceSwitch" x:Uid="HostEdit_BackspaceSwitch"
                                          Margin="{StaticResource GapSmTop}" Toggled="OnBackspaceToggled" />
                            <TextBlock x:Uid="HostEdit_LocalOnly" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Uid="HostEdit_EnvVars" Style="{StaticResource BodyTextStyle}" Margin="{StaticResource GapSmTop}" />
                            <TextBlock x:Uid="HostEdit_LocalOnly" Style="{StaticResource CaptionTextStyle}" />
                            <ItemsControl x:Name="EnvList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{StaticResource GapXsTop}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Uid="HostEdit_EnvKeyBox" Text="{Binding Key, Mode=TwoWay}" />
                                            <TextBox Grid.Column="1" x:Uid="HostEdit_EnvValueBox" Text="{Binding Value, Mode=TwoWay}"
                                                     Margin="{StaticResource GapSmLeft}" />
                                            <HyperlinkButton x:Uid="HostEdit_RemoveEnv" Grid.Column="2" Click="OnRemoveEnv"
                                                             Margin="{StaticResource GapSmLeft}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <HyperlinkButton x:Uid="HostEdit_AddEnv" Click="OnAddEnv" />
                            <TextBlock x:Name="EnvError" Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{ThemeResource AppDangerBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>

                <!-- ========== 代理/跳板 ========== -->
                <controls:FormSection x:Uid="HostEdit_Section_Proxy" Margin="{StaticResource GapSmTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <ComboBox x:Name="JumpBox" x:Uid="HostEdit_JumpBox" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Name" SelectionChanged="OnJumpChanged" />
                            <TextBlock x:Uid="HostEdit_LocalOnly" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock x:Name="JumpError" Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{ThemeResource AppDangerBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>

                <!-- ========== 高级（默认折叠） ========== -->
                <Grid Margin="{StaticResource GapSmTop}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 折叠头部：点击切换下方内容可见性，chevron 随状态翻转 -->
                    <Button x:Name="AdvancedToggle" Grid.Row="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="{StaticResource BorderNone}"
                            Padding="{StaticResource PadNone}"
                            Click="OnAdvancedToggleClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="AdvancedChevron" Glyph="{StaticResource IconChevronRight}"
                                      FontSize="{StaticResource FontCaption}"
                                      Foreground="{ThemeResource AppTextDimBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Uid="HostEdit_Section_Advanced" Grid.Column="1"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Margin="{StaticResource GapSmLeft}" />
                        </Grid>
                    </Button>
                    <StackPanel x:Name="AdvancedContent" Grid.Row="1" Visibility="Collapsed">
                        <ToggleSwitch x:Name="TmuxSwitch" x:Uid="HostEdit_TmuxSwitch" Toggled="OnTmuxToggled" />
                        <TextBlock x:Uid="HostEdit_TmuxNote" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="HostEdit_LocalOnly" Style="{StaticResource CaptionTextStyle}" />
                        <TextBox x:Name="TmuxNameBox" x:Uid="HostEdit_TmuxNameBox" Margin="{StaticResource GapSmTop}"
                                 TextChanged="OnTmuxNameChanged" />
                        <TextBox x:Name="InitBox" x:Uid="HostEdit_InitBox"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Margin="{StaticResource GapSmTop}" TextChanged="OnInitChanged" />
                        <TextBlock x:Uid="HostEdit_LocalOnly" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock x:Uid="HostEdit_Tunnels" Style="{StaticResource BodyTextStyle}" Margin="{StaticResource GapSmTop}" />
                        <ListView x:Name="TunnelList" DisplayMemberPath="Name" SelectionMode="Single"
                                  IsItemClickEnabled="True" ItemClick="OnTunnelItemClick" />
                        <HyperlinkButton x:Uid="HostEdit_AddTunnel" Click="OnAddTunnel" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定操作条：主操作=保存，溢出=测试连接（PrimaryText/OverflowFlyout 在 code-behind 用 resw 装配） -->
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="2"
                                  ShowOverflow="True"
                                  PrimaryClick="OnSaveClick"
                                  OverflowClick="OnTestClick" />
        <controls:LoadingOverlay x:Name="TestOverlay" Grid.RowSpan="3" />
    </Grid>
</Page>
