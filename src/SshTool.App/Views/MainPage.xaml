<Page
    x:Class="SshTool.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    xmlns:main="using:SshTool.App.Views.Main"
    Background="{ThemeResource AppBgBrush}">

    <!-- S14：同步图标绑定 SyncState（02-UI-DESIGN.md §5.1，映射见 SyncIconMap）；
         syncing 时 SyncSpinStory 持续旋转（由 MainPage.xaml.cs 按 IsSyncSpinning 起停）。 -->
    <Page.Resources>
        <Storyboard x:Name="SyncSpinStory" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SyncSpinTransform"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1" />
        </Storyboard>
    </Page.Resources>

    <!-- H-3（02 §4.5 规则 5）：底部操作只有一种语言 BottomActionBar，不用 Page.BottomAppBar。
         主操作=新建主机；溢出=快速连接 / 工具与设置 / 关于 / 登录 / 开发工具（仅 DEBUG_PAGES 显示）。
         快速连接的 in-content 入口仍在 HostsPivot 展开区，底栏溢出项为快捷方式。 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:Banner x:Name="LoadWarningBanner" Visibility="Collapsed" />

        <!-- V02（05 §6.1）：顶行页头（标题走 resw；主页无返回，ShowBackButton 保持 false）。
             StatusContent 放同步图标按钮——从 CommandBar 挪上来，图标/前景/旋转动画与
             点击语义（SyncCommand）不变；PrimaryAction 留空（新建已在主底栏）。宽屏同样
             显示本页头，WideGrid 内不再重复标题。 -->
        <!-- opt/full-pass 竖屏重设计：页头背后一层强调色斜向辉光（渐变到透明，不拦截点击）。
             15063 没有 AcrylicBrush，用 LinearGradientBrush 叠层模拟层次感。 -->
        <Border Grid.Row="1" Background="{ThemeResource AppHeaderGlowBrush}" IsHitTestVisible="False" />
        <controls:AppPageHeader x:Name="PageHeader" Grid.Row="1" x:Uid="Main_PageHeader"
                                Level="Primary">
            <controls:AppPageHeader.StatusContent>
                <Button x:Name="SyncButton" x:Uid="Main_SyncButton"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnSyncClick">
                    <FontIcon x:Name="SyncGlyph"
                              Glyph="{x:Bind ViewModel.SyncIconGlyph, Mode=OneWay}"
                              Foreground="{x:Bind ViewModel.SyncIconForeground, Mode=OneWay}"
                              RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform x:Name="SyncSpinTransform" Angle="0" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>
            </controls:AppPageHeader.StatusContent>
        </controls:AppPageHeader>

        <!-- V02：Pivot Title 移除（标题由 AppPageHeader 承担，避免双标题）；页签文字走 resw。 -->
        <!-- ui/portrait-polish-2：系统 PivotItem 默认左右各 12 的外边距，叠上卡片自带的 12 后，
             竖屏卡片离屏幕边 24、和页头标题/页签对不齐，360 宽的 Lumia 950 上显得窄而空。
             仅对主页 Pivot 去掉这层外边距，卡片与标题统一 12 的左右边。 -->
        <Pivot x:Name="MainPivot" Grid.Row="2">
            <Pivot.Resources>
                <Style TargetType="PivotItem">
                    <Setter Property="Margin" Value="{StaticResource PadNone}" />
                </Style>
            </Pivot.Resources>
            <PivotItem x:Uid="Main_PivotHosts">
                <main:HostsPivot x:Name="HostsPane" />
            </PivotItem>
            <PivotItem x:Uid="Main_PivotSessions">
                <main:SessionsPivot x:Name="SessionsPivotCtl" />
            </PivotItem>
            <!-- F06：隧道 Pivot，绑定 TunnelsPivot 控件 -->
            <PivotItem x:Uid="Main_PivotTunnels">
                <main:TunnelsPivot x:Name="TunnelsPivotCtl" />
            </PivotItem>
        </Pivot>

        <!-- U12：宽屏主从（02-UI-DESIGN.md §3、§5.7）。左主机列表（可折叠 Inline）+ 右 TerminalWorkspace。
             窄屏回退上面的 Pivot 单页导航；窗格树由 WorkspaceViewModel 持有，不随显隐销毁。
             V02：栏内标题移除（AppPageHeader 统一承担），只留 PaneToggle。 -->
        <!-- ui/fix-pass：x:DeferLoadStrategy="Lazy"——手机竖/横屏（&lt;720）永远用不到主从布局，
             不再在启动时构建第二份 HostsPivot + TerminalWorkspace；WideState 的 Setter 首次命中时
             由框架实例化，code-behind 在 LayoutStates.CurrentStateChanged 里补 Attach（RealizeWide）。 -->
        <Grid x:Name="WideGrid" Grid.Row="2" Visibility="Collapsed" x:DeferLoadStrategy="Lazy">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Background="{ThemeResource AppSurfaceBrush}"
                  Height="{StaticResource TerminalInfoBarHeight}">
                <!-- V01a：☰ 换 MDL2 GlobalNavigationButton（IconGlobalNav），补无障碍名（resw）。 -->
                <Button x:Name="PaneToggleButton" x:Uid="Main_PaneToggleButton" Click="OnPaneToggleClick"
                        MinWidth="{StaticResource TouchTargetMin}"
                        Height="{StaticResource TerminalInfoBarHeight}"
                        Padding="{StaticResource PadNone}"
                        BorderThickness="{StaticResource BorderNone}"
                        Background="{ThemeResource AppSurfaceBrush}"
                        Foreground="{ThemeResource AppTextBrush}">
                    <FontIcon Glyph="{StaticResource IconGlobalNav}" FontSize="{StaticResource FontBody}" />
                </Button>
            </Grid>
            <SplitView x:Name="WideSplit" Grid.Row="1"
                       PanePlacement="Left" DisplayMode="Inline"
                       OpenPaneLength="{StaticResource MasterPaneWidth}"
                       IsPaneOpen="True">
                <SplitView.Pane>
                    <main:HostsPivot x:Name="HostsPaneWide" />
                </SplitView.Pane>
                <SplitView.Content>
                    <controls:TerminalWorkspace x:Name="Workspace" />
                </SplitView.Content>
            </SplitView>
        </Grid>

        <!-- H-3：底栏换成自研 BottomActionBar（与全站统一）。PrimaryText 走 x:Uid 映射。 -->
        <controls:BottomActionBar x:Name="BottomBar" x:Uid="Main_BottomBar" Grid.Row="3"
                                  ShowOverflow="True"
                                  PrimaryClick="OnNewClick">
            <controls:BottomActionBar.OverflowFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="Main_QuickConnectItem" Click="OnQuickConnectClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Main_ToolsItem" Click="OnToolsClick" />
                    <MenuFlyoutItem x:Uid="Main_AboutItem" Click="OnAboutClick" />
                    <MenuFlyoutItem x:Name="SignInItem" x:Uid="Main_SignInItem" Click="OnSignInClick" />
                    <MenuFlyoutItem x:Name="DevToolsItem" x:Uid="Main_DevToolsItem" Click="OnDevToolsClick" Visibility="Collapsed" />
                </MenuFlyout>
            </controls:BottomActionBar.OverflowFlyout>
        </controls:BottomActionBar>

        <VisualStateManager.VisualStateGroups>
            <!-- U12：默认即窄屏单页；窗宽 ≥720（WideBreakpoint）时切主从。 -->
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainPivot.Visibility" Value="Collapsed" />
                        <Setter Target="WideGrid.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
