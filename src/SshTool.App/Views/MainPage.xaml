<Page
    x:Class="SshTool.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    xmlns:main="using:SshTool.App.Views.Main"
    Background="{ThemeResource AppBgBrush}">

    <!-- 02-UI-DESIGN.md §5.1：Pivot 主机/会话/隧道 + 底部 CommandBar。
         OverflowButtonVisibility 需 16299，15063 上会 XamlParseException，省略即可（有 SecondaryCommands 时系统会显示 …）。 -->
    <Page.BottomAppBar>
        <CommandBar Background="{ThemeResource AppSurfaceBrush}">
            <AppBarButton x:Name="NewButton" Label="新建" Click="OnNewClick">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{StaticResource IconAdd}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="SearchButton" Label="搜索" Click="OnSearchClick">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{StaticResource IconSearch}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="SyncButton" Label="同步" Click="OnSyncClick">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{StaticResource IconSync}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="设置" Click="OnSettingsClick" />
                <AppBarButton Label="密钥" Click="OnKeysClick" />
                <AppBarButton Label="已知主机" Click="OnKnownHostsClick" />
                <AppBarButton Label="片段" Click="OnSnippetsClick" />
                <AppBarButton Label="外观" Click="OnAppearanceClick" />
                <AppBarButton Label="关于" Click="OnAboutClick" />
                <AppBarButton Label="登录" Click="OnSignInClick" />
                <AppBarButton x:Name="DebugConnectItem" Label="N10 调试连接" Click="OnDebugConnectClick" Visibility="Collapsed" />
                <AppBarButton x:Name="DebugVaultItem" Label="S05 保险库自检" Click="OnDebugVaultClick" Visibility="Collapsed" />
                <AppBarButton x:Name="DebugSpikeItem" Label="SP01 JSON Spike" Click="OnSpikeClick" Visibility="Collapsed" />
                <AppBarButton x:Name="DebugTokenItem" Label="X03 Token 画廊" Click="OnTokenGalleryClick" Visibility="Collapsed" />
                <AppBarButton x:Name="DebugRenderItem" Label="SP04 渲染压测" Click="OnRenderSpikeClick" Visibility="Collapsed" />
                <AppBarButton x:Name="DebugInputItem" Label="SP05 输入采集" Click="OnInputSpikeClick" Visibility="Collapsed" />
                <AppBarButton x:Name="DebugPlatformItem" Label="SP06 平台 Spike" Click="OnPlatformSpikeClick" Visibility="Collapsed" />
                <AppBarButton x:Name="DebugBuildItem" Label="构建信息" Click="OnBuildInfoClick" Visibility="Collapsed" />
                <AppBarButton x:Name="DebugGenerateHostsItem" Label="生成 100 台测试主机" Click="OnGenerateHostsClick" Visibility="Collapsed" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:Banner x:Name="LoadWarningBanner" Visibility="Collapsed" />

        <Pivot x:Name="MainPivot" Grid.Row="1" Title="LUMIA SSH">
            <PivotItem Header="主机">
                <main:HostsPivot x:Name="HostsPane" />
            </PivotItem>
            <PivotItem Header="会话">
                <main:SessionsPivot x:Name="SessionsPivotCtl" />
            </PivotItem>
            <PivotItem Header="隧道">
                <controls:EmptyState
                    Glyph="{StaticResource IconTunnel}"
                    Title="没有隧道"
                    Description="隧道将在后续里程碑提供。" />
            </PivotItem>
        </Pivot>

        <!-- U12：宽屏主从（02-UI-DESIGN.md §3、§5.7）。左主机列表（可折叠 Inline）+ 右 TerminalWorkspace。
             窄屏回退上面的 Pivot 单页导航；窗格树由 WorkspaceViewModel 持有，不随显隐销毁。 -->
        <Grid x:Name="WideGrid" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Background="{ThemeResource AppSurfaceBrush}"
                  Height="{StaticResource TerminalInfoBarHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PaneToggleButton" Content="☰" Click="OnPaneToggleClick"
                        MinWidth="{StaticResource TouchTargetMin}"
                        Height="{StaticResource TerminalInfoBarHeight}"
                        Padding="{StaticResource PadNone}"
                        BorderThickness="{StaticResource BorderNone}"
                        Background="{ThemeResource AppSurfaceBrush}"
                        Foreground="{ThemeResource AppTextBrush}" />
                <TextBlock Grid.Column="1" Text="LUMIA SSH"
                           Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource PagePadding}" />
            </Grid>
            <SplitView x:Name="WideSplit" Grid.Row="1"
                       PanePlacement="Left" DisplayMode="Inline"
                       OpenPaneLength="{StaticResource MasterPaneWidth}"
                       IsPaneOpen="True">
                <SplitView.Pane>
                    <main:HostsPivot x:Name="HostsPaneWide" />
                </SplitView.Pane>
                <SplitView.Content>
                    <controls:TerminalWorkspace x:Name="Workspace" />
                </SplitView.Content>
            </SplitView>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <!-- U12：默认即窄屏单页；窗宽 ≥720（WideBreakpoint）时切主从。 -->
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainPivot.Visibility" Value="Collapsed" />
                        <Setter Target="WideGrid.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
