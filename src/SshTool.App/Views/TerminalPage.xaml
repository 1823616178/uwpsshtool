<Page
    x:Class="SshTool.App.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    xmlns:term="using:SshTool.App.Terminal"
    Background="{ThemeResource AppBgBrush}">

    <SplitView x:Name="SessionsSplit" PanePlacement="Left" DisplayMode="Overlay"
               OpenPaneLength="{StaticResource SessionsPaneWidth}" IsPaneOpen="False">
        <SplitView.Pane>
            <controls:SessionsPane x:Name="SessionsPane" />
        </SplitView.Pane>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- P02：省电模式 Banner（EnergySaverStatus == On 时显示，见 xaml.cs）。
             正文案从 Resources.resw 取（中英），此处只摆位，不写字面量。 -->
        <controls:Banner x:Name="EnergySaverBanner" Visibility="Collapsed" />

        <Grid x:Name="InfoBar" Grid.Row="1" Background="{ThemeResource AppSurfaceBrush}"
              Height="{StaticResource TerminalInfoBarHeight}" Tapped="OnInfoTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:StatusDot x:Name="Dot" VerticalAlignment="Center"
                                Margin="{StaticResource PagePadding}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource BodyTextStyle}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="AddressText" Style="{StaticResource CaptionTextStyle}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- UI 走查：⋯ 文本换 IconMore 字形并补无障碍名；无样式按钮保留手写 MinWidth，
                 高度受 TerminalInfoBarHeight=32 行约束不强求 40。 -->
            <Button Grid.Column="2" Click="OnMenuClick"
                    MinWidth="{StaticResource TouchTargetMin}"
                    AutomationProperties.Name="更多">
                <FontIcon Glyph="{StaticResource IconMore}" />
            </Button>
        </Grid>

        <term:TerminalView x:Name="Term" Grid.Row="2" />
        <controls:KeyBar x:Name="Keys" Grid.Row="3" />
        <controls:SessionOverlay x:Name="Overlay" Grid.RowSpan="4" />

        <!-- U12：窄屏回退单窗格（本页即单窗格）；宽屏（Continuum/鼠标）键条默认隐藏，可从菜单手动打开。 -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Keys.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
    </SplitView>
</Page>
