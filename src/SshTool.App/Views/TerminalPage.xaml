<Page
    x:Class="SshTool.App.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    xmlns:term="using:SshTool.App.Terminal"
    Background="{ThemeResource AppBgBrush}">

    <Page.Resources>
        <Storyboard x:Key="FindBarEnter">
            <DoubleAnimation Storyboard.TargetName="FindBar" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="FindBarShift" Storyboard.TargetProperty="Y"
                             From="-16" To="0" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <SplitView x:Name="SessionsSplit" PanePlacement="Left" DisplayMode="Overlay"
               OpenPaneLength="{StaticResource SessionsPaneWidth}" IsPaneOpen="False">
        <SplitView.Pane>
            <controls:SessionsPane x:Name="SessionsPane" />
        </SplitView.Pane>

    <!-- ui/fix-pass：状态组从内层 Grid 挪到页面根（SplitView）上——VisualStateManager.GoToState(this, …)
         只在 Page 的根元素上找状态组，放在内层 Grid 时信息条 Normal/Expanded 切换不会生效。
         U12：窄屏回退单窗格（本页即单窗格）；宽屏键条默认隐藏由 TerminalChromePolicy 决定。 -->
    <VisualStateManager.VisualStateGroups>
        <!-- V03a（05 §6.2）：信息条 Normal/Expanded 切换（单行紧凑 / 双行详情）。 -->
        <VisualStateGroup x:Name="InfoStates">
            <VisualState x:Name="Normal">
                <VisualState.Setters>
                    <Setter Target="InfoBar.MinHeight" Value="{StaticResource TerminalGlassBarHeight}" />
                    <Setter Target="AddressRow.Height" Value="0" />
                    <Setter Target="AddressText.(Grid.Row)" Value="0" />
                    <Setter Target="AddressText.(Grid.Column)" Value="1" />
                    <Setter Target="AddressText.(Grid.ColumnSpan)" Value="1" />
                    <Setter Target="AddressText.HorizontalAlignment" Value="Right" />
                    <Setter Target="AddressText.MaxWidth" Value="{StaticResource TerminalAddressMaxWidth}" />
                    <Setter Target="AddressText.Margin" Value="{StaticResource GapSmLeft}" />
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Expanded">
                <VisualState.Setters>
                    <Setter Target="InfoBar.MinHeight" Value="{StaticResource TerminalExpandedBarHeight}" />
                    <Setter Target="AddressRow.Height" Value="Auto" />
                    <Setter Target="AddressText.(Grid.Row)" Value="1" />
                    <Setter Target="AddressText.(Grid.Column)" Value="0" />
                    <Setter Target="AddressText.(Grid.ColumnSpan)" Value="2" />
                    <Setter Target="AddressText.HorizontalAlignment" Value="Left" />
                    <Setter Target="AddressText.MaxWidth" Value="{StaticResource TerminalAddressExpandedMaxWidth}" />
                    <Setter Target="AddressText.Margin" Value="{StaticResource GapXsTop}" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
        <!-- opt/full-pass 竖屏重设计：高窗口（≥TallBreakpoint，竖屏手机）打开键条第二行。
             W10M 弹出 SIP 不改变窗口高度（InputPane 遮挡 + UpdateKeyBarLift 抬升），
             所以 SIP 开合不会让第二行闪烁；横屏手机（高 &lt;560）保持单行。 -->
        <VisualStateGroup x:Name="HeightStates">
            <VisualState x:Name="ShortState" />
            <VisualState x:Name="TallState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowHeight="{StaticResource TallBreakpoint}" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="Keys.ShowExtraRow" Value="True" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
        <VisualStateGroup>
            <VisualState x:Name="WideState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <!-- ui/fix-pass：键条显隐不再由这里的 Setter 决定（Setter 优先级高于本地值，
                         宽屏下菜单「显示键条」会失效）——统一走 Core TerminalChromePolicy。 -->
                    <!-- V03a（05 §6.2）：横屏隐藏次要地址。 -->
                    <Setter Target="AddressText.Visibility" Value="Collapsed" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- P02：省电模式 Banner（EnergySaverStatus == On 时显示，见 xaml.cs）。
             正文案从 Resources.resw 取（中英），此处只摆位，不写字面量。 -->
        <controls:Banner x:Name="EnergySaverBanner" Visibility="Collapsed" />

        <!-- V03a（05 §6.2）：紧凑信息条。默认单行（TerminalCompactBarHeight=44 epx），
             点击展开为双行（TerminalExpandedBarHeight=64 epx）；横屏（WideState）隐藏次要地址。
             中列用 2 行 Grid 容纳同行（Normal）与换行（Expanded）两种布局。 -->
        <!-- opt/full-pass 竖屏重设计：信息条改「玻璃条」（半透明底 + 底部发丝线，GlassBarGridStyle），
             单行高度收为 TerminalGlassBarHeight（40，仍满足 TouchTargetMin）；图标按钮透明底。 -->
        <!-- ui/fix-pass：固定 Height=40 + 底部 1 epx 发丝线会把 40 epx 的按钮压掉 1 px，系统文字放大时标题也被裁；
             改为 MinHeight（内容撑开），横屏窗高 &lt; TerminalCompactHeightBreakpoint 时整条收起（TerminalChromePolicy）。 -->
        <Grid x:Name="InfoBar" Grid.Row="1" Style="{StaticResource GlassBarGridStyle}"
              AllowFocusOnInteraction="False"
              MinHeight="{StaticResource TerminalGlassBarHeight}" Tapped="OnInfoTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:StatusDot x:Name="Dot" VerticalAlignment="Center"
                                Margin="{StaticResource PagePadding}" />
            <!-- 竖屏单行：主机名与地址分列，地址限宽，避免叠在名字上。 -->
            <Grid Grid.Column="1" VerticalAlignment="Center"
                  Margin="{StaticResource GapSmRight}"
                  AllowFocusOnInteraction="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="AddressRow" Height="0" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TitleText" Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource SubtitleTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <!-- Normal：右列地址；Expanded：换到第二行占满。 -->
                <TextBlock x:Name="AddressText" Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{ThemeResource AppTextDimBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           MaxWidth="{StaticResource TerminalAddressMaxWidth}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource GapSmLeft}" />
            </Grid>
            <!-- C-03：终端区图标按钮统一焦点行为（AllowFocusOnInteraction=False；opt/full-pass 起
                 用 TerminalGlassButtonStyle——同样不抢焦点，透明底配玻璃条）
                 与触控宽；无障碍名经 x:Uid 走 resw。 -->
            <Button x:Uid="Terminal_MoreButton" Grid.Column="2" Click="OnMenuClick"
                    Style="{StaticResource TerminalGlassButtonStyle}">
                <FontIcon Glyph="{StaticResource IconMore}" />
            </Button>
        </Grid>

        <!-- W02（01-DESIGN §16.2）：回滚查找条，打开时替换信息条所在行。 -->
        <!-- ui/fix-pass：进场改为显式 Storyboard（FindBarEnter：Opacity + TranslateY，均为独立动画，
             走合成线程，低端 ARM 不卡 UI 线程）；ChildrenTransitions 在 Visibility 切换时不会重放。 -->
        <Grid x:Name="FindBar" Grid.Row="1" Style="{StaticResource GlassBarGridStyle}"
              MinHeight="{StaticResource TerminalGlassBarHeight}" Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="FindBarShift" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FindBox" x:Uid="Terminal_FindBox" VerticalAlignment="Center"
                     Margin="{StaticResource PagePadding}" IsSpellCheckEnabled="False"
                     IsTextPredictionEnabled="False" InputScope="Default"
                     TextChanged="OnFindTextChanged" KeyDown="OnFindKeyDown" />
            <TextBlock x:Name="FindCount" Grid.Column="1" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}" />
            <Button x:Uid="Terminal_FindPrev" Grid.Column="2" Click="OnFindPrevClick"
                    Style="{StaticResource TerminalGlassButtonStyle}">
                <FontIcon Glyph="{StaticResource IconChevronUp}" />
            </Button>
            <Button x:Uid="Terminal_FindNext" Grid.Column="3" Click="OnFindNextClick"
                    Style="{StaticResource TerminalGlassButtonStyle}">
                <FontIcon Glyph="{StaticResource IconChevronDown}" />
            </Button>
            <Button x:Uid="Terminal_FindClose" Grid.Column="4" Click="OnFindCloseClick"
                    Style="{StaticResource TerminalGlassButtonStyle}">
                <FontIcon Glyph="{StaticResource IconClose}" />
            </Button>
        </Grid>

        <term:TerminalView x:Name="Term" Grid.Row="2" />
        <!-- ui/fix-pass：横屏收起信息条后，菜单入口浮在终端右上角（玻璃底，触控 40 epx）。 -->
        <Button x:Name="CompactMenuButton" x:Uid="Terminal_MoreButton" Grid.Row="2"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="{ThemeResource AppGlassBrush}"
                Visibility="Collapsed" Click="OnMenuClick"
                Style="{StaticResource TerminalGlassButtonStyle}">
            <FontIcon Glyph="{StaticResource IconMore}" />
        </Button>
        <controls:KeyBar x:Name="Keys" Grid.Row="3" />
        <controls:SessionOverlay x:Name="Overlay" Grid.RowSpan="4" />

    </Grid>
    </SplitView>
</Page>
