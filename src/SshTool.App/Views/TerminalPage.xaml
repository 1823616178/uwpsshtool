<Page
    x:Class="SshTool.App.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    xmlns:term="using:SshTool.App.Terminal"
    Background="{ThemeResource AppBgBrush}">

    <SplitView x:Name="SessionsSplit" PanePlacement="Left" DisplayMode="Overlay"
               OpenPaneLength="{StaticResource SessionsPaneWidth}" IsPaneOpen="False">
        <SplitView.Pane>
            <controls:SessionsPane x:Name="SessionsPane" />
        </SplitView.Pane>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="InfoBar" Background="{ThemeResource AppSurfaceBrush}"
              Height="{StaticResource TerminalInfoBarHeight}" Tapped="OnInfoTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:StatusDot x:Name="Dot" VerticalAlignment="Center"
                                Margin="{StaticResource PagePadding}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource BodyTextStyle}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="AddressText" Style="{StaticResource CaptionTextStyle}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Content="⋯" Click="OnMenuClick" />
        </Grid>

        <term:TerminalView x:Name="Term" Grid.Row="1" />
        <controls:KeyBar x:Name="Keys" Grid.Row="2" />
        <controls:SessionOverlay x:Name="Overlay" Grid.RowSpan="3" />
    </Grid>
    </SplitView>
</Page>
