<Page
    x:Class="SshTool.App.Views.SnippetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- V04b（§6.4 + C-06）：命令片段管理。行 ▶ 发送改 TerminalIconButtonStyle + resw 标签；
         分组行用 GroupHeader；新建走 BottomActionBar；全量文案走 resw 双语。 -->
    <Page.Resources>
        <CollectionViewSource x:Key="GroupedSnippets" x:Name="GroupedSnippets"
                              IsSourceGrouped="True" ItemsPath="Rows" />
        <DataTemplate x:Key="SnippetItemTemplate">
            <Grid Padding="{StaticResource PagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Text="{Binding Preview}" Style="{StaticResource CaptionTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Uid="Snippets_SendButton" Grid.Column="1" Click="OnSendClick"
                        IsEnabled="{Binding SendEnabled}"
                        MinWidth="{StaticResource TouchTargetMin}"
                        MinHeight="{StaticResource TouchTargetMin}"
                        Margin="{StaticResource GapSmLeft}"
                        Background="{ThemeResource AppSurfaceAltBrush}">
                    <FontIcon Glyph="{StaticResource IconForward}" FontSize="{StaticResource FontBody}" />
                </Button>
            </Grid>
        </DataTemplate>
        <!-- V04b：分组行标题。GroupHeader 组件绑定 HostListGroup，片段分组仍为 SnippetGroupVm，
             保留分组标题文本样式（Caption + PagePadding），后续若通用化 GroupHeader 再切回。 -->
        <DataTemplate x:Key="SnippetGroupHeaderTemplate">
            <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionTextStyle}"
                       Padding="{StaticResource PagePadding}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Snippets_Title" Style="{StaticResource PageTitleTextStyle}"
                   Margin="{StaticResource PagePadding}" />
        <AutoSuggestBox x:Name="SearchBox" x:Uid="Snippets_SearchBox" Grid.Row="1"
                        QueryIcon="Find" TextChanged="OnSearchChanged"
                        Margin="{StaticResource PagePadding}" />
        <Grid Grid.Row="2">
            <controls:EmptyState x:Name="Empty"
                                 Glyph="{StaticResource IconSnippet}"
                                 Visibility="Collapsed" />
            <controls:EmptyState x:Name="NoMatches"
                                 Glyph="{StaticResource IconSearch}"
                                 Visibility="Collapsed" />
            <ListView x:Name="SnippetList"
                      ItemTemplate="{StaticResource SnippetItemTemplate}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick">
                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="False" HeaderTemplate="{StaticResource SnippetGroupHeaderTemplate}" />
                </ListView.GroupStyle>
            </ListView>
        </Grid>
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="3"
                                  PrimaryText="{StaticResource Snippets_New}"
                                  PrimaryClick="OnNewClick" />
    </Grid>
</Page>
