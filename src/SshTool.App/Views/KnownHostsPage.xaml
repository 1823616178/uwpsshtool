<Page
    x:Class="SshTool.App.Views.KnownHostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Uid="KnownHosts_Header"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />
        <AutoSuggestBox x:Uid="KnownHostsPage_SearchBox" x:Name="SearchBox" Grid.Row="1"
                        QueryIcon="Find" TextChanged="OnSearchChanged"
                        Margin="{StaticResource PagePadding}" />
        <Grid Grid.Row="2">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <controls:EmptyState x:Name="Empty"
                                 Glyph="{StaticResource IconLock}"
                                 Visibility="Collapsed" />
            <controls:EmptyState x:Name="NoMatches"
                                 Kind="Filtered"
                                 Visibility="Collapsed" />
            <controls:EmptyState x:Name="ErrorState"
                                 Kind="Offline"
                                 Visibility="Collapsed" />
            <ListView x:Name="HostList" SelectionMode="Single"
                      ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                      SelectionChanged="OnSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- W06：统一 V2 列表行。 -->
                        <controls:AppListRow Title="{Binding Title}" Subtitle="{Binding Subtitle}"
                                             IconGlyph="{StaticResource IconLock}" IsCompact="True" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <StackPanel x:Name="Detail" Grid.Row="3" Padding="{StaticResource PagePadding}"
                    Background="{ThemeResource AppSurfaceBrush}" Visibility="Collapsed">
            <controls:MonoText x:Name="FingerprintText" Compact="True" />
            <controls:RandomArtView x:Name="ArtView" Margin="{StaticResource GapSmTop}" />
            <Button x:Uid="KnownHostsPage_Button1" Click="OnDeleteClick" Margin="{StaticResource GapSmTop}"
                    Style="{StaticResource DangerButtonStyle}"
                    MinHeight="{StaticResource TouchTargetMin}" />
        </StackPanel>
    </Grid>
</Page>
