<Page
    x:Class="SshTool.App.Views.Sync.VaultSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SshTool.App.Infrastructure"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U16 建库页（02-UI-DESIGN.md §5.13 VaultSetupPage）：说明 + 同步密码 ×2（≥8 位提示）
         + [创建] → 进度「正在生成密钥（约数秒）」→ RecoveryKeyDialog（必须勾选已保存）
         → 自动首次同步。解锁后的密钥由 VaultCache（DPAPI）持久化，故无「记住同步密码」。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Uid="VaultSetup_Title"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />
        <ScrollViewer infra:InputPaneScroll.IsEnabled="True" Grid.Row="1">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <controls:FormSection x:Uid="VaultSetup_Section_Setup">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <TextBlock x:Uid="VaultSetup_Explanation"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap" />
                            <PasswordBox x:Name="SyncPasswordBox" x:Uid="VaultSetup_PasswordBox"
                                         Margin="{StaticResource GapSmTop}"
                                         PasswordChanged="OnPasswordChanged" />
                            <TextBlock x:Uid="VaultSetup_PasswordHint"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="{StaticResource GapXsTop}" />
                            <PasswordBox x:Name="ConfirmBox" x:Uid="VaultSetup_ConfirmBox"
                                         Margin="{StaticResource GapSmTop}"
                                         PasswordChanged="OnConfirmChanged" />
                            <TextBlock x:Uid="VaultSetup_LocalNote"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource GapSmTop}" />
                            <TextBlock x:Name="ErrorText"
                                       Foreground="{ThemeResource AppDangerBrush}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource GapSmTop}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="2"
                                  PrimaryClick="OnSubmitClick" />
        <controls:LoadingOverlay x:Name="Working" Grid.RowSpan="3" />
    </Grid>
</Page>
