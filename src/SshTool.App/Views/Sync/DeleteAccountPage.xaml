<Page
    x:Class="SshTool.App.Views.Sync.DeleteAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U20 注销账号页（02-UI-DESIGN.md §5.13）：登录密码 + 输入 DELETE 确认 → 注销。 -->
    <Grid>
        <ScrollViewer>
            <StackPanel Padding="{StaticResource PagePadding}">
                <controls:AppPageHeader x:Name="Header" x:Uid="DeleteAccount_Header"
                                        Title="注销账号"
                                        ShowBackButton="True"
                                        BackRequested="OnBackRequested" />

                <Border Background="{ThemeResource AppDangerBrush}"
                        Opacity="0.15"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="{StaticResource PadMd}"
                        Margin="{StaticResource GapSmTop}">
                    <TextBlock x:Uid="DeleteAccount_Warning"
                               Text="此操作将永久删除你的账号与云端保险库，且不可恢复。"
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Uid="DeleteAccount_PasswordLabel" Text="登录密码"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapMdTop}" />
                <PasswordBox x:Name="PasswordBox" x:Uid="DeleteAccount_PasswordBox"
                             PlaceholderText="请输入登录密码"
                             Margin="{StaticResource GapSmTop}"
                             PasswordChanged="OnPasswordChanged" />

                <TextBlock x:Uid="DeleteAccount_ConfirmLabel" Text="输入 DELETE 以确认"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapMdTop}" />
                <TextBox x:Name="ConfirmBox" x:Uid="DeleteAccount_ConfirmBox"
                         Margin="{StaticResource GapSmTop}"
                         TextChanged="OnConfirmChanged" />

                <TextBlock x:Name="ErrorText"
                           Foreground="{ThemeResource AppDangerBrush}"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapSmTop}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Button x:Name="SubmitButton" x:Uid="DeleteAccount_Submit"
                        Content="注销账号"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="{StaticResource GapMdTop}"
                        HorizontalAlignment="Stretch"
                        Click="OnSubmitClick" />
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="BusyOverlay"
              Background="{ThemeResource AppBgBrush}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing Width="{StaticResource SpaceXl}" Height="{StaticResource SpaceXl}"
                              IsActive="True" />
                <TextBlock Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapSmTop}"
                           TextAlignment="Center"
                           Text="正在注销账号…" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
