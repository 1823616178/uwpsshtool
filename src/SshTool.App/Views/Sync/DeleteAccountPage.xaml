<Page
    x:Class="SshTool.App.Views.Sync.DeleteAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SshTool.App.Infrastructure"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U20 注销账号页（02-UI-DESIGN.md §5.13）：登录密码 + 输入 DELETE 确认 → 注销。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Name="Header" x:Uid="DeleteAccount_Header"
                                ShowBackButton="True"
                                BackRequested="OnBackRequested" />

        <!-- fix/auth-audit：错误条在页头下方（始终可见）。此前错误文本在表单底部，
             软键盘弹出时被挡住，提交失败看起来像没反应。 -->
        <Border x:Name="ErrorPanel" Grid.Row="1"
                Background="{ThemeResource AppSurfaceAltBrush}"
                BorderBrush="{ThemeResource AppDangerBrush}"
                BorderThickness="{StaticResource BorderThinBottom}"
                Padding="{StaticResource PadInlineError}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{StaticResource IconError}"
                          FontSize="{StaticResource FontSubtitle}"
                          Foreground="{ThemeResource AppDangerBrush}"
                          VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorText" Grid.Column="1"
                           Foreground="{ThemeResource AppDangerBrush}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           AutomationProperties.LiveSetting="Assertive"
                           Margin="{StaticResource GapSmLeft}" />
            </Grid>
        </Border>

        <ScrollViewer infra:InputPaneScroll.IsEnabled="True" Grid.Row="2">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <Border Background="{ThemeResource AppDangerSoftBrush}"
                        BorderBrush="{ThemeResource AppDangerBrush}"
                        BorderThickness="{StaticResource BorderThin}"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="{StaticResource PadMd}"
                        Margin="{StaticResource GapSmTop}">
                    <TextBlock x:Uid="DeleteAccount_Warning"
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                </Border>

                <controls:FormSection x:Uid="DeleteAccount_Section_Confirm" Margin="{StaticResource GapMdTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <TextBlock x:Uid="DeleteAccount_PasswordLabel"
                                       Style="{StaticResource BodyTextStyle}" />
                            <PasswordBox x:Name="PasswordBox" x:Uid="DeleteAccount_PasswordBox"
                                         Margin="{StaticResource GapSmTop}"
                                         PasswordChanged="OnPasswordChanged"
                                         KeyDown="OnPasswordKeyDown" />

                            <TextBlock x:Uid="DeleteAccount_ConfirmLabel"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="{StaticResource GapMdTop}" />
                            <TextBox x:Name="ConfirmBox" x:Uid="DeleteAccount_ConfirmBox"
                                     Margin="{StaticResource GapSmTop}"
                                     IsSpellCheckEnabled="False"
                                     IsTextPredictionEnabled="False"
                                     TextChanged="OnConfirmChanged"
                                     KeyDown="OnConfirmKeyDown" />

                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定操作条：主操作（注销账号） -->
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="3"
                                  PrimaryButtonStyle="{StaticResource DangerButtonStyle}"
                                  PrimaryClick="OnSubmitClick" />

        <Grid x:Name="BusyOverlay"
              Grid.RowSpan="4"
              Background="{ThemeResource AppBgBrush}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing Width="{StaticResource SpaceXl}" Height="{StaticResource SpaceXl}"
                              IsActive="True" />
                <TextBlock x:Uid="DeleteAccountPage_TextBlock1" Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapSmTop}"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
