<Page
    x:Class="SshTool.App.Views.Sync.DeleteAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U20 注销账号页（02-UI-DESIGN.md §5.13）：登录密码 + 输入 DELETE 确认 → 注销。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Name="Header" x:Uid="DeleteAccount_Header"
                                ShowBackButton="True"
                                BackRequested="OnBackRequested" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <Border Background="{ThemeResource AppDangerSoftBrush}"
                        BorderBrush="{ThemeResource AppDangerBrush}"
                        BorderThickness="{StaticResource BorderThin}"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="{StaticResource PadMd}"
                        Margin="{StaticResource GapSmTop}">
                    <TextBlock x:Uid="DeleteAccount_Warning"
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                </Border>

                <controls:FormSection x:Uid="DeleteAccount_Section_Confirm" Margin="{StaticResource GapMdTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <TextBlock x:Uid="DeleteAccount_PasswordLabel"
                                       Style="{StaticResource BodyTextStyle}" />
                            <PasswordBox x:Name="PasswordBox" x:Uid="DeleteAccount_PasswordBox"
                                         Margin="{StaticResource GapSmTop}"
                                         PasswordChanged="OnPasswordChanged" />

                            <TextBlock x:Uid="DeleteAccount_ConfirmLabel"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="{StaticResource GapMdTop}" />
                            <TextBox x:Name="ConfirmBox" x:Uid="DeleteAccount_ConfirmBox"
                                     Margin="{StaticResource GapSmTop}"
                                     TextChanged="OnConfirmChanged" />

                            <TextBlock x:Name="ErrorText"
                                       Foreground="{ThemeResource AppDangerBrush}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="{StaticResource GapSmTop}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定操作条：主操作（注销账号） -->
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="2"
                                  PrimaryButtonStyle="{StaticResource DangerButtonStyle}"
                                  PrimaryClick="OnSubmitClick" />

        <Grid x:Name="BusyOverlay"
              Grid.RowSpan="3"
              Background="{ThemeResource AppBgBrush}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing Width="{StaticResource SpaceXl}" Height="{StaticResource SpaceXl}"
                              IsActive="True" />
                <TextBlock x:Uid="DeleteAccountPage_TextBlock1" Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapSmTop}"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
