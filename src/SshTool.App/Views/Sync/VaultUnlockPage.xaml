<Page
    x:Class="SshTool.App.Views.Sync.VaultUnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SshTool.App.Infrastructure"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U16 解锁页（02-UI-DESIGN.md §5.13 VaultUnlockPage）：分段「同步密码 / 恢复密钥」；
         恢复密钥等宽输入，规范化去空白 + 前缀/校验段大写，格式通过才可提交；
         [解锁] → 进度「正在解锁…」→ 成功回状态页并同步。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Uid="VaultUnlock_Title"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />
        <ScrollViewer infra:InputPaneScroll.IsEnabled="True" Grid.Row="1">
            <StackPanel Padding="{StaticResource CardListPadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!-- feat/remember-vault：本机记住的密钥失效（其他设备改了同步密码 / 保险库重建）时说明原因。 -->
                <TextBlock x:Name="NoticeText"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{ThemeResource AppWarningBrush}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource GapSmTop}"
                           Visibility="Collapsed" />
                <!-- opt/full-pass：分段切换换 SegmentTabs；两个旧按钮保留为隐藏载体（IsEnabled 语义不变）。 -->
                <controls:SegmentTabs x:Name="ModeTabs"
                                      Margin="{StaticResource GapSmTop}"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnModeTabsSelectionChanged" />
                <!-- 兼容旧路径的两个按钮收进零尺寸容器（Click 处理器与 IsEnabled 语义保留）。 -->
                <Grid Height="0" Visibility="Collapsed">
                    <Button x:Name="PasswordTabButton" x:Uid="VaultUnlock_PasswordTab"
                            Click="OnPasswordTabClick" />
                    <Button x:Name="RecoveryTabButton" x:Uid="VaultUnlock_RecoveryTab"
                            Click="OnRecoveryTabClick" />
                </Grid>
                <!-- opt/full-pass：解锁表单收进卡片。 -->
                <Border Style="{StaticResource CardBorderStyle}">
                <controls:FormSection x:Uid="VaultUnlock_Section_Unlock">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <PasswordBox x:Name="SyncPasswordBox" x:Uid="VaultUnlock_PasswordBox"
                                         PasswordChanged="OnPasswordChanged" />
                            <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed">
                                <TextBox x:Name="RecoveryBox" x:Uid="VaultUnlock_RecoveryBox"
                                         FontFamily="{StaticResource AppMonoFontFamily}"
                                         IsSpellCheckEnabled="False"
                                         TextChanged="OnRecoveryChanged" />
                                <TextBlock x:Uid="VaultUnlock_RecoveryHint"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="{StaticResource GapXsTop}" />
                            </StackPanel>
                            <TextBlock x:Name="ErrorText"
                                       Foreground="{ThemeResource AppDangerBrush}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource GapSmTop}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
                </Border>
                <TextBlock x:Uid="VaultUnlock_Hint"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource GapSmTop}" />
            </StackPanel>
        </ScrollViewer>
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="2"
                                  PrimaryClick="OnSubmitClick" />
        <controls:LoadingOverlay x:Name="Working" Grid.RowSpan="3" />
    </Grid>
</Page>
