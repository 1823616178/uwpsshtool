<Page
    x:Class="SshTool.App.Views.Sync.VaultUnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U16 解锁页（02-UI-DESIGN.md §5.13 VaultUnlockPage）：分段「同步密码 / 恢复密钥」；
         恢复密钥等宽输入，规范化去空白 + 前缀/校验段大写，格式通过才可提交；
         [解锁] → 进度「正在解锁…」→ 成功回状态页并同步。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Uid="VaultUnlock_Title"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <Grid Margin="{StaticResource GapSmTop}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PasswordTabButton" x:Uid="VaultUnlock_PasswordTab" Content="同步密码"
                            HorizontalAlignment="Stretch" Click="OnPasswordTabClick" />
                    <Button x:Name="RecoveryTabButton" x:Uid="VaultUnlock_RecoveryTab" Content="恢复密钥"
                            Grid.Column="1" HorizontalAlignment="Stretch"
                            Margin="{StaticResource GapSmLeft}" Click="OnRecoveryTabClick" />
                </Grid>
                <controls:FormSection x:Uid="VaultUnlock_Section_Unlock" Margin="{StaticResource GapSmTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <PasswordBox x:Name="SyncPasswordBox" x:Uid="VaultUnlock_PasswordBox"
                                         Header="同步密码" PlaceholderText="输入同步密码"
                                         PasswordChanged="OnPasswordChanged" />
                            <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed">
                                <TextBox x:Name="RecoveryBox" x:Uid="VaultUnlock_RecoveryBox"
                                         Header="恢复密钥" PlaceholderText="SPM1-…-XXXXXXXXXXXX"
                                         FontFamily="{StaticResource AppMonoFontFamily}"
                                         IsSpellCheckEnabled="False"
                                         TextChanged="OnRecoveryChanged" />
                                <TextBlock x:Uid="VaultUnlock_RecoveryHint"
                                           Text="可直接粘贴；前缀与校验段大小写随意，将自动规范化"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="{StaticResource GapXsTop}" />
                            </StackPanel>
                            <TextBlock x:Name="ErrorText"
                                       Foreground="{ThemeResource AppDangerBrush}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource GapSmTop}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="2"
                                  PrimaryClick="OnSubmitClick" />
        <controls:LoadingOverlay x:Name="Working" Grid.RowSpan="3" />
    </Grid>
</Page>
