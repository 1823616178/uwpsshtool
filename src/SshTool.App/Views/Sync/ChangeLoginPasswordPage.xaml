<Page
    x:Class="SshTool.App.Views.Sync.ChangeLoginPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SshTool.App.Infrastructure"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U20 修改登录密码页（02-UI-DESIGN.md §5.13）：当前密码 + 新密码 ×2 → 成功后回登录页。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Name="Header" x:Uid="ChangeLogin_Header"
                                ShowBackButton="True"
                                BackRequested="OnBackRequested" />

        <!-- fix/auth-audit：错误条在页头下方（始终可见）。此前错误文本在表单底部，
             软键盘弹出时被挡住，提交失败看起来像没反应。 -->
        <Border x:Name="ErrorPanel" Grid.Row="1"
                Background="{ThemeResource AppSurfaceAltBrush}"
                BorderBrush="{ThemeResource AppDangerBrush}"
                BorderThickness="{StaticResource BorderThinBottom}"
                Padding="{StaticResource PadInlineError}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{StaticResource IconError}"
                          FontSize="{StaticResource FontSubtitle}"
                          Foreground="{ThemeResource AppDangerBrush}"
                          VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorText" Grid.Column="1"
                           Foreground="{ThemeResource AppDangerBrush}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           AutomationProperties.LiveSetting="Assertive"
                           Margin="{StaticResource GapSmLeft}" />
            </Grid>
        </Border>

        <ScrollViewer infra:InputPaneScroll.IsEnabled="True" Grid.Row="2">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <TextBlock x:Name="ExplanationText" Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap" Margin="{StaticResource GapSmTop}" />

                <controls:FormSection x:Uid="ChangeLogin_Section_Password" Margin="{StaticResource GapMdTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <TextBlock x:Uid="ChangeLogin_CurrentLabel"
                                       Style="{StaticResource BodyTextStyle}" />
                            <PasswordBox x:Name="CurrentBox" x:Uid="ChangeLogin_CurrentBox"
                                         Margin="{StaticResource GapSmTop}"
                                         PasswordChanged="OnCurrentChanged"
                                         KeyDown="OnCurrentKeyDown" />

                            <TextBlock x:Uid="ChangeLogin_NewLabel"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="{StaticResource GapMdTop}" />
                            <PasswordBox x:Name="NewBox" x:Uid="ChangeLogin_NewBox"
                                         Margin="{StaticResource GapSmTop}"
                                         PasswordChanged="OnNewChanged"
                                         KeyDown="OnNewKeyDown" />
                            <TextBlock x:Uid="ChangeLogin_NewHint"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="{StaticResource GapXsTop}" />

                            <TextBlock x:Uid="ChangeLogin_ConfirmLabel"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="{StaticResource GapMdTop}" />
                            <PasswordBox x:Name="ConfirmBox" x:Uid="ChangeLogin_ConfirmBox"
                                         Margin="{StaticResource GapSmTop}"
                                         PasswordChanged="OnConfirmChanged"
                                         KeyDown="OnConfirmKeyDown" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定操作条：主操作=修改密码 -->
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="3"
                                  PrimaryClick="OnSubmitClick" />

        <Grid x:Name="BusyOverlay"
              Grid.RowSpan="4"
              Background="{ThemeResource AppBgBrush}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing Width="{StaticResource SpaceXl}" Height="{StaticResource SpaceXl}"
                              IsActive="True" />
                <TextBlock x:Uid="ChangeLoginPasswordPage_BusyText" x:Name="BusyText" Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapSmTop}"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
