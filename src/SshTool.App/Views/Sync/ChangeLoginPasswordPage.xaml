<Page
    x:Class="SshTool.App.Views.Sync.ChangeLoginPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U20 修改登录密码页（02-UI-DESIGN.md §5.13）：当前密码 + 新密码 ×2 → 成功后回登录页。 -->
    <Grid>
        <ScrollViewer>
            <StackPanel Padding="{StaticResource PagePadding}">
                <controls:AppPageHeader x:Name="Header" x:Uid="ChangeLogin_Header"
                                        Title="修改登录密码"
                                        ShowBackButton="True"
                                        BackRequested="OnBackRequested" />

                <TextBlock x:Name="ExplanationText" Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap" Margin="{StaticResource GapSmTop}" />

                <TextBlock x:Uid="ChangeLogin_CurrentLabel" Text="当前密码"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapMdTop}" />
                <PasswordBox x:Name="CurrentBox" x:Uid="ChangeLogin_CurrentBox"
                             PlaceholderText="请输入当前密码"
                             Margin="{StaticResource GapSmTop}"
                             PasswordChanged="OnCurrentChanged" />

                <TextBlock x:Uid="ChangeLogin_NewLabel" Text="新密码"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapMdTop}" />
                <PasswordBox x:Name="NewBox" x:Uid="ChangeLogin_NewBox"
                             PlaceholderText="设置新密码（至少 10 位）"
                             Margin="{StaticResource GapSmTop}"
                             PasswordChanged="OnNewChanged" />
                <TextBlock x:Uid="ChangeLogin_NewHint" Text="新密码至少 10 位"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="{StaticResource GapXsTop}" />

                <TextBlock x:Uid="ChangeLogin_ConfirmLabel" Text="确认新密码"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapMdTop}" />
                <PasswordBox x:Name="ConfirmBox" x:Uid="ChangeLogin_ConfirmBox"
                             PlaceholderText="再次输入新密码"
                             Margin="{StaticResource GapSmTop}"
                             PasswordChanged="OnConfirmChanged" />

                <TextBlock x:Name="ErrorText"
                           Foreground="{ThemeResource AppDangerBrush}"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapSmTop}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Button x:Name="SubmitButton" x:Uid="ChangeLogin_Submit"
                        Content="修改密码"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="{StaticResource GapMdTop}"
                        HorizontalAlignment="Stretch"
                        Click="OnSubmitClick" />
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="BusyOverlay"
              Background="{ThemeResource AppBgBrush}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing Width="{StaticResource SpaceXl}" Height="{StaticResource SpaceXl}"
                              IsActive="True" />
                <TextBlock x:Name="BusyText" Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource GapSmTop}"
                           TextAlignment="Center"
                           Text="正在修改密码…" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
