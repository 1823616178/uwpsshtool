<Page
    x:Class="SshTool.App.Views.Sync.AccountSyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U17/U18 同步状态页（02-UI-DESIGN.md §5.13）：Pivot[状态 | 设备 | 历史]。
         未登录/建库/解锁由页面前置路由（NeedsRouting）经 SyncNavigation 转出；到达本页即已登录。
         状态卡：相位图标 + 文案 + 上次同步相对时间 + 立即同步；开关：启用/自动/同步密码/私钥；
         保险库与账号操作；危险操作（删除云端保险库 / 注销账号）走 ContentDialog 二次确认。
         本页只用 15063 基线控件（Pivot/ToggleSwitch/Button）。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:AppPageHeader x:Name="Header" x:Uid="AccountSync_Header"
                                ShowBackButton="True"
                                BackRequested="OnBackRequested" />

        <!-- fix/auth-audit：错误条放在页头下方、Pivot 之外——设备 / 历史页签上的失败
             （改名、撤销、恢复、清空）此前写进状态页签底部的文本，切到别的页签根本看不到。 -->
        <Border x:Name="ErrorPanel" Grid.Row="1"
                Background="{ThemeResource AppSurfaceAltBrush}"
                BorderBrush="{ThemeResource AppDangerBrush}"
                BorderThickness="{StaticResource BorderThinBottom}"
                Padding="{StaticResource PadInlineError}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{StaticResource IconError}"
                          FontSize="{StaticResource FontSubtitle}"
                          Foreground="{ThemeResource AppDangerBrush}"
                          VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorText" Grid.Column="1"
                           Foreground="{ThemeResource AppDangerBrush}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           AutomationProperties.LiveSetting="Assertive"
                           Margin="{StaticResource GapSmLeft}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Pivot x:Name="MainPivot">
            <!-- 状态 Pivot -->
            <PivotItem x:Name="StatusTab" x:Uid="AccountSync_TabStatus">
                <ScrollViewer>
                    <StackPanel Padding="{StaticResource PagePadding}">
                        <!-- 状态卡 -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="{StaticResource BorderThin}"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="{StaticResource PadMd}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon x:Name="StatusIcon" Margin="{StaticResource GapSmRight}"
                                              VerticalAlignment="Center" />
                                    <controls:StatusPill x:Name="StatusPill"
                                                         VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="AccountLine" Style="{StaticResource BodyTextStyle}"
                                           Margin="{StaticResource GapSmTop}" />
                                <TextBlock x:Name="MetaLine" Style="{StaticResource CaptionTextStyle}"
                                           Margin="{StaticResource GapXsTop}" />
                                <TextBlock x:Name="LastSyncedLine" x:Uid="AccountSync_LastSynced"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="{StaticResource GapXsTop}" />
                                <TextBlock x:Name="NextRetryLine" Style="{StaticResource CaptionTextStyle}"
                                           Margin="{StaticResource GapXsTop}"
                                           Visibility="Collapsed" />
                                <Button x:Name="SyncNowButton" x:Uid="AccountSync_SyncNow"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="{StaticResource GapMdTop}"
                                        HorizontalAlignment="Stretch"
                                        Click="OnSyncNowClick" />
                                <Button x:Name="ResolveConflictButton" x:Uid="AccountSync_ResolveConflict"
                                        Margin="{StaticResource GapSmTop}"
                                        HorizontalAlignment="Stretch"
                                        Click="OnResolveConflictClick"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- 同步设置 -->
                        <controls:FormSection x:Name="SyncSettingsSection"
                                              x:Uid="AccountSync_SyncSettings"
                                              Margin="{StaticResource GapMdTop}">
                            <controls:FormSection.SectionContent>
                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="AccountSync_EnableSync"
                                           Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource BodyTextStyle}"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="EnableSwitch" x:Uid="AccountSync_EnableSwitch" Grid.Row="0" Grid.Column="1"
                                              Toggled="OnEnableSyncToggled" />
                                <TextBlock x:Uid="AccountSync_AutoSync"
                                           Grid.Row="1" Grid.Column="0"
                                           Style="{StaticResource BodyTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource GapSmTop}" />
                                <ToggleSwitch x:Name="AutoSyncSwitch" x:Uid="AccountSync_AutoSyncSwitch" Grid.Row="1" Grid.Column="1"
                                              Margin="{StaticResource GapSmTop}"
                                              Toggled="OnAutoSyncToggled" />
                                <TextBlock x:Uid="AccountSync_SyncPasswords"
                                           Grid.Row="2" Grid.Column="0"
                                           Style="{StaticResource BodyTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource GapSmTop}" />
                                <ToggleSwitch x:Name="SyncPasswordsSwitch" x:Uid="AccountSync_SyncPasswordsSwitch" Grid.Row="2" Grid.Column="1"
                                              Margin="{StaticResource GapSmTop}"
                                              Toggled="OnSyncPasswordsToggled" />
                                <TextBlock x:Uid="AccountSync_SyncPrivateKeys"
                                           Grid.Row="3" Grid.Column="0"
                                           Style="{StaticResource BodyTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource GapSmTop}" />
                                <ToggleSwitch x:Name="SyncPrivateKeysSwitch" x:Uid="AccountSync_SyncPrivateKeysSwitch" Grid.Row="3" Grid.Column="1"
                                              Margin="{StaticResource GapSmTop}"
                                              IsEnabled="False" />

                            </Grid>
                            </controls:FormSection.SectionContent>
                        </controls:FormSection>

                        <!-- 保险库 -->
                        <controls:FormSection x:Name="VaultSection"
                                              x:Uid="AccountSync_Vault"
                                              Margin="{StaticResource GapMdTop}">
                            <controls:FormSection.SectionContent>
                                <StackPanel>
                                    <!-- feat/remember-vault：本机开关（不随账号同步），默认开。 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="AccountSync_RememberVaultKey"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="RememberVaultKeySwitch" x:Uid="AccountSync_RememberVaultKeySwitch"
                                                      Grid.Column="1"
                                                      Toggled="OnRememberVaultKeyToggled" />
                                    </Grid>
                                    <TextBlock x:Uid="AccountSync_RememberVaultKeyNote"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="{StaticResource GapXsTop}" />
                                    <Button x:Name="ChangeSyncPasswordButton" x:Uid="AccountSync_ChangeSyncPassword"
                                            HorizontalAlignment="Stretch"
                                            Margin="{StaticResource GapSmTop}"
                                            Click="OnChangeSyncPasswordClick" />
                                </StackPanel>
                            </controls:FormSection.SectionContent>
                        </controls:FormSection>

                        <!-- 账号 -->
                        <controls:FormSection x:Name="AccountSection"
                                              x:Uid="AccountSync_Account"
                                              Margin="{StaticResource GapMdTop}">
                            <controls:FormSection.SectionContent>
                                <StackPanel>
                                    <Button x:Name="ChangeLoginPasswordButton" x:Uid="AccountSync_ChangeLoginPassword"
                                            HorizontalAlignment="Stretch"
                                            Click="OnChangeLoginPasswordClick" />
                                    <Button x:Name="LogoutButton" x:Uid="AccountSync_Logout"
                                            Margin="{StaticResource GapSmTop}"
                                            HorizontalAlignment="Stretch"
                                            Click="OnLogoutClick" />
                                    <Button x:Name="LogoutAllButton" x:Uid="AccountSync_LogoutAll"
                                            Margin="{StaticResource GapSmTop}"
                                            HorizontalAlignment="Stretch"
                                            Click="OnLogoutAllClick" />
                                </StackPanel>
                            </controls:FormSection.SectionContent>
                        </controls:FormSection>

                        <!-- 危险操作 -->
                        <controls:FormSection x:Name="DangerSection"
                                              x:Uid="AccountSync_Danger"
                                              Margin="{StaticResource GapMdTop}">
                            <controls:FormSection.SectionContent>
                                <StackPanel>
                                    <Button x:Name="DeleteVaultButton" x:Uid="AccountSync_DeleteVault"
                                            Style="{StaticResource DangerButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="{StaticResource GapSmTop}"
                                            Click="OnDeleteVaultClick" />
                                    <Button x:Name="DeleteAccountButton" x:Uid="AccountSync_DeleteAccount"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Margin="{StaticResource GapSmTop}"
                                            HorizontalAlignment="Stretch"
                                            Click="OnDeleteAccountClick" />
                                </StackPanel>
                            </controls:FormSection.SectionContent>
                        </controls:FormSection>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 设备 Pivot (U18) -->
            <PivotItem x:Name="DevicesTab" x:Uid="AccountSync_TabDevices">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="DevicesList"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnDeviceClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <controls:AppListRow Title="{Binding Name}"
                                                     Subtitle="{Binding Platform}"
                                                     ShowChevron="True" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <controls:EmptyState x:Name="DevicesEmpty"
                                         Grid.Row="0"
                                         Visibility="Collapsed" />
                    <ProgressRing x:Name="DevicesProgress" Grid.Row="0"
                                  Width="{StaticResource SpaceXl}" Height="{StaticResource SpaceXl}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                </Grid>
            </PivotItem>

            <!-- 历史 Pivot (U18) -->
            <PivotItem x:Name="HistoryTab" x:Uid="AccountSync_TabHistory">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="HistoryList"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnHistoryClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <controls:AppListRow Title="{Binding Revision}"
                                                     Subtitle="{Binding DeviceName}"
                                                     ShowChevron="True" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <controls:EmptyState x:Name="HistoryEmpty"
                                         Grid.Row="0"
                                         Visibility="Collapsed" />
                    <ProgressRing x:Name="HistoryProgress" Grid.Row="0"
                                  Width="{StaticResource SpaceXl}" Height="{StaticResource SpaceXl}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                    <Button x:Name="ClearHistoryButton" x:Uid="AccountSync_ClearHistory"
                            Grid.Row="1"
                            Margin="{StaticResource PagePadding}"
                            HorizontalAlignment="Stretch"
                            Click="OnClearHistoryClick" />
                </Grid>
            </PivotItem>
        </Pivot>
        </Grid>

        <controls:LoadingOverlay x:Name="Working" Grid.RowSpan="3" />
    </Grid>
</Page>
