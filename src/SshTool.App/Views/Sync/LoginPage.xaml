<Page
    x:Class="SshTool.App.Views.Sync.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SshTool.App.Infrastructure"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U15 登录/注册页（02-UI-DESIGN.md §5.13）：登录/注册分段切换（设计允许用分段按钮代替 Pivot，
         避免两套表单重复 x:Uid）；明文 HTTP Banner；注册 ≥10 位 + 确认 + 可选邀请码；三端共用说明。
         本页只用 15063 基线控件（Pivot 未用；PasswordBox 不开 reveal 按钮，避免越契约）。
         fix/login-feedback：错误区挪到页头正下方、滚动区之外（原先在表单最底部，360×640 + 明文 Banner
         + 软键盘时落在可视区外，真机表现为「登录没有报错也没有反应」）；输入框回车：邮箱 → 密码 → 提交
        （软键盘弹出时底部操作条会收起，回车是唯一的提交途径）。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Uid="Login_Title"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />
        <Border x:Name="ErrorPanel" Grid.Row="1"
                Background="{ThemeResource AppSurfaceAltBrush}"
                BorderBrush="{ThemeResource AppDangerBrush}"
                BorderThickness="{StaticResource BorderThinBottom}"
                Padding="{StaticResource PadInlineError}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{StaticResource IconError}"
                          FontSize="{StaticResource FontSubtitle}"
                          Foreground="{ThemeResource AppDangerBrush}"
                          VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorText" Grid.Column="1"
                           Foreground="{ThemeResource AppDangerBrush}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           AutomationProperties.LiveSetting="Assertive"
                           Margin="{StaticResource GapSmLeft}" />
            </Grid>
        </Border>
        <ScrollViewer infra:InputPaneScroll.IsEnabled="True" Grid.Row="2">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <controls:Banner x:Name="HttpBanner" x:Uid="Login_HttpBanner"
                                 Severity="Warning"
                                 Margin="{StaticResource GapSmTop}"
                                 Visibility="Collapsed" />
                <Grid Margin="{StaticResource GapSmTop}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LoginTabButton" x:Uid="Login_LoginTab"
                            HorizontalAlignment="Stretch" Click="OnLoginTabClick" />
                    <Button x:Name="RegisterTabButton" x:Uid="Login_RegisterTab"
                            Grid.Column="1" HorizontalAlignment="Stretch"
                            Margin="{StaticResource GapSmLeft}" Click="OnRegisterTabClick" />
                </Grid>
                <controls:FormSection x:Uid="Login_Section_Credentials" Margin="{StaticResource GapSmTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <TextBox x:Name="EmailBox" x:Uid="Login_EmailBox"
                                     InputScope="EmailSmtpAddress"
                                     IsSpellCheckEnabled="False"
                                     IsTextPredictionEnabled="False"
                                     TextChanged="OnEmailChanged"
                                     KeyDown="OnEmailKeyDown" />
                            <PasswordBox x:Name="PasswordBox" x:Uid="Login_PasswordBox"
                                         Margin="{StaticResource GapSmTop}"
                                         PasswordChanged="OnPasswordChanged"
                                         KeyDown="OnPasswordKeyDown" />
                            <TextBlock x:Name="PasswordHint" x:Uid="Login_PasswordHint"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="{StaticResource GapXsTop}"
                                       Visibility="Collapsed" />
                            <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                                <PasswordBox x:Name="ConfirmBox" x:Uid="Login_ConfirmBox"
                                             Margin="{StaticResource GapSmTop}"
                                             PasswordChanged="OnConfirmChanged"
                                             KeyDown="OnSubmitKeyDown" />
                                <TextBox x:Name="InviteBox" x:Uid="Login_InviteBox"
                                         Margin="{StaticResource GapSmTop}"
                                         TextChanged="OnInviteChanged"
                                         KeyDown="OnSubmitKeyDown" />
                            </StackPanel>
                            <TextBox x:Name="DeviceBox" x:Uid="Login_DeviceBox" MaxLength="255"
                                     Margin="{StaticResource GapSmTop}"
                                     TextChanged="OnDeviceChanged"
                                     KeyDown="OnSubmitKeyDown" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
                <TextBlock x:Uid="Login_SharedNote"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource GapSmTop}" />
            </StackPanel>
        </ScrollViewer>
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="3"
                                  PrimaryClick="OnSubmitClick" />
        <controls:LoadingOverlay x:Name="Working" Grid.RowSpan="4" />
    </Grid>
</Page>
