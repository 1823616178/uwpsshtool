<Page
    x:Class="SshTool.App.Views.Sync.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U15 登录/注册页（02-UI-DESIGN.md §5.13）：登录/注册分段切换（设计允许用分段按钮代替 Pivot，
         避免两套表单重复 x:Uid）；明文 HTTP Banner；注册 ≥10 位 + 确认 + 可选邀请码；三端共用说明。
         本页只用 15063 基线控件（Pivot 未用；PasswordBox 不开 reveal 按钮，避免越契约）。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Uid="Login_Title"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <controls:Banner x:Name="HttpBanner" x:Uid="Login_HttpBanner"
                                 Severity="Warning"
                                 Margin="{StaticResource GapSmTop}"
                                 Visibility="Collapsed" />
                <Grid Margin="{StaticResource GapSmTop}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LoginTabButton" x:Uid="Login_LoginTab" Content="登录"
                            HorizontalAlignment="Stretch" Click="OnLoginTabClick" />
                    <Button x:Name="RegisterTabButton" x:Uid="Login_RegisterTab" Content="注册"
                            Grid.Column="1" HorizontalAlignment="Stretch"
                            Margin="{StaticResource GapSmLeft}" Click="OnRegisterTabClick" />
                </Grid>
                <controls:FormSection x:Uid="Login_Section_Credentials" Margin="{StaticResource GapSmTop}">
                    <controls:FormSection.SectionContent>
                        <StackPanel>
                            <TextBox x:Name="EmailBox" x:Uid="Login_EmailBox"
                                     Header="邮箱" PlaceholderText="you@example.com"
                                     InputScope="EmailSmtpAddress"
                                     TextChanged="OnEmailChanged" />
                            <PasswordBox x:Name="PasswordBox" x:Uid="Login_PasswordBox"
                                         Header="密码" PlaceholderText="请输入密码"
                                         Margin="{StaticResource GapSmTop}"
                                         PasswordChanged="OnPasswordChanged" />
                            <TextBlock x:Name="PasswordHint" x:Uid="Login_PasswordHint"
                                       Text="注册密码至少 10 位"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="{StaticResource GapXsTop}"
                                       Visibility="Collapsed" />
                            <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                                <PasswordBox x:Name="ConfirmBox" x:Uid="Login_ConfirmBox"
                                             Header="确认密码"
                                             Margin="{StaticResource GapSmTop}"
                                             PasswordChanged="OnConfirmChanged" />
                                <TextBox x:Name="InviteBox" x:Uid="Login_InviteBox"
                                         Header="邀请码（可选）" PlaceholderText="如需邀请码请填写"
                                         Margin="{StaticResource GapSmTop}"
                                         TextChanged="OnInviteChanged" />
                            </StackPanel>
                            <TextBox x:Name="DeviceBox" x:Uid="Login_DeviceBox"
                                     Header="设备名称" MaxLength="255"
                                     Margin="{StaticResource GapSmTop}"
                                     TextChanged="OnDeviceChanged" />
                            <TextBlock x:Name="ErrorText"
                                       Foreground="{ThemeResource AppDangerBrush}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource GapSmTop}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </controls:FormSection.SectionContent>
                </controls:FormSection>
                <TextBlock x:Uid="Login_SharedNote"
                           Text="与桌面端 SSH Tool、鸿蒙端使用同一账号，主机与隧道将自动在设备间同步。"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource GapSmTop}" />
            </StackPanel>
        </ScrollViewer>
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="2"
                                  PrimaryClick="OnSubmitClick" />
        <controls:LoadingOverlay x:Name="Working" Grid.RowSpan="3" />
    </Grid>
</Page>
