<Page
    x:Class="SshTool.App.Views.Sync.SyncConflictPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U19 同步冲突页（02-UI-DESIGN.md §5.14）：远端摘要 + 涉及项目（敏感字段显示「有变更」）
         + [使用云端配置] / [保留本机配置] 按钮 → ResolveConflict。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:AppPageHeader x:Name="Header" x:Uid="Conflict_Header"
                                ShowBackButton="True"
                                BackRequested="OnBackRequested" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource CardListPadding}"
                        MaxWidth="{StaticResource FormMaxWidth}"
                        HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <controls:EmptyState x:Name="NoConflictEmpty" Visibility="Collapsed" />

                <!-- opt/full-pass：摘要卡与项目列表统一到卡片材质（原先是一块 RadiusMd 的小面板，
                     与「账号与同步」页的卡片语言不一致）。 -->
                <Border x:Name="SummaryCard" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="{StaticResource PadCard}">
                        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DescriptionText" Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" Margin="{StaticResource GapSmTop}" />
                        <TextBlock x:Name="RemoteSummaryText" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="{StaticResource GapSmTop}" />
                        <TextBlock x:Name="UpdatedAtText" Style="{StaticResource CaptionTextStyle}"
                                   Margin="{StaticResource GapXsTop}" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="FieldsHeader" x:Uid="Conflict_FieldsHeader"
                           Style="{StaticResource GroupHeaderTextStyle}"
                           Margin="{StaticResource GroupHeaderPadding}" />
                <ListView x:Name="FieldsList"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource CardListViewItemStyle}"
                          Padding="{StaticResource CardListPadding}">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <controls:AppListRow Title="{Binding EntityName}"
                                                 Subtitle="{Binding FieldLabel}"
                                                 ShowChevron="False"
                                                 IsCard="True" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="ErrorText"
                           Foreground="{ThemeResource AppDangerBrush}"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="{StaticResource GapMdTop}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- opt/full-pass：底部操作区补顶部细线（与 BottomActionBar 同层级语言），
             两个选择并排：屏幕窄时改纵排由 WrapPanel 兜底不现实，保持纵排但收进限宽。 -->
        <Border Grid.Row="2" Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="{StaticResource BorderThinTop}">
            <StackPanel Padding="{StaticResource PadActionBar}"
                        MaxWidth="{StaticResource FormMaxWidth}"
                        HorizontalAlignment="Stretch">
                <Button x:Name="PrimaryButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        MinHeight="{StaticResource BottomBarHeight}"
                        Click="OnPrimaryClick" />
                <Button x:Name="SecondaryButton"
                        Margin="{StaticResource GapSmTop}"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinHeight="{StaticResource BottomBarHeight}"
                        Click="OnSecondaryClick" />
                <ProgressRing x:Name="Progress" Width="{StaticResource SpaceLg}" Height="{StaticResource SpaceLg}"
                              Margin="{StaticResource GapSmTop}"
                              HorizontalAlignment="Center"
                              Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
