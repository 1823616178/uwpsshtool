<Page
    x:Class="SshTool.App.Views.KeyBarLayoutEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U14 键条布局编辑（02-UI-DESIGN.md §5.6）：可用/已选两列 + 上下移动 + 恢复默认，改动立即写入设置。 -->
    <Page.Resources>
        <DataTemplate x:Key="KeyItemTemplate">
            <StackPanel Padding="{StaticResource PagePadding}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource BodyTextStyle}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Uid="KeyBarEditor_Title"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnHeaderBackRequested" />
        <TextBlock x:Uid="KeyBarEditor_Subtitle" Style="{StaticResource CaptionTextStyle}" Grid.Row="1"
                   Margin="{StaticResource PagePadding}" />
        <!-- 竖屏上下分：360 宽并排两列列表放不下。宽屏（≥720）再改成左右两列。 -->
        <Grid Grid.Row="2" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="EditorStackRow" Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="EditorSideColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:FormSection x:Uid="KeyBarEditor_Section_Available" Margin="{StaticResource PagePadding}">
                <controls:FormSection.SectionContent>
                    <ListView x:Name="AvailableList"
                              ItemTemplate="{StaticResource KeyItemTemplate}"
                              SelectionMode="Single" />
                </controls:FormSection.SectionContent>
            </controls:FormSection>
            <controls:FormSection x:Name="SelectedSection" x:Uid="KeyBarEditor_Section_Selected"
                                  Grid.Row="1" Grid.Column="0" Margin="{StaticResource PagePadding}">
                <controls:FormSection.SectionContent>
                    <ListView x:Name="SelectedList"
                              ItemTemplate="{StaticResource KeyItemTemplate}"
                              SelectionMode="Single" />
                </controls:FormSection.SectionContent>
            </controls:FormSection>
        </Grid>
        <StackPanel Grid.Row="3" MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Margin="{StaticResource PagePadding}">
                <Button x:Uid="KeyBarEditor_Add" Click="OnAddClick"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button x:Uid="KeyBarEditor_Remove" Click="OnRemoveClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="{StaticResource GapSmLeft}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="{StaticResource PagePadding}">
                <Button x:Uid="KeyBarEditor_MoveUp" Click="OnMoveUpClick"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Uid="KeyBarEditor_MoveDown" Click="OnMoveDownClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="{StaticResource GapSmLeft}" />
            </StackPanel>
        </StackPanel>
        <!-- 底部固定操作条：主操作=恢复默认 -->
        <controls:BottomActionBar x:Name="BottomBar" Grid.Row="4"
                                  PrimaryClick="OnResetClick"
                                  PrimaryButtonStyle="{StaticResource SecondaryButtonStyle}" />
        <controls:TransientToast x:Name="Toast" Grid.Row="4" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideBreakpoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EditorStackRow.Height" Value="0" />
                        <Setter Target="EditorSideColumn.Width" Value="*" />
                        <Setter Target="SelectedSection.(Grid.Row)" Value="0" />
                        <Setter Target="SelectedSection.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
