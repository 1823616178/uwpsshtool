<Page
    x:Class="SshTool.App.Views.KeyBarLayoutEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- U14 键条布局编辑（02-UI-DESIGN.md §5.6）：可用/已选两列 + 上下移动 + 恢复默认，改动立即写入设置。 -->
    <Page.Resources>
        <DataTemplate x:Key="KeyItemTemplate">
            <StackPanel Padding="{StaticResource PagePadding}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource BodyTextStyle}" />
                <TextBlock Text="{Binding Id}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="键条布局" Style="{StaticResource PageTitleTextStyle}"
                   Margin="{StaticResource PagePadding}" />
        <TextBlock Text="更改立即生效，下次打开终端时使用新布局"
                   Style="{StaticResource CaptionTextStyle}" Grid.Row="1"
                   Margin="{StaticResource PagePadding}" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="可用键" Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource PagePadding}" />
                <ListView x:Name="AvailableList" Grid.Row="1"
                          ItemTemplate="{StaticResource KeyItemTemplate}"
                          SelectionMode="Single" />
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="已选键" Style="{StaticResource BodyTextStyle}"
                           Margin="{StaticResource PagePadding}" />
                <ListView x:Name="SelectedList" Grid.Row="1"
                          ItemTemplate="{StaticResource KeyItemTemplate}"
                          SelectionMode="Single" />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    Margin="{StaticResource PagePadding}">
            <Button Content="添加 →" Click="OnAddClick" />
            <Button Content="← 移除" Click="OnRemoveClick"
                    Margin="{StaticResource GapSmLeft}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    Margin="{StaticResource PagePadding}">
            <Button Content="上移" Click="OnMoveUpClick" />
            <Button Content="下移" Click="OnMoveDownClick"
                    Margin="{StaticResource GapSmLeft}" />
            <Button Content="恢复默认" Click="OnResetClick"
                    Margin="{StaticResource GapSmLeft}" />
        </StackPanel>
        <controls:TransientToast x:Name="Toast" Grid.Row="4" />
    </Grid>
</Page>
