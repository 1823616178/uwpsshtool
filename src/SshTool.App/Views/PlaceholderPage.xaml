<Page
    x:Class="SshTool.App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <!-- opt/full-pass：占位页也走与其余页面一致的骨架——页头返回按钮 + 居中空态，
         不再是一个孤零零的次级按钮加一个字形（原先按钮 Margin=GapSmTop 贴在状态栏下方）。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Name="PageHeader" Level="Secondary" ShowBackButton="True"
                                BackRequested="OnBackRequested" />
        <controls:EmptyState x:Name="Empty"
                             Grid.Row="1"
                             Glyph="{StaticResource IconInfo}"
                             x:Uid="Placeholder_ComingSoon" />
    </Grid>
</Page>
