<Page
    x:Class="SshTool.App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button Content="返回" Click="OnBackClick" Margin="{StaticResource GapSmTop}"
                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
        <controls:EmptyState x:Name="Empty"
                             Grid.Row="1"
                             Glyph="{StaticResource IconInfo}"
                             Title="即将推出" />
    </Grid>
</Page>
