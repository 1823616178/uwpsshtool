<Page
    x:Class="SshTool.App.Views.Debug.InputSpikePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBgBrush}">

    <!-- SP05：软键盘/IME/物理键盘事件序列采集（调试页豁免魔法数字检查） -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="返回" Click="OnBackClick" AllowFocusOnInteraction="False" />
            <TextBlock Text="SP05 输入事件采集" Style="{StaticResource SectionTitleTextStyle}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <!-- 步骤提示：点「下一步」会往日志里插一条分段标记，导出后一眼能分清哪段是哪个操作 -->
        <Border Grid.Row="1" Background="{ThemeResource AppSurfaceAltBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1"
                Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock x:Name="StepText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                           Text="按「开始/下一步」逐项做，做完点「导出报告」" />
                <!-- AllowFocusOnInteraction=False：点按钮不抢焦点，软键盘不会收起
                     （contract 3.0 / 1607，低于本工程 min 15063，可直接用）。 -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="StepButton" Content="开始" Click="OnNextStepClick"
                            AllowFocusOnInteraction="False" />
                    <Button Content="聚焦哨兵（弹软键盘）" Click="OnFocusClick" Margin="8,0,0,0" />
                    <Button Content="导出报告" Click="OnExportClick" Margin="8,0,0,0"
                            AllowFocusOnInteraction="False" />
                    <Button Content="清空" Click="OnClearClick" Margin="8,0,0,0"
                            AllowFocusOnInteraction="False" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- §7.5 的哨兵 TextBox 原型：1×1、几乎全透明、关闭拼写检查与联想 -->
        <TextBox x:Name="Sentinel" Grid.Row="2"
                 Width="1" Height="1" Opacity="0.01"
                 HorizontalAlignment="Left"
                 IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                 AcceptsReturn="False" TextWrapping="NoWrap"
                 KeyDown="OnSentinelKeyDown"
                 TextChanging="OnTextChanging"
                 TextChanged="OnTextChanged"
                 SelectionChanged="OnSelectionChanged"
                 TextCompositionStarted="OnCompositionStarted"
                 TextCompositionChanged="OnCompositionChanged"
                 TextCompositionEnded="OnCompositionEnded"
                 GotFocus="OnSentinelGotFocus" LostFocus="OnSentinelLostFocus" />

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource MonoCaptionTextStyle}"
                   TextWrapping="Wrap" Margin="0,4,0,8" Text="哨兵未聚焦" />

        <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True"
                 IsTabStop="False" AllowFocusOnInteraction="False"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
