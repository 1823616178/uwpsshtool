<Page
    x:Class="SshTool.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Background="{ThemeResource AppBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:AppPageHeader x:Name="PageHeader" x:Uid="About_Header"
                                Level="Secondary" ShowBackButton="True"
                                BackRequested="OnBackRequested" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource CardListPadding}"
                        MaxWidth="{StaticResource FormMaxWidth}" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!-- opt/full-pass：应用名 + 版本收进一张卡片（原先标题 + 正文散在页面上），
                     依赖与许可、开源许可按钮各归其卡片，与设置二级页同一节奏。 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="{StaticResource PadCard}">
                        <TextBlock x:Uid="About_AppName" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource MonoCaptionTextStyle}"
                                   Margin="{StaticResource GapXsTop}" />
                    </StackPanel>
                </Border>

                <controls:SectionHeader x:Uid="About_DepsHeader"
                                        Margin="{StaticResource GroupHeaderPadding}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="{StaticResource PadCard}">
                        <controls:MonoText x:Name="DepsText" Compact="True" />
                    </StackPanel>
                </Border>

                <controls:SectionHeader x:Uid="About_LicenseHeader"
                                        Margin="{StaticResource GroupHeaderPadding}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="{StaticResource PadCard}">
                        <Button x:Uid="About_LicensesButton" Click="OnLicensesClick"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch" />
                        <TextBlock x:Uid="About_PrivacyLink" Style="{StaticResource CaptionTextStyle}"
                                   Margin="{StaticResource GapSmTop}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
