<Page
    x:Class="SshTool.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBgBrush}">

    <!-- X02 骨架页：U01 将替换为 02-UI-DESIGN.md §5.1 的主机 Pivot。
         间距一律走 Gap* Token（W10M 无 StackPanel.Spacing）。 -->
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Lumia SSH"
                       Style="{StaticResource PageTitleTextStyle}"
                       Margin="{StaticResource GapLgBottom}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="CoreVersionText"
                       Style="{StaticResource BodyTextStyle}"
                       Margin="{StaticResource GapSmBottom}" />
            <TextBlock x:Name="NativeVersionText"
                       Style="{StaticResource BodyTextStyle}"
                       Margin="{StaticResource GapSmBottom}" />
            <TextBlock x:Name="OpenSslVersionText"
                       Style="{StaticResource BodyTextStyle}"
                       Margin="{StaticResource GapSmBottom}" />
            <TextBlock x:Name="BuildText"
                       Style="{StaticResource CaptionTextStyle}" />
            <Button x:Name="SpikeButton" Content="SP01 JSON Spike"
                    Margin="{StaticResource GapXlTop}"
                    Visibility="Collapsed" Click="OnSpikeClick" />
            <Button x:Name="TokenGalleryButton" Content="X03 Token 画廊"
                    Margin="{StaticResource GapMdTop}"
                    Visibility="Collapsed" Click="OnTokenGalleryClick" />
            <Button x:Name="RenderSpikeButton" Content="SP04 Win2D 渲染压测"
                    Margin="{StaticResource GapMdTop}"
                    Visibility="Collapsed" Click="OnRenderSpikeClick" />
        </StackPanel>
    </Grid>
</Page>
