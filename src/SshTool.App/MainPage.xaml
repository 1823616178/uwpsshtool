<Page
    x:Class="SshTool.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Lumia SSH" FontSize="24" Margin="0,0,0,16" HorizontalAlignment="Center" />
            <TextBlock x:Name="CoreVersionText" FontSize="16" Margin="0,0,0,8" />
            <TextBlock x:Name="NativeVersionText" FontSize="16" Margin="0,0,0,8" />
            <TextBlock x:Name="OpenSslVersionText" FontSize="16" />
            <Button x:Name="SpikeButton" Content="SP01 JSON Spike" Margin="0,24,0,0"
                    Visibility="Collapsed" Click="OnSpikeClick" />
        </StackPanel>
    </Grid>
</Page>
