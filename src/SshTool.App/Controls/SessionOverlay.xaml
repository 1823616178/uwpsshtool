<UserControl
    x:Class="SshTool.App.Controls.SessionOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="{ThemeResource OverlayScrimBrush}" Visibility="Collapsed">
        <!-- opt/full-pass：蒙层卡片与对话框同一材质/圆角/发丝描边（原先是无圆角无描边的裸面板），
             窄屏下按钮横向排不下时仍靠 MaxWidth + 换行兜底（StackPanel 不换行，故按钮数量保持 ≤3 可见）。 -->
        <Border Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusLg}"
                Padding="{StaticResource PadHero}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="{StaticResource DialogMaxWidth}">
            <StackPanel>
                <ProgressRing x:Name="Ring" Width="{StaticResource TouchTargetMin}"
                              Height="{StaticResource TouchTargetMin}" />
                <TextBlock x:Name="MessageText" Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="{StaticResource GapSmTop}" />
                <!-- UI 走查：按钮分级——主推进（立即重连/重试）Primary、破坏性（停止重连/关闭会话）
                     Danger、其余（取消/编辑主机）Secondary；三档样式均含 MinHeight=TouchTargetMin。 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="{StaticResource GapSmTop}">
                    <Button x:Uid="SessionOverlay_CancelButton" x:Name="CancelButton" Click="OnCancel"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" />
                    <Button x:Uid="SessionOverlay_ReconnectNowButton" x:Name="ReconnectNowButton" Click="OnReconnectNow"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="Collapsed" Margin="{StaticResource GapSmLeft}" />
                    <Button x:Uid="SessionOverlay_StopButton" x:Name="StopButton" Click="OnStop"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="Collapsed" Margin="{StaticResource GapSmLeft}" />
                    <Button x:Uid="SessionOverlay_RetryButton" x:Name="RetryButton" Click="OnRetry"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="Collapsed" Margin="{StaticResource GapSmLeft}" />
                    <Button x:Uid="SessionOverlay_EditButton" x:Name="EditButton" Click="OnEdit"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed" Margin="{StaticResource GapSmLeft}" />
                    <Button x:Uid="SessionOverlay_CloseButton" x:Name="CloseButton" Click="OnClose"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="Collapsed" Margin="{StaticResource GapSmLeft}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
