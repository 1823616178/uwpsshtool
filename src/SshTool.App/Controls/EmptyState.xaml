<UserControl
    x:Class="SshTool.App.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 02-UI-DESIGN.md §6：字形图标 + 标题 + 说明 + 最多两个按钮 -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="{StaticResource PagePadding}">
        <FontIcon x:Name="GlyphIcon" FontSize="{StaticResource FontHeader}"
                  Foreground="{ThemeResource AppTextFaintBrush}"
                  HorizontalAlignment="Center"
                  Margin="{StaticResource GapSmBottom}" />
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleTextStyle}"
                   TextAlignment="Center"
                   Margin="{StaticResource GapXsBottom}" />
        <TextBlock x:Name="DescriptionText" Style="{StaticResource CaptionTextStyle}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Margin="{StaticResource GapSmBottom}" />
        <Button x:Name="PrimaryButton" HorizontalAlignment="Center" Click="OnPrimaryClick"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="{StaticResource GapSmTop}" />
        <HyperlinkButton x:Name="SecondaryButton" HorizontalAlignment="Center" Click="OnSecondaryClick"
                         Margin="{StaticResource GapXsTop}" />
    </StackPanel>
</UserControl>
