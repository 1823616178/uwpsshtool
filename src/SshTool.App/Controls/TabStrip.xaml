<UserControl
    x:Class="SshTool.App.Controls.TabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- U12：宽屏标签栏（02-UI-DESIGN.md §5.7）。标签项在代码里生成；新建按钮固定最右。 -->
    <Grid Background="{ThemeResource AppSurfaceBrush}"
          Height="{StaticResource TabStripHeight}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="TabsScroller"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Disabled">
            <StackPanel x:Name="TabsPanel" Orientation="Horizontal" />
        </ScrollViewer>
        <!-- C-03：TerminalIconButtonStyle 统一焦点行为与触控宽；无障碍名经 x:Uid 走 resw；
             高度受 TabStripHeight=40 行约束，显式 Height。 -->
        <Button x:Name="AddButton"
                x:Uid="TabStrip_AddButton"
                Grid.Column="1"
                Click="OnAddClick"
                Style="{StaticResource TerminalIconButtonStyle}"
                Height="{StaticResource TabStripHeight}"
                Margin="{StaticResource GapSmLeft}">
            <FontIcon Glyph="{StaticResource IconAdd}" />
        </Button>
    </Grid>
</UserControl>
