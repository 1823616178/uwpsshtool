<UserControl
    x:Class="SshTool.App.Controls.SurfaceCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 05 §5.3：分组/表单容器。Surface1 底 + Stroke 细边 + RadiusMd 圆角 + PadCard 内边距；
         pressed 底升 Surface2、selected 描边 Accent、error 描边 Danger（§5.1 语义色只作细边）。 -->
    <Border x:Name="Root"
            Background="{ThemeResource AppSurfaceBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="{StaticResource BorderThin}"
            CornerRadius="{StaticResource RadiusMd}"
            Padding="{StaticResource PadCard}">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource SectionTitleTextStyle}"
                       Visibility="Collapsed" />
            <ContentPresenter x:Name="ContentSlot" />
        </StackPanel>
    </Border>
</UserControl>
