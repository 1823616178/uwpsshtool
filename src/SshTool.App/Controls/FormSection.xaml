<UserControl
    x:Class="SshTool.App.Controls.FormSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 05 §5.3：表单分组容器（无卡片描边，SurfaceCard 才是带边卡片）。
         固定顺序（§5.2「标签、说明和错误采用固定顺序」）：标题 → 说明 → 内容槽 → 验证信息。
         状态：normal / error（验证信息以 Danger 色显示）/ readonly（内容降 DisabledOpacity 并断命中）。 -->
    <StackPanel x:Name="Root">
        <TextBlock x:Name="HeaderText" Style="{StaticResource SectionTitleTextStyle}"
                   Visibility="Collapsed" />
        <TextBlock x:Name="DescriptionText" Style="{StaticResource CaptionTextStyle}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
        <ContentPresenter x:Name="ContentSlot" />
        <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionTextStyle}"
                   Foreground="{ThemeResource AppDangerBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
