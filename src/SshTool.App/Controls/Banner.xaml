<UserControl
    x:Class="SshTool.App.Controls.Banner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 02-UI-DESIGN.md §6：Severity + Title + Message + 可选操作 + 可关闭（InfoBar 替代） -->
    <Border x:Name="Root"
            Background="{ThemeResource AppSurfaceAltBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="{StaticResource BorderThinBottom}"
            Padding="{StaticResource PagePadding}">
        <!-- 列间距用子元素 Margin 让出：Grid.ColumnSpacing 需 contract 5.0（1709），
             W10M 15063 上会抛 XamlParseException 0x802B000A。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="SeverityIcon" FontSize="{StaticResource FontSubtitle}"
                      VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                        Margin="{StaticResource GapSmLeft}">
                <TextBlock x:Name="TitleText" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <HyperlinkButton x:Name="ActionButton" Grid.Column="2"
                             Margin="{StaticResource GapSmLeft}"
                             VerticalAlignment="Center" Click="OnActionClick" />
            <FontIcon x:Name="CloseButton" Grid.Column="3" Glyph="{StaticResource IconClose}"
                      Margin="{StaticResource GapSmLeft}"
                      FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"
                      Foreground="{ThemeResource AppTextDimBrush}" Tapped="OnCloseTapped" />
        </Grid>
    </Border>
</UserControl>
