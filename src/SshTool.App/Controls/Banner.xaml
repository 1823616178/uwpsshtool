<UserControl
    x:Class="SshTool.App.Controls.Banner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 02-UI-DESIGN.md §6：Severity + Title + Message + 可选操作 + 可关闭（InfoBar 替代） -->
    <Border x:Name="Root"
            Background="{ThemeResource AppSurfaceAltBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="{StaticResource PagePadding}">
        <Grid ColumnSpacing="{StaticResource SpaceSm}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="SeverityIcon" FontSize="{StaticResource FontSubtitle}"
                      VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                <TextBlock x:Name="MessageText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <HyperlinkButton x:Name="ActionButton" Grid.Column="2"
                             VerticalAlignment="Center" Click="OnActionClick" />
            <FontIcon x:Name="CloseButton" Grid.Column="3" Glyph="&#xE894;"
                      FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"
                      Foreground="{ThemeResource AppTextDimBrush}" Tapped="OnCloseTapped" />
        </Grid>
    </Border>
</UserControl>
