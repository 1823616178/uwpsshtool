<UserControl
    x:Class="SshTool.App.Controls.SectionHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 02-UI-DESIGN.md §6：分组标题 + 右侧可选操作 -->
    <Grid MinHeight="{StaticResource GroupHeaderHeight}">
        <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextStyle}"
                   VerticalAlignment="Center" />
        <HyperlinkButton x:Name="ActionButton" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Click="OnActionClick" />
    </Grid>
</UserControl>
