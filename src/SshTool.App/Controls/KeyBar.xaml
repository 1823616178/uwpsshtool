<UserControl
    x:Class="SshTool.App.Controls.KeyBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowFocusOnInteraction="False"
    IsTabStop="False">

    <!-- T10：02-UI-DESIGN.md §5.6。键在代码里按布局字符串生成；右侧固定收起键盘。
         opt/full-pass 竖屏重设计（doc/PORTRAIT-UI.md）：底板改纵向渐变 + 键帽渐变/发丝描边；
         新增第二行（ExtraRow，ShowExtraRow=True 时显示，由 TerminalPage 的 TallState 打开），
         放 SIP 需切符号页才有的字符（KeyBarLayout.ExtraRowFor 去重主行）。
         外层高度随行数变化，TerminalPage.UpdateKeyBarLift 读 ActualHeight，无需改动。 -->
    <Grid Background="{ThemeResource KeyBarGradientBrush}"
          Padding="{StaticResource KeyBarPad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="KeysExtraScroller"
                      Grid.Row="0"
                      Visibility="Collapsed"
                      Margin="{StaticResource KeyBarRowGap}"
                      AllowFocusOnInteraction="False"
                      IsTabStop="False"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Disabled">
            <StackPanel x:Name="KeysExtraPanel" Orientation="Horizontal"
                        AllowFocusOnInteraction="False" />
        </ScrollViewer>
    <Grid Grid.Row="1" Height="{StaticResource KeyBarHeight}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- §7.5：键条上任何能获焦的元素都会在点击时把焦点从哨兵抢走、SIP 随即收起。
             键本身是 Border（不可获焦），但包着它们的 ScrollViewer 是 Control，
             AllowFocusOnInteraction 默认为真——点 Ctrl/Esc/Tab 就会收键盘
             （键条此前被压在软键盘背后、点不到，所以一直没暴露）。 -->
        <ScrollViewer x:Name="KeysScroller"
                      AllowFocusOnInteraction="False"
                      IsTabStop="False"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Disabled">
            <StackPanel x:Name="KeysPanel" Orientation="Horizontal"
                        AllowFocusOnInteraction="False" />
        </ScrollViewer>
        <!-- V01a：⌨ 换 MDL2 KeyboardClassic（IconKeyboard），无障碍名走 resw（x:Uid）；
             Rebuild 不再覆盖 Content（图标固定在 XAML）。评审回补：Core 目录 hidekb 的
             Label 已置空——此按钮无文本，编辑器行首语义文本由 App 层 resw 提供。 -->
        <Button x:Name="HideKeyboardButton"
                x:Uid="KeyBar_HideKeyboardButton"
                Style="{StaticResource IconButtonStyle}"
                Grid.Column="1"
                AllowFocusOnInteraction="False"
                IsTabStop="False"
                Click="OnHideKeyboardClick"
                MinWidth="{StaticResource KeyBarKeyMinWidth}"
                Height="{StaticResource KeyBarHeight}"
                Padding="{StaticResource PadNone}"
                Margin="{StaticResource GapSmLeft}"
                Background="{ThemeResource KeyBarKeyIdleBrush}"
                Foreground="{ThemeResource AppTextBrush}"
                BorderBrush="{ThemeResource KeyBarKeyStrokeBrush}"
                BorderThickness="{StaticResource BorderThin}">
            <FontIcon Glyph="{StaticResource IconKeyboard}" FontSize="{StaticResource FontBody}" />
        </Button>
    </Grid>
    </Grid>
</UserControl>
