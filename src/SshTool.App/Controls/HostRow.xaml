<UserControl
    x:Class="SshTool.App.Controls.HostRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    Holding="OnHolding"
    RightTapped="OnRightTapped"
    Tapped="OnTapped">

    <UserControl.Resources>
        <MenuFlyout x:Name="RowMenu">
            <MenuFlyoutItem Text="连接" Click="OnConnectClick" />
            <MenuFlyoutItem Text="新会话" Click="OnNewSessionClick" />
            <MenuFlyoutItem Text="编辑" Click="OnEditClick" />
            <MenuFlyoutItem Text="复制为新主机" Click="OnDuplicateClick" />
            <MenuFlyoutItem Text="SFTP" Click="OnSftpClick" />
            <MenuFlyoutSeparator />
            <!-- UI 走查：破坏性项红字，与 ConfirmDialog(isDanger) 呼应 -->
            <MenuFlyoutItem Text="删除" Click="OnDeleteClick"
                            Style="{StaticResource DangerMenuItemStyle}" />
        </MenuFlyout>
    </UserControl.Resources>

    <Grid MinHeight="{StaticResource ListRowHeight}" Padding="{StaticResource PagePadding}"
          Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:StatusDot x:Name="Dot" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource GapSmLeft}">
            <TextBlock x:Name="NameText" Style="{StaticResource BodyTextStyle}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="AddressText" Style="{StaticResource MonoCaptionTextStyle}"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel x:Name="BadgePanel" Grid.Column="2" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="{StaticResource GapSmLeft}">
            <FontIcon x:Name="KeyBadge" Glyph="{StaticResource IconKey}"
                      FontSize="{StaticResource FontCaption}"
                      Foreground="{ThemeResource AppTextDimBrush}"
                      Visibility="Collapsed" />
            <TextBlock x:Name="TmuxBadge" Text="tmux" Style="{StaticResource CaptionTextStyle}"
                       Margin="{StaticResource GapSmLeft}" Visibility="Collapsed" />
            <TextBlock x:Name="JumpBadge" Text="↪" Style="{StaticResource CaptionTextStyle}"
                       Margin="{StaticResource GapSmLeft}" Visibility="Collapsed" />
            <FontIcon x:Name="TunnelBadge" Glyph="{StaticResource IconTunnel}"
                      FontSize="{StaticResource FontCaption}"
                      Foreground="{ThemeResource AppTextDimBrush}"
                      Margin="{StaticResource GapSmLeft}"
                      Visibility="Collapsed" />
        </StackPanel>

        <FontIcon Grid.Column="3" Glyph="{StaticResource IconMore}"
                  FontSize="{StaticResource FontCaption}"
                  Foreground="{ThemeResource AppTextDimBrush}"
                  Width="{StaticResource TouchTargetMin}"
                  Height="{StaticResource TouchTargetMin}"
                  VerticalAlignment="Center"
                  Tapped="OnMoreTapped" />
    </Grid>
</UserControl>
