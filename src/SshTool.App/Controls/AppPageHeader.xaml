<UserControl
    x:Class="SshTool.App.Controls.AppPageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 05 §5.3：页头。标题（一级 FontHeader 28 / 编辑页 FontTitle 20）+ 可选返回
         + 右侧状态槽 + 仅 1 个主操作槽。状态：compact（窄屏降字号收敛）/ normal / wide
         （≥ExtraWideBreakpoint 加大页边距），按控件实际宽度在 code-behind 切换。 -->
    <Grid x:Name="RootGrid" Padding="{StaticResource PagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="BackButton" x:Uid="AppPageHeader_BackButton"
                Style="{StaticResource IconButtonStyle}"
                Click="OnBackClick"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <FontIcon Glyph="{StaticResource IconBack}" FontSize="{StaticResource FontBody}" />
        </Button>
        <TextBlock x:Name="TitleText" Grid.Column="1" Style="{StaticResource PageTitleTextStyle}"
                   VerticalAlignment="Center"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <ContentPresenter x:Name="StatusSlot" Grid.Column="2"
                          Margin="{StaticResource GapSmLeft}"
                          VerticalAlignment="Center" Visibility="Collapsed" />
        <ContentPresenter x:Name="ActionSlot" Grid.Column="3"
                          Margin="{StaticResource GapSmLeft}"
                          VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</UserControl>
