<UserControl
    x:Class="SshTool.App.Controls.StatusPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 05 §5.3：短状态标签（「已连接」「离线」）。§5.1 原则：语义色只用于小点，
         不整张高饱和——Surface2 底 + Stroke 细边 + 语义色小点 + 正文。 -->
    <Border x:Name="Root"
            Background="{ThemeResource AppSurfaceAltBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="{StaticResource BorderThin}"
            CornerRadius="{StaticResource RadiusPill}"
            Padding="{StaticResource PadPill}"
            MinHeight="{StaticResource SpaceXl}"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot"
                     Width="{StaticResource StatusDotSize}"
                     Height="{StaticResource StatusDotSize}"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="Label" Style="{StaticResource CaptionTextStyle}"
                       Margin="{StaticResource GapSmLeft}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
