  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <!-- S05：保险库自检向量（node:crypto 按桌面端相同原语生成，提交后冻结） -->
    <Content Include="Assets\sync-vectors\vault-selfcheck-vectors.json" />
    <!-- Q07：磁贴/图标/启动画面共 52 个 PNG，由 tools/assets/generate.ps1 从 icon.svg 生成，用通配符收 -->
    <Content Include="Assets\*.png" />
    <!-- SP04：终端等宽字体（SIL OFL 1.1；由 scripts/fetch-fonts.ps1 按固定 SHA256 抓取） -->
    <Content Include="Assets\Fonts\JetBrainsMono-Regular.ttf" />
    <Content Include="Assets\Fonts\JetBrainsMono-Bold.ttf" />
    <Content Include="Assets\Fonts\OFL.txt" />
    <Content Include="Properties\Default.rd.xml" />
    <!-- X05：按 Configuration 选配置文件，打包为 Assets/appconfig.json -->
    <Content Include="Config\appconfig.Debug.json" Condition="'$(Configuration)'=='Debug'">
      <Link>Assets\appconfig.json</Link>
    </Content>
    <Content Include="Config\appconfig.Release.json" Condition="'$(Configuration)'=='Release'">
      <Link>Assets\appconfig.json</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform">
      <Version>$(NetCoreUwpVersion)</Version>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json">
      <Version>$(NewtonsoftJsonVersion)</Version>
    </PackageReference>
    <!-- SP04：终端渲染（01-DESIGN §7.3） -->
    <PackageReference Include="Win2D.uwp">
      <Version>$(Win2DVersion)</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SshTool.Core\SshTool.Core.csproj">
      <Project>{7F4C8ECF-51C2-4BDF-A7B7-09A63A934AA6}</Project>
      <Name>SshTool.Core</Name>
    </ProjectReference>
    <!-- Native 只能由 VS2017 MSBuild(v141) 构建（VS2026 无 v141/UWP 支持），无法作为项目引用参与
         本解决方案的构建；改为直接引用其 winmd 产物（构建顺序：先 VS2017 构建 Native，再构建本工程，
         由 scripts/verify.ps1 保证；NativePlatform 处理 x86→Win32 的平台名差异）。 -->
    <Reference Include="SshTool.Native">
      <HintPath>..\SshTool.Native\bin\$(NativePlatform)\$(Configuration)\SshTool.Native.winmd</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <SDKReference Include="WindowsMobile, Version=10.0.19041.0">
      <Name>Windows Mobile Extensions for the UWP</Name>
    </SDKReference>
    <!-- Native 是裸 winmd 引用（非 ProjectReference），MSBuild 不会自动注入 C++ 运行时框架依赖，
         导致 AppxManifest 缺 Microsoft.VCLibs.140.00[.Debug]，运行到激活 SshTool.Native 时
         0x8007007E（找不到 vccorlib140[d]_app.dll 等）。显式引用 VCLibs 扩展 SDK 补回。 -->
    <SDKReference Include="Microsoft.VCLibs, Version=14.0">
      <Name>Visual C++ 2015 Runtime for Universal Windows Platform Apps</Name>
    </SDKReference>
  </ItemGroup>
  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '14.0' ">
    <VisualStudioVersion>14.0</VisualStudioVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
  <!-- 选错配置时给出可操作的报错，而不是 CS0234「命名空间 SshTool.Native 不存在」：
       winmd 由 VS2017(v141) 两段式预先构建，仓库里已预建 x64 Debug / ARM Release / ARM Debug（见 doc/ENV.md §5）。 -->
  <Target Name="RequireNativeWinmd" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\SshTool.Native\bin\$(NativePlatform)\$(Configuration)\SshTool.Native.winmd')"
           Text="缺少 SshTool.Native.winmd（$(NativePlatform)\$(Configuration)）。Native 只能由 VS2017(v141) 构建，请先执行： &amp; 'C:\Program Files (x86)\Microsoft Visual Studio\2017\Community\MSBuild\15.0\Bin\MSBuild.exe' src\SshTool.Native\SshTool.Native.vcxproj -p:Configuration=$(Configuration) -p:Platform=$(NativePlatform) ；或切到已预建的 x64 Debug（日常开发）/ ARM Debug（真机调试）/ ARM Release（真机打包）。" />
  </Target>
</Project>
