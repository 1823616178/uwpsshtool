  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
  <!-- 选错配置时给出可操作的报错，而不是 CS0234「命名空间 SshTool.Native 不存在」：
       winmd 由 VS2017(v141) 两段式预先构建，仓库里已预建 x64 Debug / ARM Release / ARM Debug（见 doc/ENV.md §5）。 -->
  <Target Name="RequireNativeWinmd" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\SshTool.Native\bin\$(NativePlatform)\$(Configuration)\SshTool.Native.winmd')"
           Text="缺少 SshTool.Native.winmd（$(NativePlatform)\$(Configuration)）。Native 只能由 VS2017(v141) 构建，请先执行： &amp; 'C:\Program Files (x86)\Microsoft Visual Studio\2017\Community\MSBuild\15.0\Bin\MSBuild.exe' src\SshTool.Native\SshTool.Native.vcxproj -p:Configuration=$(Configuration) -p:Platform=$(NativePlatform) ；或切到已预建的 x64 Debug（日常开发）/ ARM Debug（真机调试）/ ARM Release（真机打包）。" />
  </Target>
