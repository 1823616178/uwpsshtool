<ContentDialog
    x:Class="SshTool.App.Dialogs.ThemeSchemePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择要导入的配色"
    PrimaryButtonText="导入所选"
    SecondaryButtonText="取消"
    MaxWidth="{StaticResource DialogMaxWidth}">

    <!-- A04：settings.json 含多个 scheme 时让用户勾选（默认已选第一个） -->
    <StackPanel>
        <TextBlock x:Name="SummaryText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
        <ListView x:Name="SchemeList" SelectionMode="Multiple" Margin="{StaticResource GapSmTop}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
