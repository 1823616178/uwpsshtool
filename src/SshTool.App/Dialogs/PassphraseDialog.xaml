<ContentDialog
    x:Class="SshTool.App.Dialogs.PassphraseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MaxWidth="{StaticResource DialogMaxWidth}"
    Title="私钥短语"
    PrimaryButtonText="解锁"
    SecondaryButtonText="取消">

    <!-- 02-UI-DESIGN.md §5.8 PassphraseDialog：短语 + 保存开关 -->
    <StackPanel>
        <TextBlock x:Name="PromptText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
        <PasswordBox x:Name="PassphraseBox" Margin="{StaticResource GapXsTop}" />
        <ToggleSwitch x:Name="RememberSwitch" Header="保存在本机" Margin="{StaticResource GapSmTop}" />
    </StackPanel>
</ContentDialog>
