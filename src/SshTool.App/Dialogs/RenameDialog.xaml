<ContentDialog
    x:Class="SshTool.App.Dialogs.RenameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MaxWidth="{StaticResource DialogMaxWidth}">

    <!-- F03：重命名 / 新建文件夹共用输入框（Title 由 .cs 走 Sftp_RenameTitle/Sftp_MkdirTitle 设定）；
         取消/确定复用 Dialog_Cancel/Dialog_Ok（.cs 设定），此处不硬编码中文；
         名称校验：非空、不含 “/”、不为 “.” 或 “..”。 -->
    <StackPanel>
        <TextBox x:Uid="RenameDialog_NameBox" x:Name="NameBox" TextChanged="OnNameChanged" />
        <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionTextStyle}"
                   Foreground="{ThemeResource AppDangerBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="{StaticResource GapXsTop}" />
    </StackPanel>
</ContentDialog>
