<ContentDialog
    x:Class="SshTool.App.Dialogs.CredentialDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MaxWidth="{StaticResource DialogMaxWidth}"
    Title="身份验证"
    PrimaryButtonText="连接"
    SecondaryButtonText="取消">

    <!-- 02-UI-DESIGN.md §5.8 CredentialDialog：密码 + 保存勾选 + 失败红字 -->
    <StackPanel>
        <TextBlock x:Name="PromptText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
        <PasswordBox x:Name="PasswordBox" Margin="{StaticResource GapXsTop}" />
        <CheckBox x:Name="RememberBox" Content="保存在本机" Margin="{StaticResource GapSmTop}" />
        <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionTextStyle}"
                   Foreground="{ThemeResource AppDangerBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="{StaticResource GapSmTop}" />
    </StackPanel>
</ContentDialog>
