<ContentDialog x:Uid="KeyGenerateDialog_ContentDialog1"
    x:Class="SshTool.App.Dialogs.KeyGenerateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    MaxWidth="{StaticResource DialogMaxWidth}"


>

    <!-- K02 密钥生成（02-UI-DESIGN.md §5.10）：类型（ED25519 推荐 / RSA）→
         名称 → 注释 → 生成中进度。生成的私钥未加密，无短语项。 -->
    <Grid>
        <StackPanel>
            <ComboBox x:Uid="KeyGenerateDialog_TypeBox" x:Name="TypeBox" HorizontalAlignment="Stretch"
                      SelectionChanged="OnTypeChanged">
                <ComboBoxItem x:Uid="KeyGen_TypeEd25519" IsSelected="True" />
                <ComboBoxItem x:Uid="KeyGen_TypeRsa3072" />
                <ComboBoxItem x:Uid="KeyGen_TypeRsa4096" />
            </ComboBox>
            <TextBox x:Uid="KeyGenerateDialog_NameBox" x:Name="NameBox" Margin="{StaticResource GapSmTop}" />
            <TextBox x:Uid="KeyGenerateDialog_CommentBox" x:Name="CommentBox" Margin="{StaticResource GapSmTop}" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionTextStyle}"
                       Foreground="{ThemeResource AppDangerBrush}" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="{StaticResource GapXsTop}" />
        </StackPanel>
        <controls:LoadingOverlay x:Name="Progress" x:Uid="KeyGen_Progress" IsActive="False" />
    </Grid>
</ContentDialog>
