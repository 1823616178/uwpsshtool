<ContentDialog
    x:Class="SshTool.App.Dialogs.PasteConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    MaxWidth="{StaticResource DialogMaxWidth}">

    <StackPanel>
        <TextBlock x:Name="SummaryText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
        <controls:MonoText x:Name="PreviewText" Margin="{StaticResource GapSmTop}" />
        <CheckBox x:Uid="PasteConfirmDialog_DontAskBox" x:Name="DontAskBox" Margin="{StaticResource GapSmTop}" />
    </StackPanel>
</ContentDialog>
