<ContentDialog
    x:Class="SshTool.App.Dialogs.AgentUnlockDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MaxWidth="{StaticResource DialogMaxWidth}"
    Title="选择解锁密钥"
    PrimaryButtonText="解锁"
    SecondaryButtonText="取消">

    <!-- K03 AgentUnlockDialog：agent 无可用密钥时提示选择密钥解锁。
         已解锁条目标「已解锁」（可直接试），其余标密钥类型与指纹尾 8 位。
         私钥材料绝不进本页，只回传所选 KeyId。 -->
    <StackPanel>
        <TextBlock x:Name="PromptText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
        <ListView x:Name="KeyList" SelectionMode="Single"
                  Margin="{StaticResource GapXsTop}"
                  SelectionChanged="OnSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="{StaticResource GapXsTop}">
                        <TextBlock Text="{Binding DisplayName}"
                                   Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="{Binding DisplayDetail}"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
