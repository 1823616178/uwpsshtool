<ContentDialog x:Uid="KbdInteractiveDialog_ContentDialog1"
    x:Class="SshTool.App.Dialogs.KbdInteractiveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MaxWidth="{StaticResource DialogMaxWidth}"


>

    <!-- 02-UI-DESIGN.md §5.8 KbdInteractiveDialog：Name/Instruction + 每个 prompt 一个输入框
         （输入框按 prompt 动态生成，见 .cs；echo=false 用 PasswordBox） -->
    <StackPanel>
        <TextBlock x:Name="NameText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
        <TextBlock x:Name="InstructionText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                   Margin="{StaticResource GapXsTop}" />
        <StackPanel x:Name="PromptsPanel" />
    </StackPanel>
</ContentDialog>
