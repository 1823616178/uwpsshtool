<ContentDialog x:Uid="HostKeyMismatchDialog_ContentDialog4"
    x:Class="SshTool.App.Dialogs.HostKeyMismatchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SshTool.App.Controls"
    MaxWidth="{StaticResource DialogMaxWidth}">

    <!-- 02-UI-DESIGN.md §5.8 HostKeyMismatchDialog：红色警告 + 指纹对比 + 输入主机名确认移除 -->
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <FontIcon Glyph="{StaticResource IconWarning}" FontSize="{StaticResource FontSubtitle}"
                      Foreground="{ThemeResource AppDangerBrush}" VerticalAlignment="Top" />
            <TextBlock x:Uid="HostKeyMismatchDialog_TextBlock3" Style="{StaticResource BodyTextStyle}"
                       Foreground="{ThemeResource AppDangerBrush}" TextWrapping="Wrap"
                       Margin="{StaticResource GapSmLeft}" />
        </StackPanel>
        <TextBlock x:Uid="HostKeyMismatchDialog_TextBlock2" Style="{StaticResource CaptionTextStyle}" Margin="{StaticResource GapMdTop}" />
        <controls:MonoText x:Name="OldFingerprintText" Margin="{StaticResource GapXsTop}" />
        <TextBlock x:Uid="HostKeyMismatchDialog_TextBlock1" Style="{StaticResource CaptionTextStyle}" Margin="{StaticResource GapMdTop}" />
        <controls:MonoText x:Name="NewFingerprintText" Margin="{StaticResource GapXsTop}" />
        <TextBlock x:Name="ConfirmHintText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                   Margin="{StaticResource GapMdTop}" />
        <TextBox x:Name="ConfirmBox" x:Uid="HostKeyMismatch_ConfirmBox" Margin="{StaticResource GapXsTop}" />
        <TextBlock x:Name="ConfirmErrorText" Style="{StaticResource CaptionTextStyle}"
                   Foreground="{ThemeResource AppDangerBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="{StaticResource GapXsTop}" />
    </StackPanel>
</ContentDialog>
